@code {
    // Cache-busting stamp for our own static assets.
    //
    // Kiosk browsers and PWAs hold on to CSS aggressively: after a deploy they
    // kept serving stale stylesheets, which re-applied styles that had already
    // been deleted (old blue buttons and focus rings reappearing on top of the
    // new theme). Tying the query string to the build makes every deploy fetch
    // fresh files, while still allowing normal caching between deploys.
    private static readonly string AssetVersion = ResolveAssetVersion();

    private static string ResolveAssetVersion()
    {
        try
        {
            var location = typeof(App).Assembly.Location;
            if (!string.IsNullOrEmpty(location) && File.Exists(location))
            {
                return File.GetLastWriteTimeUtc(location).Ticks.ToString("x");
            }
        }
        catch
        {
            // Fall through to a per-process stamp.
        }

        return Guid.NewGuid().ToString("N")[..8];
    }
}
