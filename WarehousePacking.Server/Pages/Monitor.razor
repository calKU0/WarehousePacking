@page "/monitor"
@using WarehousePacking.Contracts.DTOs
@using WarehousePacking.Server.Services
@using WarehousePacking.Server.Shared.Base
@using WarehousePacking.Server.Shared.Components.Monitor
@using WarehousePacking.Contracts.Data.Enums
@inject PackingService PackingService
@inject WorkstationService WorkstationService
@inject UserSessionService UserSession
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<div class="monitor-page" @ref="_monitorRoot">
    <div class="d-flex justify-content-between align-items-end mb-3 gap-2">
        <div>
            <MonitorPanelTabs Panels="PanelOrder" ActivePanel="ActivePanel" OnPanelSelected="SelectPanelAsync" />
        </div>

        <div class="d-flex flex-column align-items-end gap-2">
            <div class="d-flex gap-2 align-items-center">
                <span class="text-muted small me-2">Dane z: @(CurrentPanelDataTime?.ToString("HH:mm:ss") ?? "-")</span>

                <button class="btn btn-outline-primary" @onclick="HandleManualRefreshAsync" disabled="@IsCurrentPanelLoading">
                    @if (IsCurrentPanelLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    }
                    Odśwież panel
                </button>

                <button type="button" class="btn btn-outline-secondary" @onclick="MoveToPreviousPanelAsync" title="Poprzedni panel">
                    <span aria-hidden="true">←</span>
                </button>

                <button type="button" class="btn btn-outline-secondary" @onclick="ToggleSlider">
                    @(IsSliderRunning ? "Zatrzymaj" : "Wznów")
                </button>

                <button type="button" class="btn btn-outline-secondary" @onclick="MoveToNextPanelAsync" title="Następny panel">
                    <span aria-hidden="true">→</span>
                </button>
            </div>

            <div class="text-muted small">
                @if (IsSliderRunning)
                {
                    <span>Odświeżanie co @RefreshIntervalSeconds s, zmiana panelu co @SlideIntervalSeconds s.</span>
                }
                else
                {
                    <span>Slider zatrzymany. Aktywny panel odświeża się co @RefreshIntervalSeconds s.</span>
                }
            </div>
        </div>
    </div>

    <div class="monitor-slider monitor-slider-fill">
        <div class="monitor-track" style="@GetTrackStyle()">
            @foreach (var panel in PanelOrder)
            {
                <section class="monitor-slide">
                    @switch (panel)
                    {
                        case MonitorPanel.Picking:
                            <MonitorPickingPanel />
                            break;
                        case MonitorPanel.Sorting:
                            <MonitorSortingPanel />
                            break;
                        case MonitorPanel.Packing:
                            <MonitorPackingPanel Queue="PackingQueue"
                                                InProgress="PackingInProgress"
                                                ElementsByJl="PackingElementsByJl"
                                                IsLoading="IsPackingLoading" />
                            break;
                        case MonitorPanel.Receiving:
                            <MonitorReceivingPanel />
                            break;
                        case MonitorPanel.Stocking:
                            <MonitorStockingPanel />
                            break;
                    }
                </section>
            }
        </div>
    </div>
</div>

@code {
    private const int DefaultRefreshIntervalSeconds = WorkstationSettings.DefaultMonitorRefreshIntervalSeconds;
    private const int DefaultSlideIntervalSeconds = WorkstationSettings.DefaultMonitorSlideIntervalSeconds;

    private readonly MonitorPanel[] PanelOrder = Enum.GetValues<MonitorPanel>().OrderBy(x => (int)x).ToArray();
    private readonly SemaphoreSlim _refreshGate = new(1, 1);

    private Timer? _refreshTimer;
    private Timer? _slideTimer;
    private DotNetObjectReference<Monitor>? _keyboardRef;
    private string? _keyboardListenerId;
    private string? _autoScrollId;
    private ElementReference _monitorRoot;

    private int RefreshIntervalSeconds = DefaultRefreshIntervalSeconds;
    private int SlideIntervalSeconds = DefaultSlideIntervalSeconds;
    private MonitorPanel ActivePanel = MonitorPanel.Packing;
    private bool IsSliderRunning = true;

    private bool IsPackingLoading;
    private bool _isDisposed;
    private DateTime? PackingLastRefresh;
    private List<JlData> PackingQueue = new();
    private List<JlInProgressDto> PackingInProgress = new();
    private Dictionary<string, decimal> PackingElementsByJl = new(StringComparer.OrdinalIgnoreCase);

    private bool IsCurrentPanelLoading => ActivePanel == MonitorPanel.Packing && IsPackingLoading;
    private int ActivePanelIndex => Array.IndexOf(PanelOrder, ActivePanel);
    private DateTime? CurrentPanelDataTime => ActivePanel switch
    {
        MonitorPanel.Packing => PackingLastRefresh,
        _ => null
    };

    protected override async Task OnInitializedAsync()
    {
        var settings = await WorkstationService.GetSettingsAsync();
        if (settings is null || string.IsNullOrWhiteSpace(settings.StationNumber))
        {
            Navigation.NavigateTo("/settings", true);
            return;
        }

        RefreshIntervalSeconds = settings.MonitorRefreshIntervalSeconds > 0
            ? settings.MonitorRefreshIntervalSeconds
            : DefaultRefreshIntervalSeconds;

        SlideIntervalSeconds = settings.MonitorSlideIntervalSeconds > 0
            ? settings.MonitorSlideIntervalSeconds
            : DefaultSlideIntervalSeconds;

        if (settings.StationType != StationType.Monitoring)
        {
            await UserSession.InitializeAsync();
            if (string.IsNullOrWhiteSpace(UserSession.Username))
            {
                Navigation.NavigateTo("/login", true);
                return;
            }
        }

        await RefreshCurrentPanelAsync(true, false);
        _refreshTimer = new Timer(_ => _ = InvokeAsync(OnRefreshTickAsync), null, TimeSpan.FromSeconds(RefreshIntervalSeconds), TimeSpan.FromSeconds(RefreshIntervalSeconds));
        _slideTimer = new Timer(_ => _ = InvokeAsync(OnSliderTickAsync), null, TimeSpan.FromSeconds(SlideIntervalSeconds), TimeSpan.FromSeconds(SlideIntervalSeconds));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _keyboardRef = DotNetObjectReference.Create(this);
        await JSRuntime.InvokeVoidAsync("monitorLayout.enter");
        _keyboardListenerId = await JSRuntime.InvokeAsync<string>("monitorNavigation.register", _keyboardRef);
        _autoScrollId = await JSRuntime.InvokeAsync<string>("monitorAutoScroll.register", _monitorRoot, ".monitor-auto-scroll");
    }

    [JSInvokable]
    public async Task HandleArrowKey(string key)
    {
        if (string.Equals(key, "ArrowLeft", StringComparison.Ordinal))
        {
            await MoveToPreviousPanelAsync();
            return;
        }

        if (string.Equals(key, "ArrowRight", StringComparison.Ordinal))
        {
            await MoveToNextPanelAsync();
        }
    }

    private async Task OnSliderTickAsync()
    {
        if (_isDisposed)
        {
            return;
        }

        if (!IsSliderRunning)
        {
            return;
        }

        await MoveToPanelByOffsetAsync(1, false, true);
    }

    private async Task OnRefreshTickAsync()
    {
        if (_isDisposed)
        {
            return;
        }

        await RefreshCurrentPanelAsync(true, false);
    }

    private async Task MoveToPreviousPanelAsync()
    {
        await MoveToPanelByOffsetAsync(-1, true, true);
    }

    private async Task MoveToNextPanelAsync()
    {
        await MoveToPanelByOffsetAsync(1, true, true);
    }

    private async Task MoveToPanelByOffsetAsync(int offset, bool resetSlideTimer, bool resetRefreshTimer)
    {
        var nextIndex = (ActivePanelIndex + offset + PanelOrder.Length) % PanelOrder.Length;
        ActivePanel = PanelOrder[nextIndex];
        await InvokeAsync(StateHasChanged);

        if (resetSlideTimer)
        {
            RestartSliderTimer();
        }

        await RefreshCurrentPanelAsync(true, resetRefreshTimer);
    }

    private async Task SelectPanelAsync(MonitorPanel panel)
    {
        if (ActivePanel == panel)
        {
            await RefreshCurrentPanelAsync(true, true);
            return;
        }

        ActivePanel = panel;
        await InvokeAsync(StateHasChanged);
        RestartSliderTimer();
        await RefreshCurrentPanelAsync(true, true);
    }

    private void ToggleSlider()
    {
        IsSliderRunning = !IsSliderRunning;
        RestartSliderTimer();
    }

    private Task HandleManualRefreshAsync()
    {
        return RefreshCurrentPanelAsync(true, true);
    }

    private async Task RefreshCurrentPanelAsync(bool force, bool restartRefreshTimer)
    {
        if (_isDisposed)
        {
            return;
        }

        if (restartRefreshTimer)
        {
            RestartRefreshTimer();
        }

        bool gateTaken = false;
        try
        {
            gateTaken = await _refreshGate.WaitAsync(0);
        }
        catch (ObjectDisposedException)
        {
            return;
        }

        if (!gateTaken)
        {
            return;
        }

        try
        {
            if (_isDisposed)
            {
                return;
            }

            if (ActivePanel == MonitorPanel.Packing)
            {
                await LoadPackingDataAsync(force);
            }
        }
        finally
        {
            if (gateTaken && !_isDisposed)
            {
                try
                {
                    _refreshGate.Release();
                }
                catch (ObjectDisposedException)
                {
                }
            }
        }
    }

    private async Task LoadPackingDataAsync(bool force)
    {
        if (_isDisposed)
        {
            return;
        }

        if (!force && PackingQueue.Any() && PackingInProgress.Any())
        {
            return;
        }

        IsPackingLoading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var settings = await WorkstationService.GetSettingsAsync();
            var queueTask = PackingService.GetJlList();
            var inProgressTask = PackingService.GetJlListInProgress();

            await Task.WhenAll(queueTask, inProgressTask);

            PackingQueue = queueTask.Result ?? new List<JlData>();
            PackingInProgress = inProgressTask.Result ?? new List<JlInProgressDto>();
            PackingElementsByJl = await LoadPackingElementsByJlAsync(PackingQueue);
            PackingLastRefresh = DateTime.Now;
        }
        finally
        {
            IsPackingLoading = false;
            if (!_isDisposed)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private string GetTrackStyle()
    {
        return $"transform: translateX(-{ActivePanelIndex * 20}%);";
    }

    private async Task<Dictionary<string, decimal>> LoadPackingElementsByJlAsync(IEnumerable<JlData> queue)
    {
        var jlCodes = queue
            .Select(x => x.Name)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        var tasks = jlCodes.Select(async jlCode =>
        {
            try
            {
                var items = await PackingService.GetJlItems(jlCode);
                var quantity = items?.Sum(x => x.JlQuantity) ?? 0m;
                return (jlCode: jlCode, quantity: quantity);
            }
            catch
            {
                return (jlCode: jlCode, quantity: 0m);
            }
        });

        var results = await Task.WhenAll(tasks);
        return results.ToDictionary(x => x.jlCode, x => x.quantity, StringComparer.OrdinalIgnoreCase);
    }

    private void RestartSliderTimer()
    {
        _slideTimer?.Change(TimeSpan.FromSeconds(SlideIntervalSeconds), TimeSpan.FromSeconds(SlideIntervalSeconds));
    }

    private void RestartRefreshTimer()
    {
        _refreshTimer?.Change(TimeSpan.FromSeconds(RefreshIntervalSeconds), TimeSpan.FromSeconds(RefreshIntervalSeconds));
    }

    public async ValueTask DisposeAsync()
    {
        _isDisposed = true;
        _refreshTimer?.Dispose();
        _slideTimer?.Dispose();

        if (!string.IsNullOrWhiteSpace(_keyboardListenerId))
        {
            await JSRuntime.InvokeVoidAsync("monitorNavigation.unregister", _keyboardListenerId);
        }

        if (!string.IsNullOrWhiteSpace(_autoScrollId))
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("monitorAutoScroll.unregister", _autoScrollId);
            }
            catch
            {
            }
        }

        try
        {
            await JSRuntime.InvokeVoidAsync("monitorLayout.exit");
        }
        catch
        {
        }

        _keyboardRef?.Dispose();
    }
}
