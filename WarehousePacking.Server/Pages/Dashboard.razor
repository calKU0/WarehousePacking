@page "/dashboard"
@using WarehousePacking.Contracts.DTOs
@using WarehousePacking.Contracts.DTOs.Dashboards
@using WarehousePacking.Contracts.DTOs.Requests
@using WarehousePacking.Server.Helpers
@using WarehousePacking.Server.Services
@using WarehousePacking.Server.Settings
@using WarehousePacking.Server.Shared.Components.Dashboards
@using WarehousePacking.Contracts.Data.Enums
@inject PackingService PackingService
@inject DashboardService DashboardService
@inject WorkstationService WorkstationService
@inject UserSessionService UserSession
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject ILogger<Dashboard> Logger
@implements IAsyncDisposable

<div class="dashboard-page" @ref="_dashboardRoot">
    <div class="row align-items-end mb-3 g-2 w-100 mx-0">

        <div class="col-4 d-flex justify-content-start">
            <DashboardPanelTabs Panels="PanelOrder" ActivePanel="ActivePanel" OnPanelSelected="SelectPanelAsync" />
        </div>

        <div class="col-4 text-center">
            <h1 class="mb-0 text-primary fw-semibold text-truncate">
                @(ActivePanel.GetDescription())
            </h1>
        </div>

        <div class="col-4 d-flex flex-column align-items-end gap-2">
            <div class="d-flex gap-2 align-items-center">
                <span class="text-muted small me-2">Dane z: @(CurrentPanelDataTime?.ToString("HH:mm:ss") ?? "-")</span>

                <button class="btn btn-outline-primary dashboard-refresh-btn" @onclick="HandleManualRefreshAsync" disabled="@IsCurrentPanelLoading">
                    @if (IsCurrentPanelLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                    }
                    else
                    {
                        <span class="spinner-placeholder"></span>
                    }
                    Odśwież panel
                </button>

                <button type="button" class="btn btn-outline-secondary" @onclick="MoveToPreviousPanelAsync" title="Poprzedni panel">
                    <span aria-hidden="true">←</span>
                </button>

                <button type="button" class="btn btn-outline-secondary" @onclick="ToggleSlider">
                    @(IsSliderRunning ? "Zatrzymaj" : "Wznów")
                </button>

                <button type="button" class="btn btn-outline-secondary" @onclick="MoveToNextPanelAsync" title="Następny panel">
                    <span aria-hidden="true">→</span>
                </button>
            </div>

            <div class="text-muted small d-flex gap-3">
                @if (IsSliderRunning)
                {
                    <div class="d-flex align-items-center">
                        <span class="me-1">Nowy slajd za:</span>
                        <DashboardAnimatedValue Text="@($"{_slideCountdown}s")" CssClass="fw-bold text-primary" />
                    </div>
                }
                else
                {
                    <span class="text-danger fw-bold">Slider zatrzymany</span>
                }

                <div class="d-flex align-items-center border-start ps-3">
                    <span class="me-1">Odświeżenie za:</span>
                    <DashboardAnimatedValue Text="@($"{_refreshCountdown}s")" CssClass="fw-bold text-info" />
                </div>
            </div>
        </div>
    </div>

    <div class="dashboard-slider dashboard-slider-fill">
        <div class="dashboard-track" style="@GetTrackStyle()">
            @foreach (var panel in PanelOrder)
            {
                <section class="dashboard-slide">
                    @* Safety net for an unattended 24/7 wallboard: a render fault
                       in one panel must not tear down the whole circuit and leave
                       a dead screen until someone notices in the morning. The
                       boundary is recovered on the next refresh tick. *@
                    <ErrorBoundary @ref="_panelBoundaries[panel]">
                        <ChildContent>
                    @switch (panel)
                    {
                        case DashboardPanel.Picking:
                            <DashboardPickingPanel Tasks="Tasks"
                                                Documents="TaskDocuments"
                                                RecentOperations="TaskRecentOperations"
                                                ColorConfig="ColorConfig"
                                                IsLoading="IsPickingLoading" />
                            break;
                        case DashboardPanel.Sorting:
                            <DashboardSortingPanel LusToSort="LusToSort"
                                                RecentOperations="SortingRecentOperations"
                                                ColorConfig="ColorConfig"
                                                IsLoading="IsSortingLoading" />
                            break;
                        case DashboardPanel.Packing:
                            <DashboardPackingPanel Queue="PackingQueue"
                                                InProgress="PackingInProgress"
                                                ColorConfig="ColorConfig"
                                                IsLoading="IsPackingLoading" />
                            break;
                        case DashboardPanel.Loading:
                            <DashboardLoadingPanel LusToLoad="LusToLoad"
                                                RecentOperations="LoadingRecentOperations"
                                                ColorConfig="ColorConfig"
                                                IsLoading="IsLoadingLoading"/>
                            break;
                        case DashboardPanel.Receiving:
                            <DashboardReceivingPanel Documents="ReceivingDocuments"
                                                RecentOperations="ReceivingRecentOperations"
                                                ColorConfig="ColorConfig"
                                                IsLoading="IsReceivingLoading" />
                            break;
                        case DashboardPanel.Stocking:
                            <DashboardStockingPanel />
                            break;
                    }
                        </ChildContent>
                        <ErrorContent>
                            <div class="app-empty h-100">
                                <i class="bi bi-exclamation-triangle app-empty__icon"></i>
                                <p class="app-empty__title">Chwilowy problem z danymi panelu</p>
                                <p class="app-empty__text">Panel odbuduje się przy następnym odświeżeniu.</p>
                            </div>
                        </ErrorContent>
                    </ErrorBoundary>
                </section>
            }
        </div>
    </div>
</div>

@code {
    /// <summary>
    /// One error boundary per panel, so a fault is contained to its own slide.
    /// Recovered on every refresh tick — a transient data glitch must not leave
    /// the wallboard dead until morning.
    /// </summary>
    private readonly Dictionary<DashboardPanel, ErrorBoundary?> _panelBoundaries = new();

    private DashboardSettings _settings = new();
    private DashboardColorConfiguration ColorConfig = new();
    private DashboardPanel[] PanelOrder = Array.Empty<DashboardPanel>();
    private PanelConfiguration CurrentConfig => _settings.Panels.FirstOrDefault(p => p.Panel == ActivePanel) ?? new PanelConfiguration();
    private readonly SemaphoreSlim _refreshGate = new(1, 1);

    private int _refreshCountdown; 
    private int _slideCountdown;

    private int RefreshIntervalSeconds => CurrentConfig.RefreshIntervalSeconds;
    private int SlideIntervalSeconds => CurrentConfig.SlideIntervalSeconds;
    private DotNetObjectReference<Dashboard>? _keyboardRef;
    private string? _keyboardListenerId;
    private string? _autoScrollId;
    private ElementReference _dashboardRoot;

    private DashboardPanel ActivePanel = DashboardPanel.Sorting;
    private bool IsSliderRunning = true;

    private bool IsPickingLoading;
    private bool IsPackingLoading;
    private bool IsLoadingLoading;
    private bool IsSortingLoading;
    private bool IsReceivingLoading;
    private bool _isDisposed;
    private DateTime? LastRefresh;

    private List<WarehouseTask> Tasks = new();
    private List<WarehouseDocument> TaskDocuments = new();
    private List<WarehouseOperation> TaskRecentOperations = new();

    private List<JlData> PackingQueue = new();
    private List<JlInProgressDto> PackingInProgress = new();

    private List<WarehouseLu> LusToLoad = new();
    private List<WarehouseOperation> LoadingRecentOperations = new();

    private List<WarehouseLu> LusToSort = new();
    private List<WarehouseOperation> SortingRecentOperations = new();

    private List<WarehouseDocument> ReceivingDocuments = new();
    private List<WarehouseOperation> ReceivingRecentOperations = new();


    private bool IsCurrentPanelLoading => ActivePanel switch
    {
        DashboardPanel.Picking => IsPickingLoading,
        DashboardPanel.Sorting => IsSortingLoading,
        DashboardPanel.Packing => IsPackingLoading,
        DashboardPanel.Loading => IsLoadingLoading,
        DashboardPanel.Receiving => IsReceivingLoading,
        _ => false
    };
    private int ActivePanelIndex => Array.IndexOf(PanelOrder, ActivePanel);
    private DateTime? CurrentPanelDataTime => ActivePanel switch
    {
        _ => LastRefresh
    };

    protected override async Task OnInitializedAsync()
    {
        var workstationSettings = await WorkstationService.GetSettingsAsync();
        if (workstationSettings?.DashboardSettings == null || string.IsNullOrWhiteSpace(workstationSettings.StationNumber))
        {
            Navigation.NavigateTo("/settings", true);
            return;
        }

        // Colour config is presentation-only. If the API is unavailable (nightly
        // maintenance is the usual cause) the dashboard must still come up with
        // defaults rather than failing initialisation and killing the circuit.
        try
        {
            ColorConfig = await DashboardService.GetColorConfiguration();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load dashboard colour configuration; using defaults.");
        }

        _settings = workstationSettings.DashboardSettings;

        PanelOrder = _settings.Panels
            .Where(p => p.IsEnabled)
            .OrderBy(p => (int)p.Panel)
            .Select(p => p.Panel)
            .ToArray();

        if (!PanelOrder.Any())
        {
            PanelOrder = new[] { DashboardPanel.Picking };
        }

        ActivePanel = PanelOrder[0];

        await RefreshCurrentPanelAsync(true, false);

        _refreshCountdown = CurrentConfig.RefreshIntervalSeconds;
        _slideCountdown = CurrentConfig.SlideIntervalSeconds;

        DashboardClock.EnsureStarted();
        DashboardClock.Tick += HandleClockTick;

        await RefreshCurrentPanelAsync(true, false);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _keyboardRef = DotNetObjectReference.Create(this);
        await JSRuntime.InvokeVoidAsync("dashboardLayout.enter");
        _keyboardListenerId = await JSRuntime.InvokeAsync<string>("dashboardNavigation.register", _keyboardRef);
        _autoScrollId = await JSRuntime.InvokeAsync<string>("dashboardAutoScroll.register", _dashboardRoot, ".dashboard-auto-scroll");
    }

    [JSInvokable]
    public async Task HandleArrowKey(string key)
    {
        if (string.Equals(key, "ArrowLeft", StringComparison.Ordinal))
        {
            await MoveToPreviousPanelAsync();
            return;
        }

        if (string.Equals(key, "ArrowRight", StringComparison.Ordinal))
        {
            await MoveToNextPanelAsync();
        }
    }

    private void HandleClockTick()
    {
        // Fire-and-forget from a timer: anything escaping here would surface as
        // an unhandled error and kill the circuit, leaving the wallboard dead
        // until someone reloads it. The dashboard is read-only, so a failed
        // tick is logged and the previous data simply stays on screen.
        _ = InvokeAsync(async () =>
        {
            try
            {
                await OnTickAsync();
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Dashboard tick failed; keeping the last known data on screen.");
            }
        });
    }

    private async Task OnTickAsync()
    {
        if (_isDisposed) return;

        _refreshCountdown--;
        if (_refreshCountdown <= 0)
        {
            await RefreshCurrentPanelAsync(true, true);
            _refreshCountdown = CurrentConfig.RefreshIntervalSeconds;
        }

        if (IsSliderRunning)
        {
            _slideCountdown--;
            if (_slideCountdown <= 0)
            {
                await MoveToPanelByOffsetAsync(1, true, true);
            }
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task MoveToPreviousPanelAsync()
    {
        await MoveToPanelByOffsetAsync(-1, true, true);
    }

    private async Task MoveToNextPanelAsync()
    {
        await MoveToPanelByOffsetAsync(1, true, true);
    }

    private async Task MoveToPanelByOffsetAsync(int offset, bool resetSlide, bool resetRefresh)
    {
        var nextIndex = (ActivePanelIndex + offset + PanelOrder.Length) % PanelOrder.Length;
        ActivePanel = PanelOrder[nextIndex];

        if (resetSlide) RestartSliderTimer();
        if (resetRefresh) RestartRefreshTimer();

        await InvokeAsync(StateHasChanged);
        await RefreshCurrentPanelAsync(true, false);
    }

    private async Task SelectPanelAsync(DashboardPanel panel)
    {
        if (ActivePanel == panel)
        {
            await RefreshCurrentPanelAsync(true, true);
            return;
        }

        ActivePanel = panel;
        await InvokeAsync(StateHasChanged);
        RestartSliderTimer();
        await RefreshCurrentPanelAsync(true, true);
    }

    private void ToggleSlider()
    {
        IsSliderRunning = !IsSliderRunning;
        RestartSliderTimer();
    }

    private async Task HandleManualRefreshAsync()
    {
        await RefreshCurrentPanelAsync(true, true);
    }

    private async Task RefreshCurrentPanelAsync(bool force, bool restartRefreshTimer)
    {
        if (_isDisposed)
        {
            return;
        }

        if (restartRefreshTimer)
        {
            RestartRefreshTimer();
        }

        bool gateTaken = false;
        try
        {
            gateTaken = await _refreshGate.WaitAsync(0);
        }
        catch (ObjectDisposedException)
        {
            return;
        }

        if (!gateTaken)
        {
            return;
        }

        try
        {
            if (_isDisposed)
            {
                return;
            }

            ColorConfig = await DashboardService.GetColorConfiguration() ?? ColorConfig;

            if (ActivePanel == DashboardPanel.Picking)
            {
                await LoadPickingDataAsync(force);
            }

            if (ActivePanel == DashboardPanel.Sorting)
            {
                await LoadSortingDataAsync(force);
            }

            if (ActivePanel == DashboardPanel.Packing)
            {
                await LoadPackingDataAsync(force);
            }

            if (ActivePanel == DashboardPanel.Loading)
            {
                await LoadLoadingDataAsync(force);
            }

            if (ActivePanel == DashboardPanel.Receiving)
            {
                await LoadReceivingDataAsync(force);
            }

            // Give a panel that previously faulted a chance to render again now
            // that fresh data has arrived.
            RecoverPanelBoundary(ActivePanel);
        }
        catch (Exception ex)
        {
            // The backing API/DB is periodically unavailable (nightly maintenance
            // windows are the common case). A read-only wallboard should ride
            // that out showing stale data and retry on the next tick, never take
            // the whole circuit down.
            Logger.LogWarning(ex, "Dashboard refresh failed for panel {Panel}; retrying on the next tick.", ActivePanel);
        }
        finally
        {
            if (gateTaken && !_isDisposed)
            {
                try
                {
                    _refreshGate.Release();
                }
                catch (ObjectDisposedException)
                {
                }
            }
        }
    }

    private async Task LoadPickingDataAsync(bool force)
    {
        if (_isDisposed)
        {
            return;
        }

        if (!force && Tasks.Any())
        {
            return;
        }

        IsPickingLoading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var tasks = DashboardService.GetWarehouseTasks(new GetWarehouseTasksRequest
            {
                Statuses =
                [
                    WarehouseTaskStatus.New,
                    WarehouseTaskStatus.InExecution,
                    WarehouseTaskStatus.Processing,
                    WarehouseTaskStatus.ReadyForExecution
                ]
            });

            var documentTasks = DashboardService.GetWarehouseDocuments(new GetWarehouseDocumentsRequest
            {
                Types = [WarehouseDocumentType.IssueOrder],
                Statuses =
                [
                    WarehouseTaskStatus.New,
                    WarehouseTaskStatus.InExecution,
                    WarehouseTaskStatus.Processing,
                    WarehouseTaskStatus.ReadyForExecution
                ]
            });

            var operationsTask = DashboardService.GetWarehouseOperations(new GetWarehouseOperationsRequest
            {
                Types = [WarehouseDocumentType.Task],
                Date = DateTime.UtcNow.AddMinutes(-5)
            });

            await Task.WhenAll(tasks, documentTasks, operationsTask);

            Tasks = tasks.Result ?? new List<WarehouseTask>();
            TaskDocuments = documentTasks.Result ?? new List<WarehouseDocument>();
            TaskRecentOperations = operationsTask.Result ?? new List<WarehouseOperation>();

            LastRefresh = DateTime.Now;
        }
        finally
        {
            IsPickingLoading = false;
            if (!_isDisposed)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task LoadPackingDataAsync(bool force)
    {
        if (_isDisposed)
        {
            return;
        }

        if (!force && PackingQueue.Any() && PackingInProgress.Any())
        {
            return;
        }

        IsPackingLoading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var settings = await WorkstationService.GetSettingsAsync();
            var queueTask = DashboardService.GetJlsToPack();
            var inProgressTask = PackingService.GetJlListInProgress();

            await Task.WhenAll(queueTask, inProgressTask);

            PackingQueue = queueTask.Result ?? new List<JlData>(); 
            PackingInProgress = inProgressTask.Result ?? new List<JlInProgressDto>();
            LastRefresh = DateTime.Now;
        }
        finally
        {
            IsPackingLoading = false;
            if (!_isDisposed)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task LoadLoadingDataAsync(bool force)
    {
        if (_isDisposed)
        {
            return;
        }

        if (!force && LusToLoad.Any())
        {
            return;
        }

        IsLoadingLoading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var lusTask = DashboardService.GetLus(new GetLusRequest
            {
                Status = LogisticUnitStatus.ReadyForLoading,
                PreviousOperationId = WarehouseDocumentType.Packing
            });

            var operationsTask = DashboardService.GetWarehouseOperations(new GetWarehouseOperationsRequest
            {
                Types = [WarehouseDocumentType.Loading],
                Date = DateTime.UtcNow.AddMinutes(-5)
            });

            await Task.WhenAll(lusTask, operationsTask);

            LusToLoad = lusTask.Result ?? new List<WarehouseLu>();
            LoadingRecentOperations = operationsTask.Result ?? new List<WarehouseOperation>();

            LastRefresh = DateTime.Now;
        }
        finally
        {
            IsLoadingLoading = false;
            if (!_isDisposed)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task LoadSortingDataAsync(bool force)
    {
        if (_isDisposed)
        {
            return;
        }

        if (!force && LusToSort.Any())
        {
            return;
        }

        IsSortingLoading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var jlsTask = DashboardService.GetLus(new GetLusRequest
            {
                Status = LogisticUnitStatus.ReadyForSorting,
                PreviousOperationId = WarehouseDocumentType.Task
            });

            var operationsTask = DashboardService.GetWarehouseOperations(new GetWarehouseOperationsRequest
            {
                Types = [WarehouseDocumentType.Sorting],
                Date = DateTime.UtcNow.AddMinutes(-5)
            });

            await Task.WhenAll(jlsTask, operationsTask);

            LusToSort = jlsTask.Result ?? new List<WarehouseLu>();
            SortingRecentOperations = operationsTask.Result ?? new List<WarehouseOperation>();

            LastRefresh = DateTime.Now;
        }
        finally
        {
            IsSortingLoading = false;
            if (!_isDisposed)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task LoadReceivingDataAsync(bool force)
    {
        if (_isDisposed)
        {
            return;
        }

        if (!force && ReceivingDocuments.Any())
        {
            return;
        }

        IsReceivingLoading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var documentsTask = DashboardService.GetWarehouseDocuments(new GetWarehouseDocumentsRequest
            {
                Types = [WarehouseDocumentType.Receipt],
                Statuses =
                [
                    WarehouseTaskStatus.New,
                    WarehouseTaskStatus.InExecution,
                    WarehouseTaskStatus.Processing,
                    WarehouseTaskStatus.ReadyForExecution
                ]
            });

            var operationsTask = DashboardService.GetWarehouseOperations(new GetWarehouseOperationsRequest
            {
                Types = [WarehouseDocumentType.Receipt],
                Date = DateTime.UtcNow.AddMinutes(-5)
            });

            await Task.WhenAll(documentsTask, operationsTask);

            ReceivingDocuments = documentsTask.Result ?? new List<WarehouseDocument>();
            ReceivingRecentOperations = operationsTask.Result ?? new List<WarehouseOperation>();
            var excludedErpTypes = new HashSet<int>
            {
                2033, 2045, 2041, 2042, 2013, 2009
            };

            ReceivingDocuments = ReceivingDocuments.Where(d => !excludedErpTypes.Contains(d.ErpType)).ToList();

            LastRefresh = DateTime.Now;
        }
        finally
        {
            IsReceivingLoading = false;
            if (!_isDisposed)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void RecoverPanelBoundary(DashboardPanel panel)
    {
        if (_panelBoundaries.TryGetValue(panel, out var boundary))
        {
            boundary?.Recover();
        }
    }

    private string GetTrackStyle()
    {
        int panelCount = PanelOrder.Length;
    
        int trackWidth = panelCount * 100;
    
        double step = 100.0 / panelCount;
    
        string translateValue = (ActivePanelIndex * step).ToString(System.Globalization.CultureInfo.InvariantCulture);

        return $"width: {trackWidth}%; transform: translateX(-{translateValue}%);";
    }

    private void RestartSliderTimer()
    {
        _slideCountdown = CurrentConfig.SlideIntervalSeconds;
    }

    private void RestartRefreshTimer()
    {
        _refreshCountdown = CurrentConfig.RefreshIntervalSeconds;
    }

    public async ValueTask DisposeAsync()
    {
        _isDisposed = true;
        DashboardClock.Tick -= HandleClockTick;

        if (!string.IsNullOrWhiteSpace(_keyboardListenerId))
        {
            await JSRuntime.InvokeVoidAsync("dashboardNavigation.unregister", _keyboardListenerId);
        }

        if (!string.IsNullOrWhiteSpace(_autoScrollId))
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("dashboardAutoScroll.unregister", _autoScrollId);
            }
            catch
            {
            }
        }

        try
        {
            await JSRuntime.InvokeVoidAsync("dashboardLayout.exit");
        }
        catch
        {
        }

        _keyboardRef?.Dispose();
    }
}
