@page "/kontrola-pakowania"
@using WarehousePacking.Contracts.DTOs
@using WarehousePacking.Contracts.DTOs.Requests
@using WarehousePacking.Server.Helpers
@using WarehousePacking.Server.Services
@using WarehousePacking.Server.Settings
@using WarehousePacking.Server.Shared
@using WarehousePacking.Contracts.Data.Enums
@using Microsoft.Extensions.Options
@inject PackingService PackingService
@inject WorkstationService WorkstationService
@inject IOptions<AppSettings> AppOptions
@inject NavigationManager Navigation
@inject UserSessionService UserSession
@inject AuthService AuthService
@inject IJSRuntime JSRuntime
@implements IDisposable

<div class="d-flex align-items-center mb-4">
    <div class="bg-primary text-white rounded p-2 me-3 shadow-sm">
        <i class="bi bi-box-seam fs-4"></i>
    </div>
    <h3 class="mb-0 fw-bold text-dark">Lista kuwet do spakowania</h3>
</div>

<div class="row g-4">
    <div class="col-md-9">
        <div class="card shadow-sm border-0 h-100 table-card">
            @if (IsLoading)
            {
                <div class="d-flex flex-column align-items-center justify-content-center h-100 p-5">
                    <div class="spinner-border text-primary mb-3" style="width: 3rem; height: 3rem;" role="status"></div>
                    <span class="text-muted fw-medium">Ładowanie danych...</span>
                </div>
            }
            else if (!JlList.Any())
            {
                <div class="d-flex flex-column align-items-center justify-content-center h-100 p-5 text-muted">
                    <i class="bi bi-inbox fs-1 mb-3 opacity-50"></i>
                    <h5 class="fw-medium">Brak kuwet do spakowania</h5>
                    <p class="small">Wszystkie zadania zostały ukończone.</p>
                </div>
            }
            else
            {
                <div class="table-responsive pro-table-wrapper">
                    <table class="table table-hover align-middle mb-0 pro-table">
                        <thead class="sticky-top bg-white shadow-sm">
                            <tr>
                                <th class="text-secondary fw-semibold">Lokalizacja</th>
                                <th class="text-secondary fw-semibold">Kuweta</th>
                                <th class="text-secondary fw-semibold">Kurier</th>
                                <th class="text-secondary fw-semibold">Waga</th>
                                <th class="text-secondary fw-semibold">Poza UE</th>
                                <th class="text-secondary fw-semibold">Klient</th>
                                <th class="text-secondary fw-semibold">Data dok.</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var (item, index) in JlList.Select((value, i) => (value, i)))
                            {
                                var rowClass = item.Status switch
                                {
                                    1 => "row-status-ready",
                                    2 => "row-status-error",
                                    3 => "row-status-warning",
                                    _ => ""
                                };

                                <tr class="clickable-row @rowClass" ondblclick="@(() => OnRowDoubleClick(item))">
                                    <td class="fw-medium">@item.Location</td>
                                    <td class="font-monospace fw-bold">@item.Code</td>
                                    <td class="logo-cell">
                                        @{
                                            var courierLogo = CourierHelper.GetCourierLogo(item.ShipmentServices, item.Courier);
                                        }

                                        @if (!string.IsNullOrWhiteSpace(courierLogo))
                                        {
                                            <div class="logo-wrapper">
                                                <img src="@courierLogo" alt="@item.Courier" class="courier-logo-img" />
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="fallback-icon">
                                                <i class="bi bi-truck text-secondary fs-5"></i>
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            @item.Weight.ToString("F2", System.Globalization.CultureInfo.InvariantCulture) kg
                                        </span>
                                    </td>
                                    <td>
                                        @if (item.OutsideEU)
                                        {
                                            <span class="badge rounded-pill bg-danger-subtle text-danger border border-danger-subtle">Tak</span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle">Nie</span>
                                        }
                                    </td>
                                    <td class="text-muted">@item.ClientSymbol</td>
                                    <td class="text-muted small">@item.DocumentDate.ToString("dd.MM.yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm border-0 p-4 sticky-sidebar">

            <div class="mb-4">
                <label for="kuwetaInput" class="form-label fw-bold text-dark small text-uppercase tracking-wide">Zeskanuj Kuwetę</label>
                <div class="input-group input-group-lg shadow-sm rounded scanner-input-group">
                    <span class="input-group-text bg-white border-end-0 text-primary">
                        <i class="bi bi-upc-scan"></i>
                    </span>
                    <input type="text"
                           @bind="Kuweta"
                           @bind:event="oninput"
                           @ref="InputRef"
                           @onkeydown="HandleKeyDown"
                           class="form-control border-start-0 ps-0"
                           placeholder="Kod kreskowy..." />
                </div>
            </div>

            <button class="btn btn-primary btn-lg w-100 shadow-sm mb-4 d-flex align-items-center justify-content-center gap-2"
                    @onclick="RefreshData"
                    disabled="@IsLoading">
                @if (IsLoading)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span>Odświeżanie...</span>
                }
                else
                {
                    <i class="bi bi-arrow-clockwise"></i>
                    <span>Odśwież Listę</span>
                }
            </button>

            <div class="stats-panel p-3 rounded mb-4">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small d-flex align-items-center gap-2">
                        <i class="bi bi-person-badge"></i> Operator
                    </span>
                    <span class="fw-bold text-dark">@UserSession.Username</span>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-muted small d-flex align-items-center gap-2">
                        <i class="bi bi-boxes"></i> Kuwety (Adresy)
                    </span>
                    <span class="badge bg-primary rounded-pill fs-6">@JlReadyToPackCount (@AddressesCount)</span>
                </div>
            </div>

            <ManagerControlModal OnButtonClick="HandleManagerClick"
                                 OnRequestPassword="OnManagerButtonClick"
                                 ShowPackingButtons="false"
                                 @ref="ManagerModal" />

            <hr class="text-muted opacity-25" />

            <div class="mb-4">
                <h6 class="fw-bold text-dark small text-uppercase tracking-wide mb-3">Podsumowanie kurierów</h6>
                <div class="d-flex flex-column gap-2 summary-container">
                    @foreach (var group in JlList.GroupBy(x => x.Courier).OrderByDescending(g => g.Count()))
                    {
                        var courierType = group.Key;
                        var count = group.Count();
                        var firstItem = group.FirstOrDefault();
                        var logoUrl = CourierHelper.GetCourierLogo(firstItem?.ShipmentServices, courierType);

                        <div class="summary-row d-flex align-items-center justify-content-between bg-white rounded shadow-sm border border-light">
                            <div class="d-flex align-items-center summary-logo-section">
                                @if (!string.IsNullOrWhiteSpace(logoUrl))
                                {
                                    <div class="summary-logo-wrapper me-3">
                                        <img src="@logoUrl" alt="@courierType" class="summary-logo-img" />
                                    </div>
                                }
                                else
                                {
                                    <div class="summary-icon-fallback me-3 text-primary bg-primary-subtle">
                                        <i class="bi bi-truck"></i>
                                    </div>
                                }
                                <span class="summary-courier-name fw-medium">@(courierType.GetDescription() ?? "Nieznany")</span>
                            </div>
                            <span class="badge bg-secondary rounded-pill">@count</span>
                        </div>
                    }
                </div>
            </div>

            <hr class="text-muted opacity-25" />

            <div>
                <h6 class="fw-bold text-dark small text-uppercase tracking-wide mb-3">Legenda statusów</h6>
                <div class="d-flex flex-column gap-2 legend-container">
                    <div class="d-flex align-items-center p-2 rounded status-legend-item status-ready">
                        <div class="legend-square bg-success-soft border-success"></div>
                        <span class="legend-text">Kuweta gotowa do pakowania</span>
                    </div>
                    <div class="d-flex align-items-center p-2 rounded status-legend-item status-error">
                        <div class="legend-square bg-danger-soft border-danger"></div>
                        <span class="legend-text">Zamówienie nieskompletowane</span>
                    </div>
                    <div class="d-flex align-items-center p-2 rounded status-legend-item status-warning">
                        <div class="legend-square bg-warning-soft border-warning"></div>
                        <span class="legend-text">Pakowana przez innego operatora</span>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<PasswordModal @ref="PasswordModal" />
<LoggedOperatorsModal @ref="LoggedOperatorsModal" />
<JlInProgressModal @ref="JlInProgressModal" />
<ChangePackingWarehouseModal @ref="ChangePackingWarehouseModal" />
<TextBoxModal @ref="TextBoxModal" />
<MergeJlsModal @ref="MergeJlsModal" />
<ComboBoxModal @ref="ComboBoxModal" />
<MergePackagesModal @ref="MergePackagesModal" />
<PackagesInBuforModal @ref="PackagesInBuforModal"/>
<CourierConfigurationModal @ref="CourierConfigurationModal" />

<Toast FocusAfterCloseInput="InputRef" @ref="Toast" />

@code  {
    private List<JlData> JlList = new();
    private string Kuweta { get; set; } = string.Empty;
    private System.Threading.Timer? RefreshListTimer;
    private System.Threading.Timer? AfkTimer;
    private ElementReference InputRef;
    private Toast Toast = new();
    private WorkstationSettings Settings = new();
    private AppSettings AppSettings => AppOptions.Value;

    private PasswordModal PasswordModal = new();
    private ManagerControlModal ManagerModal = new();
    private TextBoxModal TextBoxModal = new();
    private LoggedOperatorsModal LoggedOperatorsModal = new();
    private JlInProgressModal JlInProgressModal = new();
    private ChangePackingWarehouseModal ChangePackingWarehouseModal = new();
    private MergeJlsModal MergeJlsModal = new();
    private ComboBoxModal ComboBoxModal = new();
    private MergePackagesModal MergePackagesModal = new();
    private PackagesInBuforModal PackagesInBuforModal = new();
    private CourierConfigurationModal CourierConfigurationModal = new();

    private int JlReadyToPackCount { get; set; } = 0;
    private int AddressesCount { get; set; } = 0;
    private bool CanPackNotReady = false;
    private bool IsLoading { get; set; } = true;

    protected override async Task OnInitializedAsync()
    {
        IsLoading = true;
        await UserSession.InitializeAsync();

        if (string.IsNullOrWhiteSpace(UserSession.Username))
        {
            Navigation.NavigateTo("/login", forceLoad: true);
            return;
        }

        await LoadData();

        // Auto-refresh every 1 minute
        RefreshListTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(LoadData);
        }, null, TimeSpan.FromSeconds(AppSettings.Intervals.RefreshPackingList), TimeSpan.FromSeconds(AppSettings.Intervals.RefreshPackingList));

        AfkTimer = new System.Threading.Timer(async _ => await CheckAfkAsync(), null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("blazorFocus.focusElement", InputRef);
        }
    }

    private async Task LoadData()
    {
        try
        {
            IsLoading = true;
            Settings = await WorkstationService.GetSettingsAsync();
            JlList = await PackingService.GetJlList(new GetJlListRequest()
            {
                Level = Settings.PackingLevel,
            });

            // Calculate count
            var jlReadyToPack = JlList.ToList();

            JlReadyToPackCount = jlReadyToPack.Count;
            AddressesCount = jlReadyToPack.Where(jl => jl.ClientId != 0).Select(jl => jl.ClientId).Distinct().Count();
        }
        catch (Exception ex)
        {
            Toast.Show("Błąd!", $"Błąd podczas zaczytywania kuwet: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RefreshData()
    {
        await LoadData();
        await JSRuntime.InvokeVoidAsync("blazorFocus.focusElement", InputRef);
    }

    private async Task CheckAfkAsync()
    {
        try
        {
            // get last activity from JS
            var lastActivity = await JSRuntime.InvokeAsync<long>("activityTracker.getLastActivity");
            var idleSeconds = (DateTimeOffset.UtcNow.ToUnixTimeMilliseconds() - lastActivity) / 1000;

            if (idleSeconds >= AppSettings.Intervals.Logout)
            {
                AfkTimer?.Dispose();
                await AuthService.Logout(UserSession.Username);
                await UserSession.LogoutAsync();
                Navigation.NavigateTo("/login", forceLoad: true);
            }
        }
        catch
        {
            // optionally ignore errors
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Enter")
            return;

        var trimmedKuweta = Kuweta?.Trim();
        if (string.IsNullOrWhiteSpace(trimmedKuweta))
            return;

        // Find JL by barcode or name
        var jl = JlList.FirstOrDefault(x =>
            string.Equals(x.Code, trimmedKuweta, StringComparison.OrdinalIgnoreCase) ||
            string.Equals(x.Barcode, trimmedKuweta, StringComparison.OrdinalIgnoreCase));

        if (jl == null)
        {
            Toast.Show("Nie znaleziono", $"Nie znaleziono kuwet o kodzie '{Kuweta}'");
            Kuweta = string.Empty;
            await JSRuntime.InvokeVoidAsync("blazorFocus.focusElement", InputRef);
            return;
        }

        Kuweta = string.Empty;
        await JSRuntime.InvokeVoidAsync("blazorFocus.focusElement", InputRef);

        // Reuse existing logic from row double-click
        await OnRowDoubleClick(jl);
    }

    private async Task OnRowDoubleClick(JlData jl)
    {
        try
        {
            var refreshedJl = await PackingService.GetJlInfoByCode(jl.Code);

            if (refreshedJl == null)
            {
                Toast.Show("Nie znaleziono", "Kuweta nie jest już dostępna na liście.", ToastType.Info);
                return;
            }

            jl = refreshedJl;

            if (jl.Status == 2)
            {
                var password = await PasswordModal.ShowAsync("Wprowadź hasło do kuwety czerwonej");
                if (password == null)
                    return;

                bool valid = await AuthService.ValidatePasswordAsync(password);
                if (!valid)
                {
                    Toast.Show("Błąd!", "Błędne hasło");
                    return;
                }
            }

            int? activePackageId = null;
            if (jl.Status == 3)
            {
                if (jl.Courier == Courier.MIX)
                {
                    Toast.Show("Pakowanie pojedyncze", "Ta kuweta jest już pakowana w trybie pojedynczym i nie można do niej dołączyć.", ToastType.Info);
                    return;
                }

                var inProgress = await PackingService.GetJlListInProgress();
                var active = inProgress
                    .Where(x => string.Equals(x.Name, jl.Code, StringComparison.OrdinalIgnoreCase) && x.PackageId > 0)
                    .OrderByDescending(x => x.Date)
                    .FirstOrDefault();

                if (active is null)
                {
                    Toast.Show("Pakowana", "Kuweta jest oznaczona jako pakowana, ale nie znaleziono aktywnej paczki.", ToastType.Error);
                    return;
                }

                var password = await PasswordModal.ShowAsync("Wprowadź hasło aby dołączyć do pakowania");
                if (password == null)
                    return;

                bool valid = await AuthService.ValidatePasswordAsync(password);
                if (!valid)
                {
                    Toast.Show("Błąd!", "Błędne hasło");
                    return;
                }

                activePackageId = active.PackageId;

                var joinUrl = jl.Courier == Courier.MIX
                    ? $"/kontrola-pakowania/{jl.Code}/single?packTo={activePackageId.Value}"
                    : $"/kontrola-pakowania/{jl.Code}?packTo={activePackageId.Value}";

                Navigation.NavigateTo(joinUrl);
                return;
            }

            if (Settings.PackingLevel != PackingLevel.Bottom)
            {
                // upper level logic
                if (jl.Courier == Courier.MIX)
                    Navigation.NavigateTo($"/kontrola-pakowania/{jl.Code}/single");
                else
                    Navigation.NavigateTo($"/kontrola-pakowania/{jl.Code}");

                return;
            }

            List<(string jlCode, string location)> selectedMergeJls = new();
            PackageSelectionResult? selectedPackage = null;

            //
            // 1️ BUFOR CHECK
            //
            var packagesInBufor = await PackingService.GetPackagesForClient(jl.ClientId, jl.AddressId, jl.AddressType, DocumentStatus.Bufor);

            if (packagesInBufor?.Where(p => p.Courier == jl.Courier).Any() == true)
            {
                selectedPackage = await PackagesInBuforModal.Show(packagesInBufor);
                if (PackagesInBuforModal.WasCancelled)
                    return;
            }

            //
            // 2️ FIND OTHER JLs W/ SAME ADDRESS
            var matchingJls = JlList
                .Where(x =>
                    x.Id != jl.Id &&
                    x.AddressId == jl.AddressId &&
                    x.AddressType == jl.AddressType &&
                    x.Courier == jl.Courier &&
                    x.Status != 3 &&
                    x.AddressId > 0)
                .ToList();

            if (matchingJls.Any())
            {
                selectedMergeJls = await MergeJlsModal.Show(matchingJls, Settings.PrinterLabel, jl);
                if (MergeJlsModal.WasCancelled)
                    return;
            }

            //
            // 3 BUILD FINAL NAVIGATION URL ONCE
            //

            string url;
            if (jl.Courier == Courier.MIX)
                url = $"/kontrola-pakowania/{jl.Code}/single";
            else
                url = $"/kontrola-pakowania/{jl.Code}";

            List<string> queryParts = new();

            if (selectedPackage is not null)
            {
                if (selectedPackage.PackageId.HasValue)
                    queryParts.Add($"packTo={selectedPackage.PackageId}");

                if (!string.IsNullOrWhiteSpace(selectedPackage.InternalBarcode))
                    queryParts.Add($"barcode={selectedPackage.InternalBarcode}");
            }

            if (selectedMergeJls.Any())
            {
                var encoded = selectedMergeJls
                    .Select(x => $"{Uri.EscapeDataString(x.jlCode)}|{Uri.EscapeDataString(x.location)}");

                queryParts.Add($"mergeJls={string.Join(",", encoded)}");
            }

            if (queryParts.Any())
                url += "?" + string.Join("&", queryParts);

            Navigation.NavigateTo(url);
        }
        catch (Exception ex)
        {
            Toast.Show("Błąd", $"Błąd przy próbie podjęcia kuwety {ex.Message}", ToastType.Error);
        }
    }


    private async Task OnManagerButtonClick()
    {
        var password = await PasswordModal.ShowAsync();
        if (password == null)
            return;

        bool valid = await AuthService.ValidatePasswordAsync(password);
        if (!valid)
        {
            Toast.Show("Błąd!", "Błędne hasło");
            return;
        }
        ManagerModal.OpenModal();
        StateHasChanged();
    }

    private async void HandleManagerClick(int returnClick)
    {
        switch (returnClick)
        {
            case 5: /* Zalogowani */
                await LoggedOperatorsModal.ShowModal();
                break;
            case 6: /* Kuwety podjęte */
                await JlInProgressModal.ShowModal();
                break;
            case 7: /* Zwolnij */
                try
                {
                    var pendingSelection = ComboBoxModal.ShowLoading(
                        title: "Zamknij paczke",
                        message: "Wybierz paczke do zamknięcia. Zostanie jej nadany status 'Gotowa do załadunku'",
                        loadingMessage: "Pobieranie listy paczek...");

                    var packages = await PackingService.GetNotClosedPackages();
                    var comboBoxes = new List<ComboBoxDefinition>
                    {
                        new()
                        {
                            Label = "Paczka",
                            Placeholder = "Wybierz paczke",
                            Items = packages.Select(x => x.JlCode).ToList()
                        },
                        new()
                        {
                            Label = "Lokalizacja docelowa",
                            Placeholder = "Wybierz lokalizację docelową",
                            Items = new() { "Zrzuty-rolotok-1-1-1", "Zrzuty-rolotok-1-2-1", "Zrzuty-rolotok-1-3-1", "Zrzuty-rolotok-1-4-1", "Zrzuty-rolotok-1-5-1", "A - Załadunek-1-1-1", "B - Załadunek-1-1-1" }
                        }
                    };

                    ComboBoxModal.SetData(comboBoxes);
                    var result = await pendingSelection;

                    if (result != null)
                    {
                        var closeWmsJlRequest = new WmsCloseJlRequest
                        {
                            PackageNumber = result[0],
                            PackageDestination = result[1],
                            PackingLevel = Settings.PackingLevel,
                            PackingWarehouse = Settings.PackingWarehouse,
                            Courier = Courier.Unknown
                        };
                        var success = await PackingService.CloseWmsJl(closeWmsJlRequest);
                        if (success)
                            Toast.Show("Sukces!", "Paczka została pomyślnie zamknięta.", ToastType.Success);
                    }
                }
                catch (Exception ex)
                {
                    ComboBoxModal.CloseModal();
                    Toast.Show("Błąd!", $"Błąd przy próbie zwolnienia paczki: {ex.Message}");
                }
                break;
            case 8: /* Zmień magazyn */
                await ChangePackingWarehouseModal.Show();
                break;
            case 9: /* Połącz paczki */
                try
                {
                    var result = await MergePackagesModal.Show();
                    if (result != null)
                    {
                        var success = await PackingService.MergePackages(result);
                        if (success)
                            Toast.Show("Sukces!", $"Paczki zostały pomyślnie połączone. Kod kreskowy paczki:<br><b>{result.InitialBarcode}</b>", ToastType.Success);
                    }
                }
                catch (Exception ex)
                {
                    Toast.Show("Błąd!", $"Błąd przy próbie łącznia paczek: {ex.Message}");
                }
                break;
            case 10: /* Do bufora */
                try
                {
                    var internalBarcode = await TextBoxModal.Show("Zabuforuj paczkę/palete.", "Zeskanduj kod kreskowy paczki/palety, która jest zatwierdona i nie została wygenerowana do niej wysyłka. Paczka zmieni status na bufor.", "Kod kreskowy");
                    if (string.IsNullOrEmpty(internalBarcode))
                        return;

                    var success = await PackingService.BufferPackage(internalBarcode);
                    if (!success)
                    {
                        Toast.Show("Błąd!", "Nie udało się zabuforować paczki. Spróbuj ponownie.");
                        return;
                    }

                    Toast.Show("Sukces!", "Paczka została pomyślnie zabuforowana.", ToastType.Success);
                }
                catch (Exception ex)
                {
                    Toast.Show("Błąd!", $"Błąd przy próbie zabuforowania paczki: {ex.Message}");
                }
                break;
            case 11: /* Konfiguracja kurierów */
                List<CourierConfiguration> courierConfigurations;
                try
                {
                    courierConfigurations = await PackingService.GetCourierConfiguration();
                }
                catch (Exception ex)
                {
                    Toast.Show("Błąd!", $"Błąd przy próbie otwarcia konfiguracji kurierów: {ex.Message}");
                    return;
                }

                CourierConfigurationModal.Show(
                    configs: courierConfigurations,
                    onConfirm: async () =>
                    {
                        try
                        {
                            await PackingService.UpdateCourierConfiguration(courierConfigurations);
                            Toast.Show("Sukces", "Konfiguracja została zapisana", ToastType.Success);
                        }
                        catch (Exception ex)
                        {
                            Toast.Show("Błąd", $"Nie udało się zapisać: {ex.Message}");
                        }
                    },
                    onCancel: async () =>
                    {
                    }
                );
                break;
            case 12: /* Zmień hasło */
                try
                {
                    var newPassword = await TextBoxModal.Show("Zmień hasło kierownika", "Wprowadź nowe uniwersalne hasło kierownika do wytycznych/czerwonych kuwet itp.", "Nowe hasło", "password");
                    if (string.IsNullOrEmpty(newPassword))
                        return;

                    var success = await AuthService.ChangeManagerPasswordAsync(newPassword);
                    if (!success)
                    {
                        Toast.Show("Błąd!", "Nie udało się zmienić hasła. Spróbuj ponownie.");
                        return;
                    }

                    Toast.Show("Sukces!", "Hasło zostało zmienione.", ToastType.Success);
                }
                catch (Exception ex)
                {
                    Toast.Show("Błąd!", $"Błąd przy próbie zmiany hasła: {ex.Message}");
                }
                break;
        }
        await JSRuntime.InvokeVoidAsync("blazorFocus.focusElement", InputRef);
    }

    public void Dispose()
    {
        RefreshListTimer?.Dispose();
        AfkTimer?.Dispose();
    }
}
