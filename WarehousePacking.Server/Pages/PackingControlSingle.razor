@using WarehousePacking.Contracts.DTOs
@using WarehousePacking.Contracts.DTOs.Requests
@using WarehousePacking.Server.Helpers
@using WarehousePacking.Server.Services
@using WarehousePacking.Contracts.Data.Enums

@page "/kontrola-pakowania/{jl}/single"
@layout NoNavLayout
@inherits PackingPageBase

<AppBusyOverlay IsVisible="IsPageLoading"
                Text="@(IsFinishingLoading ? "Finalizowanie paczki..." : "Ładowanie danych pakowania...")" />

<div class="app-page app-page--fill pack-control">

    <PackingHeader @ref="Header"
                   JlItems="JlItems"
                   CurrentJl="CurrentJl"
                   Username="@UserSession.Username"
                   IsMainOperator="@IsMainOperator"
                   MainOperator="@MainOperator"
                   ActiveOperators="@ActiveOperators"
                   OnManagerClick="HandleManagerClick"
                   OnManagerRequestPassword="OnManagerButtonClick" />

    <ScanInput @ref="ScanInputComponent" OnKeyDown="HandleCodeInput" Disabled="@MovedProduct" />

    <PackingTables JlItems="JlItems"
                   PackedItems="PackedItems"
                   SelectedPackedItem="SelectedPackedItem"
                   HighlightedRows="HighlightedRows"
                   OnRowDoubleClick="OpenProductModal"
                   OnPackedItemSelect="SelectPackedItem"
                   CourierConfiguration="CourierConfiguration" 
                   CurrentUsername="@UserSession.Username"
                   IsCollaborativePacking="@(ActiveOperators?.Count > 1)"
                   Disabled="@MovedProduct" />

    <PackingButtons NextPackage="NextPackage"
                    UnpackItem="UnpackItem"
                    Close="Close"
                    FinishPacking="FinishPacking"
                    PackedItems="PackedItems"
                    Settings="Settings"
                    IsMainOperator="@IsMainOperator" />

    @* ---- Modals --------------------------------------------------------
       Declared at page level because each @ref binds to a field on
       PackingPageBase, which the shared packing logic drives directly. *@

    <ProductSelectModal @ref=ProductSelectModal OnConfirm="PackItem" />
    <JlSelectModal @ref="JlSelectModal" />
    <PasswordModal @ref=PasswordModal />
    <ConfirmDialog @ref="ConfirmDialog" />
    <CourierModal @ref="CourierModal" />
    <LoggedOperatorsModal @ref="LoggedOperatorsModal" />
    <JlInProgressModal @ref="JlInProgressModal" />
    <ChangePackingWarehouseModal @ref="ChangePackingWarehouseModal" />
    <TextBoxModal @ref="TextBoxModal" />
    <CourierConfigurationModal @ref="CourierConfigurationModal" />

    <FinishPackingModal @ref="FinishPackingModal"
                        Courier="@CurrentJl.Courier"
                        Country="@CurrentJl.DestinationCountry"
                        CourierSrc="@CourierHelper.GetCourierLogo(CurrentJl.ShipmentServices, CurrentJl.Courier)"
                        OnCourierLabel="HandleCourierLabel"
                        OnBufor="HandleBufor"
                        OnInternalBarcode="HandleInternalBarcode" />

    <DimensionsModal @ref="DimensionsModal" />
    <ShipmentModal @ref="ShipmentModal" OnOk="HandleShipmentOkClick" />
    <MergePackagesModal @ref="MergePackagesModal" />

    <Toast @ref="Toast" />
</div>

@code {
    private bool MovedProduct { get; set; } = false;

    private PackingHeader? Header;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // The manager modal lives inside PackingHeader; point the base's
            // reference at it so OpenModal() drives the rendered instance rather
            // than the unrendered placeholder (which throws "render handle not
            // yet assigned"). Mirrors PackingControl.
            ManagerModal = Header?.ManagerModal;
        }

        await base.OnAfterRenderAsync(firstRender);

        if (firstRender)
        {
            Toast.ShowBlocking("Pakowanie pojedyńcze", "Kuweta zawiera towary dla wielu klientów.\nKAŻDY TOWAR NALEŻY SPAKOWAĆ DO OSOBNEJ PACZKI!", ToastType.Info);
        }
    }

    public void FillJlData(JlItemDto item)
    {
        CurrentJl.Courier = item.Courier;
        CurrentJl.CourierName = item.CourierName;
        //CurrentJl.LogoCourier = item.LogoCourier;
        CurrentJl.ShipmentServices = item.ShipmentServices;
        CurrentJl.ClientSymbol = item.ClientSymbol;
        CurrentJl.DestinationCountry = item.DestinationCountry;

        CurrentJl.AddressName = item.AddressName;
        CurrentJl.AddressCountry = item.AddressCountry;
        CurrentJl.AddressCity = item.AddressCity;
        CurrentJl.AddressStreet = item.AddressStreet;
        CurrentJl.AddressPostalCode = item.AddressPostalCode;

        CurrentJl.ClientSymbol = item.ClientSymbol;
        CurrentJl.ClientId = Convert.ToInt32(item.ClientErpId);
        StateHasChanged();
    }

    public void ClearJlData()
    {
        CurrentJl.Courier = Courier.MIX;
        CurrentJl.CourierName = "MIX";
        CurrentJl.ShipmentServices = new();
        CurrentJl.ClientSymbol = "MIX";
        CurrentJl.DestinationCountry = string.Empty;

        CurrentJl.AddressCity = string.Empty;
        CurrentJl.AddressName = string.Empty;
        CurrentJl.AddressCountry = string.Empty;
        CurrentJl.AddressStreet = string.Empty;
        CurrentJl.AddressPostalCode = string.Empty;
        CurrentJl.ClientSymbol = string.Empty;
        CurrentJl.ClientId = 0;
        CurrentJl.PackageClosed = false;
        PackageId = 0;
        StateHasChanged();
    }

    protected override async Task PackItem(decimal qty)
    {
        try
        {
            if (SelectedItem == null || JlItems == null) return;

            if (!await EnsureSinglePackingLock())
                return;

            FillJlData(SelectedItem);
            await LoadCourierConfiguration();
            await CreatePackage(SelectedItem.DocumentId, SelectedItem.DocumentType);
            var jlInProgress = new JlInProgressDto
            {
                Name = Jl,
                PackageId = PackageId
            };
            await PackingService.UpdateJlRealization(jlInProgress);
            bool moved = await MoveItemToPackedSingle(SelectedItem, qty);
            if (!moved) 
            {
                ClearJlData();
                ClosePackageRequest closePackageRequest = new()
                {
                    DocumentId = PackageId,
                    Status = DocumentStatus.Delete
                };
                await PackingService.ClosePackage(closePackageRequest);
                return;
            }

            MovedProduct = true;
            FinishPacking();
        }
        catch (Exception ex)
        {
            Toast.Show("Błąd!", $"Błąd przy próbie spakowania towaru: {ex.Message}");
        }
        finally
        {
            SelectedItem = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task<bool> EnsureSinglePackingLock()
    {
        var inProgress = await PackingService.GetJlListInProgress();
        var blockedByOtherUser = inProgress.Any(x =>
            string.Equals(x.Name, Jl, StringComparison.OrdinalIgnoreCase)
            && !string.Equals(x.User, UserSession.Username, StringComparison.OrdinalIgnoreCase)
            && x.PackageId > 0);

        if (!blockedByOtherUser)
            return true;

        Toast.Show("Kuweta zajęta", "Ta kuweta jest już pakowana w trybie pojedynczym przez innego operatora.", ToastType.Warning);
        await Task.Delay(1500);
        Navigation.NavigateTo("/kontrola-pakowania");
        return false;
    }

    private async Task<bool> MoveItemToPackedSingle(JlItemDto item, decimal qty)
    {
        if (item == null) return false;
        if (ExceedsWeightLimit(item, qty)) return false;

        var persisted = await PackingService.AddPackedPosition(BuildPackedPositionRequest(item, qty));
        if (!persisted)
        {
            Toast.Show("Błąd!", "Nie udało się dodać spakowanej pozycji.");
            return false;
        }

        // Single mode keeps its own lists: there is no collaboration session to
        // hand back a snapshot, because the kuweta is packed by one operator.
        await AnimateListChangeAsync(() =>
        {
            var packedLine = PackedItems.FirstOrDefault(p =>
                p.ItemCode == item.ItemCode
                && p.DocumentId == item.DocumentId
                && p.ErpPositionNumber == item.ErpPositionNumber
                && p.JlCode == item.JlCode);

            if (packedLine == null)
            {
                packedLine = item.CopyAsPackedLine(UserSession.Username);
                PackedItems.Add(packedLine);
            }

            packedLine.JlQuantity += qty;
            item.JlQuantity -= qty;

            if (item.JlQuantity <= 0)
                JlItems.Remove(item);
        });

        return true;
    }

    protected override async Task UnpackItem()
    {
        if (SelectedPackedItem == null) return;

        if (SelectedPackedItem.PackedWMS)
        {
            Toast.Show("Nie można usunąć", "Nie można usunąć pozycji, która została już wysłana do WMS.", ToastType.Warning);
            return;
        }

        var success = await PackingService.RemovePackedPosition(BuildRemovePositionRequest(SelectedPackedItem));
        if (!success)
        {
            Toast.Show("Błąd!", "Nie udało się usunąć spakowanej pozycji.");
            return;
        }
        var jlInProgress = new JlInProgressDto
        {
            Name = Jl,
            PackageId = 0
        };
        await PackingService.UpdateJlRealization(jlInProgress);

        await AnimateListChangeAsync(() =>
        {
            var unpacked = SelectedPackedItem!;
            var existingLeft = JlItems.FirstOrDefault(j => j.ItemCode == unpacked.ItemCode);

            if (existingLeft != null) existingLeft.JlQuantity += unpacked.JlQuantity;
            else JlItems.Add(unpacked);

            PackedItems.Remove(unpacked);
            HighlightedRows.Remove(unpacked.ItemCode);
            SelectedPackedItem = null;
            MovedProduct = false;
        });

        ClearJlData();
    }

    protected override async Task HandleShipmentOkClick((string ScannedCode, string TrackingNumber) data)
    {
        if (IsFinishingLoading)
            return;

        try
        {
            IsFinishingLoading = true;
            await InvokeAsync(StateHasChanged);
            switch (_currentPackingFlow)
            {
                case PackingFlow.FinishPacking:
                    await CloseJlInWMS(CurrentJl.CourierName, data.ScannedCode, data.TrackingNumber, DocumentStatus.Ready);
                    PackedItems.Clear();
                    MovedProduct = false;
                    ClearJlData();
                    CourierConfiguration = new();
                    CurrentJl.InternalBarcode = string.Empty;
                    break;
            }

            // Single mode empties the kuweta one product at a time; once the
            // last one is gone the kuweta itself is done.
            if (!JlItems.Any())
            {
                await ReleaseJlsAsync(removeFromPackingList: true);
                Navigation.NavigateTo("/kontrola-pakowania");
            }
        }
        catch (Exception ex)
        {
            Toast.Show("Błąd!", $"Błąd przy próbie finalizacji pakowania: {ex.Message}");
        }
        finally
        {
            IsFinishingLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }
}
