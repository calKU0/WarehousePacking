@page "/wysylka-paczek"
@using WarehousePacking.Contracts.DTOs
@using WarehousePacking.Contracts.DTOs.Requests
@using WarehousePacking.Server.Helpers
@using WarehousePacking.Server.Settings
@using WarehousePacking.Contracts.Data.Enums
@using Microsoft.Extensions.Options
@inject UserSessionService UserSession
@inject ShipmentService ShipmentService
@inject PackingService PackingService
@inject WorkstationService WorkstationService
@inject ClientPrinterService ClientPrinterService
@inject AuthService AuthService
@inject IOptions<AppSettings> AppOptions
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@implements IDisposable

<div class="package-send position-relative">
    <div class="app-page-header mb-4">
        <span class="app-page-header__icon"><i class="bi bi-send"></i></span>
        <h1 class="app-page-header__title">Wysyłka paczek</h1>
    </div>

    <div class="mb-4">
        <label class="form-label app-section-label" for="psBarcode">Kod kreskowy</label>
        <div class="app-scan">
            <span class="app-scan__icon" aria-hidden="true"><i class="bi bi-upc-scan"></i></span>
            <input id="psBarcode"
                   class="app-scan__input"
                   @bind="Barcode"
                   @bind:event="oninput"
                   @ref="InputRef"
                   @onkeydown="HandleKeyDown"
                   placeholder="Zeskanuj kod kreskowy..."
                   autocomplete="off" />
        </div>
    </div>

    <!-- Two Column Layout -->
    <div class="row g-4">
        <!-- Left Column: Shipment Data -->
        <div class="col-md-9">
            <div class="app-card p-4">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Akronim</label>
                    <InputText @bind-Value="Package.Recipient.Acronym" class="form-control" disabled="@(!Package.ManualEdit)" autocomplete="off" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Nazwa</label>
                    <InputText @bind-Value="Package.Recipient.Name" class="form-control" disabled="@(!Package.ManualEdit)" autocomplete="off" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Ulica</label>
                    <InputText @bind-Value="Package.Recipient.Street" class="form-control" disabled="@(!Package.ManualEdit)" autocomplete="off" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Kod Pocztowy</label>
                    <InputText @bind-Value="Package.Recipient.PostalCode" class="form-control" disabled="@(!Package.ManualEdit)" autocomplete="off" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Miasto</label>
                    <InputText @bind-Value="Package.Recipient.City" class="form-control" disabled="@(!Package.ManualEdit)" autocomplete="off" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Kraj</label>
                    <InputText @bind-Value="Package.Recipient.Country" class="form-control" disabled="@(!Package.ManualEdit)" autocomplete="off" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Telefon</label>
                    <InputText @bind-Value="Package.Recipient.Phone" class="form-control" disabled="@(!Package.ManualEdit)" autocomplete="off" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Mail</label>
                    <InputText @bind-Value="Package.Recipient.Email" type="email" class="form-control" disabled="@(!Package.ManualEdit)" autocomplete="off" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Opis</label>
                    <InputText @bind-Value="Package.Description" class="form-control" disabled="@(!Package.ManualEdit)" autocomplete="off" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Pobranie</label>
                    <InputNumber @bind-Value="Package.ShipmentServices.CODAmount" class="form-control" disabled="@(!Package.ManualEdit)" autocomplete="off" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Waga (kg)</label>
                    <InputNumber @bind-Value="Package.Weight" step="0.01" class="form-control" disabled="@(!Package.ManualEdit)" autocomplete="off" />
                </div>
            </div>

            <!-- Courier & Type -->
            <div class="row g-3 mt-3 mb-4 align-items-center">
                <div class="col-md-3">
                    <label class="form-label fw-bold">Kurier</label>
                    <CourierSelect Value="Package.Courier"
                                   ValueChanged="OnCourierChanged"
                                   Disabled="@(!Package.ManualEdit)" />
                </div>

                @* Fixed-size slot: the logo box reserves its space up front so
                   the form does not jump when the image finishes loading. *@
                <div class="col-md-3">
                    <div class="package-send__courier-slot">
                        @if (Package.Courier != Courier.Unknown)
                        {
                            <img src="@CourierHelper.GetCourierLogo(Package.ShipmentServices, Package.Courier)"
                                 alt="@Package.Courier.GetDescription()" />
                        }
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold">Typ</label>
                    <InputSelect @bind-Value="Package.PackageType" class="form-select" disabled="@(!Package.ManualEdit)">
                        @foreach (var type in Enum.GetValues<PackageType>())
                        {
                            <option value="@type">@type.GetDescription()</option>
                        }
                    </InputSelect>
                </div>
            </div>

            <!-- Buttons Full Width Row -->
            <div class="app-actionbar mt-4">
                <button class="btn btn-primary"
                        disabled="@((Package.Id == 0 && Package.ManualSend == false) || IsSendingPackage)"
                        @onclick="SendPackage">

                    @if (IsSendingPackage)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        <span>Wysyłanie...</span>
                    }
                    else
                    {
                        <span>Wyślij paczkę</span>
                    }
                </button>
                <button class="btn btn-danger"
                        disabled="@((Package.Id == 0 && Package.ManualSend == false) || IsSendingPackage)"
                        @onclick="ClearData">

                    @if (IsSendingPackage)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        <span>Wysyłanie...</span>
                    }
                    else
                    {
                        <span>Wyczyść</span>
                    }
                </button>
            </div>
            </div>
        </div>

        <!-- Right Column: Services + Additional Options -->
        <div class="col-md-3">
            <!-- Services Card -->
            <div class="app-card p-4 mb-4">
                <h6 class="app-section-label mb-3">Usługi dodatkowe</h6>
                <div class="ps-services">
                    <div class="form-check">
                        <InputCheckbox @bind-Value="Package.ShipmentServices.POD"
                                       class="form-check-input"
                                       disabled="@( !Package.ManualEdit )" />
                        <label class="form-check-label">Potwierdzenie dostawy</label>
                    </div>
                    <div class="form-check">
                        <InputCheckbox @bind-Value="Package.ShipmentServices.EXW"
                                       class="form-check-input"
                                       disabled="@( !Package.ManualEdit )" />
                        <label class="form-check-label">Na koszt odbiorcy</label>
                    </div>
                    <div class="form-check">
                        <InputCheckbox @bind-Value="Package.ShipmentServices.ROD"
                                       class="form-check-input"
                                       disabled="@( !Package.ManualEdit )" />
                        <label class="form-check-label">Zwrot dokumentów</label>
                    </div>
                    <div class="form-check">
                        <InputCheckbox @bind-Value="Package.ShipmentServices.PZ"
                                       class="form-check-input"
                                       disabled="@( !Package.ManualEdit )" />
                        <label class="form-check-label">Przesyłka zwrotna</label>
                    </div>
                    <div class="form-check">
                        <InputCheckbox @bind-Value="Package.ShipmentServices.D10"
                                       class="form-check-input"
                                       disabled="@( !Package.ManualEdit )" />
                        <label class="form-check-label">Dostawa do 10</label>
                    </div>
                    <div class="form-check">
                        <InputCheckbox @bind-Value="Package.ShipmentServices.D12"
                                       class="form-check-input"
                                       disabled="@( !Package.ManualEdit )" />
                        <label class="form-check-label">Dostawa do 12</label>
                    </div>
                    <div class="form-check">
                        <InputCheckbox @bind-Value="Package.ShipmentServices.Saturday"
                                       class="form-check-input"
                                       disabled="@( !Package.ManualEdit )" />
                        <label class="form-check-label">Sobota</label>
                    </div>
                    <div class="form-check">
                        <InputCheckbox @bind-Value="Package.ShipmentServices.COD"
                                       class="form-check-input"
                                       disabled="@( !Package.ManualEdit )" />
                        <label class="form-check-label">Pobranie</label>
                    </div>
                </div>
            </div>

            <!-- Additional Options Card -->
            <div class="app-card p-4 mb-4">
                <h6 class="app-section-label mb-3">Opcje dodatkowe</h6>
                <div class="form-check mb-4">
                    <InputCheckbox @bind-Value="Package.ManualEdit" class="form-check-input" />
                    <label class="form-check-label text-danger fw-bold">Modyfikuj dane</label>
                </div>

                <div class="d-flex flex-column gap-2 mb-4">
                    <button class="btn @(Package.Id != 0 ? "btn-outline-primary" : "btn-primary")" disabled="@(Package.Id != 0)" @onclick=SearchAddress>Pobierz adres</button>
                    <button class="btn @(Package.Id == 0 ? "btn-outline-primary" : "btn-primary")" disabled="@(Package.Id == 0)" @onclick=UpdateDimensions>Aktualizuj wymiary</button>
                </div>

                <div class="d-flex flex-column gap-2 mb-4">
                    <CourierRouteButton Courier="Courier.DPD" LogoSrc="@DpdLogo" Label="DPD"
                                        Closed="RoutesStatus.DPDClosed" Busy="ClosingRoutes.Contains(Courier.DPD)"
                                        OnClose="() => CloseRoute(Courier.DPD)" />
                    <CourierRouteButton Courier="Courier.Fedex" LogoSrc="@FedexLogo" Label="Fedex"
                                        Closed="RoutesStatus.FedexClosed" Busy="ClosingRoutes.Contains(Courier.Fedex)"
                                        OnClose="() => CloseRoute(Courier.Fedex)" />
                    <CourierRouteButton Courier="Courier.GLS" LogoSrc="@GlsLogo" Label="GLS"
                                        Closed="RoutesStatus.GLSClosed" Busy="ClosingRoutes.Contains(Courier.GLS)"
                                        OnClose="() => CloseRoute(Courier.GLS)" />
                </div>
                <div class="mb-4 d-flex flex-column">
                    <button class="btn @(Package.Id == 0 ? "btn-outline-info" : "btn-info")" disabled="@(Package.Id == 0)" @onclick=SendEmail>Wyślij mail do opiekuna</button>
                </div>
            </div>
        </div>
    </div>
</div>

<Toast @ref="Toast" />
<EmailModal @ref="EmailModal" />
<ShipmentModal @ref="ShipmentModal" />
<ConfirmDialog @ref="ConfirmDialog"/>
<AddressInvoiceModal @ref="AddressInvoiceModal" OnConfirmed="OnAddressModalConfirmed" />
<PackingListModal @ref="PackingListModal" OnSaveNumber="HandlePackingListSave" OnPrintLabel="HandlePackingListPrint" />
<PasswordModal @ref="PasswordModal" />
<DimensionsModal @ref="DimensionsModal" />
<DocumentElementsSelectModal @ref="DocumentElementsSelectModal" />

@code {
    private bool IsSendingPackage = false;
    private string Barcode { get; set; } = string.Empty;
    private PackageData Package { get; set; } = new();
    private WorkstationSettings WorkstationSettings = new();
    private AppSettings AppSettings => AppOptions.Value;
    private ElementReference InputRef;
    private int _scanHandle;
    private RoutesStatus RoutesStatus = new();
    private HashSet<Courier> ClosingRoutes = new();

    // Plain carrier logos for the "Zamknij Trasę" buttons. Resolved once (the
    // helper hits the disk), since they never change for the life of the page.
    private static readonly string DpdLogo = CourierHelper.GetCourierLogo(null, Courier.DPD);
    private static readonly string GlsLogo = CourierHelper.GetCourierLogo(null, Courier.GLS);
    private static readonly string FedexLogo = CourierHelper.GetCourierLogo(null, Courier.Fedex);

    // Timer for checking closed routes
    private System.Threading.Timer? Timer;

    private ShipmentModal ShipmentModal = new();
    private ConfirmDialog ConfirmDialog = new();
    private Toast Toast = new();
    private EmailModal EmailModal = new();
    private AddressInvoiceModal AddressInvoiceModal = new();
    private PackingListModal PackingListModal = new();
    private PasswordModal PasswordModal = new();
    private DimensionsModal DimensionsModal = new();
    private DocumentElementsSelectModal DocumentElementsSelectModal = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await UserSession.InitializeAsync();
            if (string.IsNullOrWhiteSpace(UserSession.Username))
            {
                Navigation.NavigateTo("/login", forceLoad: true);
                return;
            }

            WorkstationSettings = await WorkstationService.GetSettingsAsync();

            // Auto-refresh every 1 minute.
            Timer = new System.Threading.Timer(async _ =>
            {
                await InvokeAsync(CheckRouteStatus);
            }, null, TimeSpan.Zero, TimeSpan.FromSeconds(AppSettings.Intervals.RefreshRoutesStatus));
        }
        catch (Exception ex)
        {
            Toast.Show("Błąd!", $"Błąd przy próbie pobrania ustawień stanowiska: {ex.Message}");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Keeps the scanner field focused for the lifetime of the page, so
            // clicking buttons or dismissing modals never leaves the scanner
            // typing into nowhere.
            _scanHandle = await JSRuntime.InvokeAsync<int>("scanFocus.attach", InputRef);
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrEmpty(Barcode))
        {
            await LoadData();
        }
    }

    private async Task LoadData()
    {
        try
        {
            var response = await ShipmentService.GetShipmentDataByBarcode(Barcode);

            // Handling Barcode for documents. When document barcode is scanned then we need to create package data based on document number and type.
            if (response == null && Barcode.Length == 19)
            {
                await HandleDocumentBarcodeAsync();
                response = await ShipmentService.GetShipmentDataByBarcode(Barcode);
            }

            if (response == null)
            {
                Toast.Show("Brak paczki!", $"Nie znalaziono paczki o podanym kodzie kreskowym w systemie");
                await ClearData();
                return;
            }

            Package = response;
            if (Package.WysNumber != 0)
            {
                ConfirmDialog.Show(
                    title: "Usuń przesyłkę",
                    message: $"Przesyłka do tej paczki została wygenerowana dnia {Package.DateShipped} przez {Package.PackingUser}. Czy chcesz ją usunąć?",
                    onConfirm: async () =>
                    {
                        try
                        {
                            await ShipmentService.DeleteShipment(Package.Courier, Package.WysNumber, Package.WysType);
                            Toast.Show("Sukces!", "Przesyłka została usunięta.", ToastType.Success);
                        }
                        catch (Exception ex)
                        {
                            Toast.Show("Błąd!", $"Błąd przy próbie usunięcia paczki: {ex.Message}");
                        }
                        finally
                        {
                            await ClearData();
                        }
                    },
                    onCancel: async () =>
                    {
                        await ClearData();                        
                    }
                );
            }
        }
        catch (Exception ex)
        {
            Toast.Show("Błąd!", $"Błąd przy próbie pobrania danych paczki: {ex.Message}");
            await ClearData();
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }


    private async Task SendPackage()
    {
        if (IsSendingPackage)
            return;

        try
        {
            IsSendingPackage = true;
            await InvokeAsync(StateHasChanged);

            if (Package.ManualSend == false)
            {
                var isReady = await ShipmentService.IsPackageReadyToShip(Barcode);
                if (!isReady)
                {
                    Toast.Show("Błąd!", "Paczka nie jest gotowa do wysyłki. Upewnij się, że wszystkie dane są poprawne i paczka została zamknięta.");
                    return;
                }
            }       

            // Validate courier allowed for generating labels
            if (CourierHelper.AllowedCouriersForLabel.Contains(Package.Courier))
            {
                var response = await ShipmentService.SendPackage(Package);

                if (string.IsNullOrEmpty(response?.TrackingNumber))
                {
                    var msg = string.IsNullOrWhiteSpace(response?.ErrorMessage) ? "Nie udało się wygenerować przesyłki!" : response.ErrorMessage;
                    Toast.Show("Błąd!", msg);
                    return;
                }

                if (string.IsNullOrEmpty(response.LabelBase64))
                {
                    var msg = string.IsNullOrWhiteSpace(response.ErrorMessage) ? "Nie udało się wygenerować etykiety kurierskiej!" : response.ErrorMessage;
                    Toast.Show("Błąd!", msg);
                    return;
                }

                var labelContent = response.LabelBase64;
                await ClientPrinterService.PrintAsync(WorkstationSettings.PrinterLabel, response.LabelType.ToString(), labelContent);
                ShipmentModal.Show(Barcode, response.LabelType, WorkstationSettings.PrinterLabel, Package.HasInvoice, false, null, response.TrackingNumber, response.LabelBase64);
                if (Package.HasInvoice)
                {
                    await ClientPrinterService.PrintCrystalAsync(WorkstationSettings.PrinterInvoice, Package.Recipient.Country != "PL" ? "InvoiceEN" : "InvoicePL", new Dictionary<string, string> { { "DocumentId", Package.InvoiceId.ToString() } });
                }

                await ClearData();
            }
            else
            {
                await PackingListModal.Show(Package.Recipient, Package.Courier.GetDescription());
            }
        }
        catch (Exception ex)
        {
            Toast.Show("Błąd!", $"Błąd przy próbie wysłania paczki: {ex.Message}", ToastType.Error, 10000);
            await ClearData();
        }
        finally
        {
            IsSendingPackage = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task HandleDocumentBarcodeAsync()
    {
        if (!TryParseDocumentBarcode(Barcode, out var documentId, out var documentType))
        {
            Toast.Show("Błąd!", "Nieprawidłowy format kodu dokumentu.");
            return;
        }

        var documentInfo = await PackingService.GetDocumentInfo(documentId, documentType);
        if (documentInfo == null || documentInfo.Elements == null || documentInfo.Elements.Count == 0)
        {
            Toast.Show("Błąd!", "Nie znaleziono elementów dla tego dokumentu. Upewnij się, że dokument istnieje.");
            return;
        }

        documentInfo.Elements = await DocumentElementsSelectModal.ShowAsync(documentInfo.DocumentName, documentInfo.Elements);
        if (documentInfo.Elements == null)
            return;

        if (!documentInfo.Elements.Any())
        {
            Toast.Show("Informacja", "Nie wybrano żadnych elementów dokumentu.", ToastType.Info);
            return;
        }

        await CreatePackageForDocument(documentInfo);
        Toast.Show("Sukces", $"Stworzono paczkę.", ToastType.Success);
    }
    
    private bool TryParseDocumentBarcode(string barcode, out int documentId, out int documentType)
    {
        documentId = 0;
        documentType = 0;

        if (string.IsNullOrWhiteSpace(barcode) || barcode.Length != 19)
            return false;

        return int.TryParse(barcode.Substring(3, 4), out documentType)
            && int.TryParse(barcode.Substring(12, 5), out documentId);
    }

    private async Task OnCourierChanged(Courier courier)
    {
        var previousCourier = Package.Courier;
        try
        {
            if (previousCourier != courier && Package.Id != 0)
            {
                UpdatePackageCourierRequest request = new()
                {
                    Courier = courier,
                    PackageId = Package.Id
                };
                await PackingService.CanChangeCourier(request);
            }
            Package.Courier = courier;
        }
        catch (Exception ex)
        {
            Package.Courier = previousCourier;
            Toast.Show("Błąd!", $"Błąd przy próbie zmiany kuriera: {ex.Message}");
        }
    }

    private async Task CreatePackageForDocument(DocumentInfo document)
    {
        try
        {
            var request = new CreatePackageRequest
            {
                AddressId = document.AddressId,
                AddressType = document.AddressType,

                ClientId = document.ClientId,
                Courier = document.Courier,

                Username = UserSession.Username,
                StationNumber = WorkstationSettings.StationNumber,
                PackingLevel = WorkstationSettings.PackingLevel,
                PackageWarehouse = WorkstationSettings.PackingWarehouse,               
            };

            var packageId = await PackingService.CreatePackage(request);
            if (packageId == 0)
            {
                Toast.Show("Błąd!", "Nie udało się stworzyć paczki.");
                return;
            }

            foreach (var element in document.Elements)
            {
                var addElementRequest = new AddPackedPositionRequest
                {
                    PackDate = DateTime.Now,
                    ScanDate = DateTime.Now,
                    PackingDocumentId = packageId,
                    PositionNumber = element.Lp,
                    Username = UserSession.Username,
                    StationNumber = WorkstationSettings.StationNumber,
                    Volume = element.Volume,
                    Weight = element.Weight,
                    Quantity = element.Quantity,
                    SourceDocumentId = document.Id,
                    SourceDocumentType = document.Type,
                };

                await PackingService.AddPackedPosition(addElementRequest);
            }

            var closePackageRequest = new ClosePackageRequest
            {
                DocumentId = packageId,
                Status = DocumentStatus.Ready,
                InternalBarcode = Barcode,
            };

            var result = await PackingService.ClosePackage(closePackageRequest);
        }
        catch (Exception ex)
        {
            Toast.Show("Błąd!", $"Błąd przy próbie utworzenia paczki z dokumentu: {ex.Message}");
        }
    }

    private async Task HandlePackingListSave(string trackingNumber)
    {
        try
        {
            Package.TrackingNumber = trackingNumber;
            var response = await ShipmentService.SendPackage(Package);
        }
        catch (Exception ex)
        {
            Toast.Show("Błąd!", $"Błąd przy próbie zapisu numeru przesyłki: {ex.Message}");
        }
        finally
        {
            await ClearData();
        }
    }

    private async Task HandlePackingListPrint(Recipient recipient)
    {
        try
        {          
            await ClientPrinterService.PrintCrystalAsync(WorkstationSettings.PrinterLabel, "Label", new Dictionary<string, string> { { "Kod Kreskowy", Barcode } });
        }
        catch (Exception ex)
        {
            Toast.Show("Błąd!", $"Błąd przy próbie drukowania etykiety wewnętrznej: {ex.Message}");
        }
        finally
        {
            await ClearData();
        }
    }

    private async Task ClearData()
    {
        Package = new();
        Barcode = string.Empty;
        await InvokeAsync(StateHasChanged);
    }

    private void SendEmail()
    {
        EmailModal.ShowModal(Package.Recipient.Name, Package.PackageName, Package.InvoiceName, Package.Representative, Package.RepresentativeEmail);
    }

    private async Task SearchAddress()
    {
        await AddressInvoiceModal.ShowAsync();
    }

    private void OnAddressModalConfirmed((Recipient Recipient, SearchInvoiceResult? Invoice) data)
    {
        Package.Recipient = data.Recipient;
        Package.InvoiceId = data.Invoice?.InvoiceId ?? 0;
        Package.InvoiceName = data.Invoice?.InvoiceName ?? string.Empty;
        Package.ManualEdit = true;
        Package.ManualSend = true;
    }

    private async Task CheckRouteStatus()
    {
        try
        {
            RoutesStatus = await ShipmentService.GetRoutesStatus();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Toast.Show("Błąd!", $"Błąd przy próbie sprawdzenia statusu tras kurierskich: {ex.Message}");
        }
    }

    private async Task CloseRoute(Courier courier)
    {
        if (ClosingRoutes.Contains(courier))
            return;

        try
        {
            var password = await PasswordModal.ShowAsync("Wprowadź hasło do zamknięcia trasy");
            if (password == null)
                return;

            bool valid = await AuthService.ValidatePasswordAsync(password);
            if (!valid)
            {
                Toast.Show("Błąd!", "Błędne hasło");
                return;
            }

            var shipmentsToClose = await ShipmentService.GetRoutePackages(courier);
            if (shipmentsToClose.Count == 0)
            {
                Toast.Show("Infromacja", $"Nie wysłano dziś żadnej przesyłki. Musi istnieć conajmniej jedna wysyłka aby zamknąć trasę.", ToastType.Info);
                return;
            }

            ConfirmDialog.Show(
                title: "Zamknięcie trasy kurierskiej",
                message: $"Zostanie zamkniętych {shipmentsToClose.Count} wysyłek. Czy na pewno chcesz zamknąć trasę dla kuriera {courier.GetDescription()}?",
                onConfirm: async () =>
                {
                    try
                    {
                        ClosingRoutes.Add(courier);
                        await InvokeAsync(StateHasChanged);
                        var protocol = await ShipmentService.CloseRoute(courier);
                        if (!string.IsNullOrEmpty(protocol.ErrorMessage))
                        {
                            Toast.Show("Błąd", $"Nie udało się zamknąć trasy. Bład: {protocol.ErrorMessage}", ToastType.Error);
                            return;
                        }

                        if (protocol.DataBase64.Any())
                        {
                            foreach (var data in protocol.DataBase64)
                            {
                                await ClientPrinterService.PrintAsync(WorkstationSettings.PrinterInvoice, protocol.DataType.ToString(), data);
                            }
                        }

                        switch (courier)
                        {
                            case Courier.DPD:
                                RoutesStatus.DPDClosed = true;
                                break;
                            case Courier.GLS:
                                RoutesStatus.GLSClosed = true;
                                break;
                            case Courier.Fedex:
                                RoutesStatus.FedexClosed = true;
                                break;
                        }
                        await InvokeAsync(StateHasChanged);
                        Toast.Show("Sukces!", $"Trasa dla kuriera {courier.GetDescription()} została zamknięta.", ToastType.Success);
                    }
                    catch (Exception ex)
                    {
                        Toast.Show("Błąd!", $"Błąd przy próbie zamknięcia trasy: {ex.Message}");
                    }
                    finally
                    {
                        ClosingRoutes.Remove(courier);
                        await InvokeAsync(StateHasChanged);
                    }

                },
                onCancel: async () =>
                {

                }
            );
        }
        catch (Exception ex)
        {
            Toast.Show("Błąd!", $"Błąd przy próbie zamknięcia trasy: {ex.Message}");
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    public async Task UpdateDimensions()
    {
        try
        {
            Dimensions dimensions = await DimensionsModal.Show(Package.Height, Package.Width, Package.Length);
            if (dimensions == null)
                return;

            var request = new UpdatePackageDimensionsRequest
            {
                PackageId = Package.Id,
                Length = dimensions.Length,
                Width = dimensions.Width,
                Height = dimensions.Height,
            };
            await PackingService.UpdatePackageDimensions(request);
            Package.Height = dimensions.Height;
            Package.Width = dimensions.Width;
            Package.Length = dimensions.Length;

            Toast.Show("Sukces!", "Wymiary paczki zostały zaktualizowane.", ToastType.Success);
        }
        catch (Exception ex)
        {
            Toast.Show("Błąd!", $"Błąd przy próbie aktualizacji wymiarów paczki: {ex.Message}");
        }
    }

    public void Dispose()
    {
        Timer?.Dispose();

        if (_scanHandle != 0)
        {
            // The circuit is often already gone by the time Dispose runs, and an
            // unobserved JSDisconnectedException from a fire-and-forget interop
            // call surfaces as an unhandled circuit error. Swallow it explicitly.
            _ = DetachScanFocusAsync(_scanHandle);
            _scanHandle = 0;
        }
    }

    private async Task DetachScanFocusAsync(int handle)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("scanFocus.detach", handle);
        }
        catch (JSDisconnectedException)
        {
            // Browser already went away — nothing to clean up on that side.
        }
        catch (ObjectDisposedException)
        {
        }
    }
}
