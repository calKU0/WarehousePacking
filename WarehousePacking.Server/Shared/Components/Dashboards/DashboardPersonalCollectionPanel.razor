@using WarehousePacking.Contracts.DTOs
@using WarehousePacking.Contracts.DTOs.Dashboards
@using WarehousePacking.Contracts.Data.Enums
@using WarehousePacking.Server.Helpers

@implements IAsyncDisposable

<div class="dashboard-personal-collection-panel h-100 d-flex flex-column">
    <div class="row g-3 mb-3 flex-shrink-0">
        <div class="col-12 col-md-3">
            <DashboardStatCard Title="Dokumenty"
                               Subtitle="Nowe"
                               Value="@FormatHelper.FormatQuantity(DocumentsNewCount)"
                               IconClass="bi bi-file-earmark-plus"
                               AccentClass="dashboard-kpi-primary" />
        </div>
        <div class="col-12 col-md-3">
            <DashboardStatCard Title="Dokumenty"
                               Subtitle="W realizacji"
                               Value="@FormatHelper.FormatQuantity(DocumentsInProgressCount)"
                               IconClass="bi bi-hourglass-split"
                               AccentClass="dashboard-kpi-info" />
        </div>
        <div class="col-12 col-md-3">
            <DashboardStatCard Title="Dokumenty"
                               Subtitle="Gotowe do załadunku"
                               Value="@FormatHelper.FormatQuantity(DocumentsReadyForLoadingCount)"
                               IconClass="bi bi-check2-circle"
                               AccentClass="dashboard-kpi-warning" />
        </div>
        <div class="col-12 col-md-3">
            <DashboardStatCard Title="Operatorzy"
                               Subtitle="Aktywni (5 min)"
                               Value="@FormatHelper.FormatQuantity(ActiveOperatorsCount)"
                               IconClass="bi bi-people"
                               AccentClass="dashboard-kpi-success" />
        </div>
    </div>

    <div class="row g-3 dashboard-main-row flex-grow-1">
        <div class="col-12 col-xl-8 flex-grow-1 d-flex flex-column min-vh-0">
            <DashboardCard Icon="bi bi-list-check" Title="@($"{DashboardPanel.PersonalCollection.GetDescription()} - Dokumenty")">
                        <table class="table table-striped table-hover mb-0 dashboard-table dashboard-table-auto">
                            <thead class="table-dark">
                                <tr>
                                    <th>Klient</th>
                                    <th>Dokument</th>
                                    <th>Status</th>
                                    <th>Data dokumentu</th>
                                    <th class="dashboard-wrap-col">Jednostki logistyczne</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!DocumentRows.Any())
                                {
                                    <DashboardEmptyRow Columns="5"
                                                       IsLoading="IsLoading"
                                                       Icon="bi bi-person-badge"
                                                       Message="Brak dokumentów odbioru własnego." />
                                }
                                else
                                {
                                    @foreach (var row in DocumentRows)
                                    {
                                        <tr class="@($"{GetStatusRowClass(row.Data.Status)} {row.AnimationClass}".Trim())" @key="row.Key">
                                            <td>@row.Data.Client</td>
                                            <td>@row.Data.Code</td>
                                            <td>@row.Data.StatusName</td>
                                            <td>@row.Data.Date</td>
                                            <td class="dashboard-wrap-col">@row.Data.JlCodes</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
            </DashboardCard>
        </div>

        <div class="col-12 col-xl-4 d-flex">
            <DashboardCard Icon="bi bi-person-workspace" Title="Aktywne operacje">
                <Meta>
                    <span class="dashboard-time-text">Najdłużej: <DashboardAnimatedValue Text="@LongestActiveElapsed" CssClass="dashboard-time-text" /></span>
                </Meta>
                <ChildContent>
                        <table class="table table-striped table-hover mb-0 dashboard-table dashboard-table-auto">
                            <thead class="table-dark">
                                <tr>
                                    <th>Dokument</th>
                                    <th>Operator</th>
                                    <th>Od ost. operacji</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!RecentOperationRows.Any())
                                {
                                    <DashboardEmptyRow Columns="3"
                                                       IsLoading="IsLoading"
                                                       Icon="bi bi-person-x"
                                                       Message="Brak aktywnych operacji (ostatnie 5 min)." />
                                }
                                else
                                {
                                    @foreach (var rowState in RecentOperationRows)
                                    {
                                        <tr class="@($"{ElapsedClassHelper.GetRowClass(rowState.Data.Date, ColorConfig.OperatorLastActivityRedThresholdMinutes, ColorConfig.OperatorLastActivityYellowThresholdMinutes)} {rowState.AnimationClass}".Trim())" @key="rowState.Key">
                                            <td>@GetOperationDocument(rowState.Data)</td>
                                            <td>@GetOperationOperator(rowState.Data)</td>
                                            <td class="dashboard-elapsed-cell">
                                                <DashboardElapsedBadge Since="rowState.Data.Date"
                                                                       RedThresholdMinutes="ColorConfig.OperatorLastActivityRedThresholdMinutes"
                                                                       YellowThresholdMinutes="ColorConfig.OperatorLastActivityYellowThresholdMinutes" />
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                </ChildContent>
            </DashboardCard>
        </div>
    </div>
</div>


@code {
    private sealed record PersonalCollectionDocumentSummary(
        string Key,
        string Client,
        string Code,
        WarehouseTaskStatus Status,
        string StatusName,
        DateTime Date,
        string JlCodes);

    [Parameter] public List<PersonalCollection> PersonalCollections { get; set; } = new();
    [Parameter] public List<WarehouseOperation> RecentOperations { get; set; } = new();
    [Parameter] public DashboardColorConfiguration ColorConfig { get; set; } = new();
    [Parameter] public bool IsLoading { get; set; }

    // Rows animate only as they join or leave; see DashboardRowSync.
    private readonly DashboardRowSync<PersonalCollectionDocumentSummary> _documentSync;
    private readonly DashboardRowSync<WarehouseOperation> _operationSync;

    public DashboardPersonalCollectionPanel()
    {
        _documentSync = new DashboardRowSync<PersonalCollectionDocumentSummary>(() => InvokeAsync(StateHasChanged));
        _operationSync = new DashboardRowSync<WarehouseOperation>(() => InvokeAsync(StateHasChanged));
    }

    private List<DashboardRow<PersonalCollectionDocumentSummary>> DocumentRows => _documentSync.Rows;
    private List<DashboardRow<WarehouseOperation>> RecentOperationRows => _operationSync.Rows;

    private int DocumentsInProgressCount => DocumentRows.Count(x => x.Data.Status is WarehouseTaskStatus.Processing or WarehouseTaskStatus.ReadyForExecution);
    private int DocumentsReadyForLoadingCount => DocumentRows.Count(x => x.Data.Status == WarehouseTaskStatus.ReadyForLoading);
    private int DocumentsNewCount => DocumentRows.Count(x => x.Data.Status == WarehouseTaskStatus.New);

    /// <summary>
    /// Row tint by document status, driven by the three comma-separated status
    /// lists on <see cref="DashboardColorConfiguration"/>. Out of the box only
    /// "Gotowy do załadunku" (18) is green and everything else is left plain.
    /// A status listed in none of the three gets no class at all.
    /// </summary>
    private string GetStatusRowClass(WarehouseTaskStatus status)
    {
        if (Matches(ColorConfig.PersonalCollectionErrorStatuses, status)) return "is-error";
        if (Matches(ColorConfig.PersonalCollectionWarningStatuses, status)) return "is-warning";
        if (Matches(ColorConfig.PersonalCollectionReadyStatuses, status)) return "is-ready";
        return string.Empty;
    }

    private static bool Matches(string? configuredStatuses, WarehouseTaskStatus status)
    {
        if (string.IsNullOrWhiteSpace(configuredStatuses))
        {
            return false;
        }

        foreach (var part in configuredStatuses.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            // A typo in the configuration must not colour every row red, and it
            // certainly must not throw on an unattended wallboard — an unparsable
            // entry is simply skipped.
            if (int.TryParse(part, out var id) && id == (int)status)
            {
                return true;
            }
        }

        return false;
    }

    private int ActiveOperatorsCount => RecentOperations
        .Select(x => x.Operator)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Count();

    private string LongestActiveElapsed => RecentOperationRows.Any() ? FormatHelper.FormatElapsed(RecentOperationRows.Min(x => x.Data.Date)) : "-";

    protected override void OnParametersSet()
    {
        SyncRows();
    }

    private void SyncRows()
    {
        _documentSync.Sync(BuildDocumentSummaries(), x => x.Key);
        _operationSync.Sync(BuildOperationSummaries(), GetOperationKey);
    }

    private List<WarehouseOperation> BuildOperationSummaries()
    {
        return RecentOperations
            .GroupBy(GetOperationKey, StringComparer.OrdinalIgnoreCase)
            .Select(group => group.OrderByDescending(x => x.Date).First())
            .OrderBy(x => x.Date)
            .ToList();
    }

    private List<PersonalCollectionDocumentSummary> BuildDocumentSummaries()
    {
        return PersonalCollections
            .Select(doc =>
            {
                return new PersonalCollectionDocumentSummary(
                    doc.DocId.ToString(),
                    doc.ClientCode,
                    doc.DocName,
                    doc.Status,
                    doc.Status.GetDescription(),
                    doc.Date,
                    doc.JlCodes ?? "-"
                );
            })
            .ToList();
    }

    private static string GetOperationKey(WarehouseOperation operation)
    {
        return string.IsNullOrWhiteSpace(operation.Operator)
            ? $"id:{operation.Id}"
            : operation.Operator;
    }

    private static string GetOperationDocument(WarehouseOperation operation)
    {
        return string.IsNullOrWhiteSpace(operation.DocumentCode) ? operation.DocId.ToString() : operation.DocumentCode;
    }

    private static string GetOperationOperator(WarehouseOperation operation)
    {
        return string.IsNullOrWhiteSpace(operation.Operator) ? "-" : operation.Operator;
    }

    protected override void OnInitialized()
    {
        DashboardClock.EnsureStarted();
        DashboardClock.Tick += OnClockTick;
    }

    /// <summary>
    /// Re-renders once a second so the "Najdłużej" counter in the card header
    /// keeps moving. The elapsed badges in the rows drive themselves off the
    /// same clock (see DashboardElapsedBadge) and do not need this.
    /// </summary>
    private void OnClockTick() => _ = InvokeAsync(StateHasChanged);

    public ValueTask DisposeAsync()
    {
        DashboardClock.Tick -= OnClockTick;
        _documentSync.Dispose();
        _operationSync.Dispose();
        return ValueTask.CompletedTask;
    }
}
