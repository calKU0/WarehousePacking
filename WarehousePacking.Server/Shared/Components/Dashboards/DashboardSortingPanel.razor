@using WarehousePacking.Contracts.DTOs
@using WarehousePacking.Contracts.DTOs.Dashboards
@using WarehousePacking.Contracts.Data.Enums
@using WarehousePacking.Server.Helpers

@implements IAsyncDisposable

<div class="dashboard-sorting-panel h-100 d-flex flex-column">
    <div class="row g-3 mb-3">
        <div class="col-12 col-md-3">
            <DashboardStatCard Title="Dokumenty"
                               Subtitle="Do sortowania"
                               Value="@FormatHelper.FormatQuantity(Documents.Count())"
                               IconClass="bi bi-file-earmark-text"
                               AccentClass="dashboard-kpi-primary" />
        </div>
        <div class="col-12 col-md-3">
            <DashboardStatCard Title="Towary"
                               Subtitle="Do sortowania"
                               Value="@FormatHelper.FormatQuantity(RemainingQuantityTotal)"
                               IconClass="bi bi-boxes"
                               AccentClass="dashboard-kpi-info" />
        </div>
        <div class="col-12 col-md-3">
            <DashboardStatCard Title="Waga / Objętość"
                               Subtitle="Pozostało"
                               Value="@($"{FormatHelper.FormatQuantity(RemainingWeightTotal, "kg", "F0")} / {FormatHelper.FormatQuantity(RemainingVolumeTotal, "m³")}")"
                               IconClass="bi bi-speedometer2"
                               AccentClass="dashboard-kpi-warning" />
        </div>
        <div class="col-12 col-md-3">
            <DashboardStatCard Title="Operatorzy"
                               Subtitle="Aktywni (5 min)"
                               Value="@FormatHelper.FormatQuantity(ActiveOperatorsCount)"
                               IconClass="bi bi-people"
                               AccentClass="dashboard-kpi-success" />
        </div>
    </div>

    <div class="row g-3 dashboard-main-row flex-grow-1">
        <div class="col-12 col-xl-8 d-flex">
            <div class="card shadow-sm h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-list-check me-2"></i>@DashboardPanel.Sorting.GetDescription() - Dokumenty</span>
                </div>
                <div class="card-body p-0 mb-0 dashboard-scroll-host">
                    <div class="table-responsive dashboard-auto-scroll dashboard-scroll-fill flex-grow-1">
                        <table class="table table-striped table-hover mb-0 dashboard-table dashboard-table-auto">
                            <thead class="table-dark">
                                <tr>
                                    <th>@DocumentsHeader</th>
                                    <th>Status</th>
                                    <th>@QuantityHeader</th>
                                    <th>@WeightHeader</th>
                                    <th>@VolumeHeader</th>
                                    <th>Operatorzy</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!DocumentRows.Any())
                                {
                                    <tr>
                                        <td colspan="7" class="text-center text-muted py-3">
                                            @if (IsLoading)
                                            {
                                                <span>Ładowanie danych...</span>
                                            }
                                            else
                                            {
                                                <span>Brak dokumentów sortowania.</span>
                                            }
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var row in DocumentRows)
                                    {
                                        <tr class="@row.AnimationClass" @key="row.Key">
                                            <td>@row.Data.Code</td>
                                            <td>@row.Data.StatusName</td>
                                            <td><DashboardAnimatedValue Text="@FormatHelper.FormatQuantity(row.Data.RemainingQuantity)" /></td>
                                            <td><DashboardAnimatedValue Text="@FormatHelper.FormatQuantity(row.Data.RemainingWeight, "kg", "F0")" /></td>
                                            <td><DashboardAnimatedValue Text="@FormatHelper.FormatQuantity(row.Data.RemainingVolume, "m³")" /></td>
                                            <td class="dashboard-operators-cell" title="@row.Data.OperatorsList">@row.Data.OperatorsList</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-4 d-flex">
            <div class="card shadow-sm h-100 w-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-person-workspace me-2"></i>Aktywne operacje</span>
                    <span class="small text-muted dashboard-time-text">Najdłużej: <DashboardAnimatedValue Text="@LongestActiveElapsed" CssClass="dashboard-time-text" /></span>
                </div>
                <div class="card-body p-0 mb-0 dashboard-scroll-host">
                    <div class="table-responsive dashboard-auto-scroll dashboard-scroll-fill flex-grow-1">
                        <table class="table table-striped table-hover mb-0 dashboard-table dashboard-table-auto">
                            <thead class="table-dark">
                                <tr>
                                    <th>Operator</th>
                                    <th>Od ost. operacji</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!RecentOperationRows.Any())
                                {
                                    <tr>
                                        <td colspan="2" class="text-center text-muted py-3">
                                            @if (IsLoading)
                                            {
                                                <span>Ładowanie danych...</span>
                                            }
                                            else
                                            {
                                                <span>Brak aktywnych operacji (ostatnie 5 min).</span>
                                            }
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var rowState in RecentOperationRows)
                                    {
                                        var row = rowState.Data;
                                        <tr class="@($"{GetElapsedRowClass(row.Date)} {rowState.AnimationClass}".Trim())" @key="rowState.Key">
                                            <td>@GetOperationOperator(row)</td>
                                            <td class="dashboard-elapsed-cell">
                                                <span class="badge @GetElapsedBadgeClass(row.Date) dashboard-elapsed-badge dashboard-time-text">
                                                    <DashboardAnimatedValue Text="@FormatHelper.FormatElapsed(row.Date)" CssClass="dashboard-time-text" />
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private const int RowAnimationDelayMs = 280;
    private readonly CancellationTokenSource _clockCts = new();
    private DateTime _now = DateTime.UtcNow;
    private bool _clockStarted;

    private sealed record SortingDocumentSummary(
        string Key,
        string Code,
        string CourierName,
        string CourierSrc,
        string StatusName,
        decimal RemainingQuantity,
        decimal RemainingWeight,
        decimal RemainingVolume,
        string OperatorsList);


    private sealed class SortingDocumentRowView
    {
        public string Key { get; set; } = string.Empty;
        public SortingDocumentSummary Data { get; set; } = null!;
        public string AnimationClass { get; set; } = string.Empty;
        public bool IsLeaving { get; set; }
    }

    private sealed class SortingOperationRowView
    {
        public string Key { get; set; } = string.Empty;
        public WarehouseOperation Data { get; set; } = null!;
        public string AnimationClass { get; set; } = string.Empty;
        public bool IsLeaving { get; set; }
    }

    [Parameter] public List<WarehouseDocument> Documents { get; set; } = new();
    [Parameter] public List<WarehouseOperation> RecentOperations { get; set; } = new();
    [Parameter] public bool IsLoading { get; set; }

    private List<SortingDocumentRowView> DocumentRows { get; set; } = new();
    private List<SortingOperationRowView> RecentOperationRows { get; set; } = new();

    private decimal RemainingDocumentsTotal => DocumentRows.Count(x => x.Data.Code != null);
    private decimal RemainingQuantityTotal => DocumentRows.Sum(x => x.Data.RemainingQuantity);
    private decimal RemainingWeightTotal => DocumentRows.Sum(x => x.Data.RemainingWeight);
    private decimal RemainingVolumeTotal => DocumentRows.Sum(x => x.Data.RemainingVolume);

    private string DocumentsHeader => $"Dokument ({FormatHelper.FormatQuantity(RemainingDocumentsTotal)})";
    private string QuantityHeader => $"Ilość ({FormatHelper.FormatQuantity(RemainingQuantityTotal)})";
    private string WeightHeader => $"Waga ({FormatHelper.FormatQuantity(RemainingWeightTotal, "kg", "F0")})";
    private string VolumeHeader => $"Objętość ({FormatHelper.FormatQuantity(RemainingVolumeTotal, "m³")})";

    private int ActiveOperatorsCount => RecentOperations
            .Select(x => x.Operator)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Count();

    private string LongestActiveElapsed => RecentOperationRows.Any()
        ? FormatHelper.FormatElapsed(RecentOperationRows.Min(x => x.Data.Date))
        : "-";

    protected override void OnParametersSet()
    {
        try
        {
            _now = DashboardClock.Now;
        }
        catch
        {
            _now = DateTime.UtcNow;
        }

        SyncDocumentRows();
        SyncRecentOperationRows();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_clockStarted)
        {
            _clockStarted = true;
            _ = StartClockAsync();
        }
    }

    private async Task StartClockAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await timer.WaitForNextTickAsync(_clockCts.Token))
            {
                try { _now = DashboardClock.Now; } catch { _now = DateTime.UtcNow; }
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    private List<SortingDocumentSummary> BuildDocumentSummaries()
    {
        return Documents
            .Select(doc =>
            {
                var operators = RecentOperations
                    .Where(op =>
                        (op.ErpDocumentId == doc.ErpId && op.ErpDocumentType == doc.ErpType) ||
                        string.Equals(op.DocumentCode, doc.Code, StringComparison.OrdinalIgnoreCase))
                    .Select(op => op.Operator)
                    .Where(op => !string.IsNullOrWhiteSpace(op))
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .OrderBy(op => op)
                    .ToList();

                var courierName = doc.Courier == Courier.Unknown ? "Brak" : doc.Courier.GetDescription();
                var courierSrc = CourierHelper.GetCourierLogo(new ShipmentServices(), doc.Courier);

                return new SortingDocumentSummary(
                    doc.Id.ToString(),
                    doc.Code,
                    courierName,
                    courierSrc,
                    doc.Status.GetDescription(),
                    Math.Max(0m, doc.Quantity - doc.QuantityRealized),
                    Math.Max(0m, doc.Weight - doc.WeightRealized),
                    Math.Max(0m, doc.Volume - doc.VolumeRealized),
                    operators.Any() ? string.Join(", ", operators) : "-"
                );
            })
            .OrderByDescending(x => x.RemainingWeight)
            .ThenBy(x => x.Code)
            .ToList();
    }

    private void SyncDocumentRows()
    {
        var latest = BuildDocumentSummaries();
        var latestKeys = latest.Select(x => x.Key).ToHashSet(StringComparer.OrdinalIgnoreCase);

        foreach (var item in latest)
        {
            var existing = DocumentRows.FirstOrDefault(x => string.Equals(x.Key, item.Key, StringComparison.OrdinalIgnoreCase));
            if (existing is null)
            {
                var added = new SortingDocumentRowView
                {
                    Key = item.Key,
                    Data = item,
                    AnimationClass = "dashboard-row-enter"
                };

                DocumentRows.Add(added);
                _ = ClearDocumentEnterClassAsync(added);
            }
            else
            {
                existing.Data = item;
                if (existing.IsLeaving)
                {
                    existing.IsLeaving = false;
                    existing.AnimationClass = "dashboard-row-enter";
                    _ = ClearDocumentEnterClassAsync(existing);
                }
            }
        }

        foreach (var row in DocumentRows.Where(x => !x.IsLeaving && !latestKeys.Contains(x.Key)).ToList())
        {
            row.IsLeaving = true;
            row.AnimationClass = "dashboard-row-leave";
            _ = RemoveDocumentRowAsync(row);
        }

        var orderedActive = latest.Select(x => DocumentRows.First(r => string.Equals(r.Key, x.Key, StringComparison.OrdinalIgnoreCase))).ToList();
        var leaving = DocumentRows.Where(x => x.IsLeaving).ToList();
        DocumentRows = orderedActive.Concat(leaving).ToList();
    }


    private async Task ClearDocumentEnterClassAsync(SortingDocumentRowView row)
    {
        await Task.Delay(RowAnimationDelayMs);
        if (row.IsLeaving)
        {
            return;
        }

        row.AnimationClass = string.Empty;
        await InvokeAsync(StateHasChanged);
    }

    private async Task RemoveDocumentRowAsync(SortingDocumentRowView row)
    {
        await Task.Delay(RowAnimationDelayMs);
        if (!row.IsLeaving)
        {
            return;
        }

        DocumentRows = DocumentRows.Where(x => !ReferenceEquals(x, row)).ToList();
        await InvokeAsync(StateHasChanged);
    }

    private void SyncRecentOperationRows()
    {
        // Filter out empty operators, group by operator name, and pick the one with the maximum (last) date
        var latest = RecentOperations
            .Where(x => !string.IsNullOrWhiteSpace(x.Operator))
            .GroupBy(x => x.Operator, StringComparer.OrdinalIgnoreCase)
            .Select(g => g.OrderByDescending(op => op.Date).First())
            .OrderByDescending(x => x.Date)
            .ToList();

        var latestKeys = latest.Select(x => x.Operator).ToHashSet(StringComparer.OrdinalIgnoreCase);

        foreach (var item in latest)
        {
            var itemKey = item.Operator; // Key is now based on unique operator identity
            item.Date = FormatHelper.ToLocalTime(item.Date);
            var existing = RecentOperationRows.FirstOrDefault(x => string.Equals(x.Key, itemKey, StringComparison.OrdinalIgnoreCase));
            if (existing is null)
            {
                var added = new SortingOperationRowView
                {
                    Key = itemKey,
                    Data = item,
                    AnimationClass = "dashboard-row-enter"
                };

                RecentOperationRows.Add(added);
                _ = ClearOperationEnterClassAsync(added);
            }
            else
            {
                existing.Data = item;
                if (existing.IsLeaving)
                {
                    existing.IsLeaving = false;
                    existing.AnimationClass = "dashboard-row-enter";
                    _ = ClearOperationEnterClassAsync(existing);
                }
            }
        }

        foreach (var row in RecentOperationRows.Where(x => !x.IsLeaving && !latestKeys.Contains(x.Key)).ToList())
        {
            row.IsLeaving = true;
            row.AnimationClass = "dashboard-row-leave";
            _ = RemoveOperationRowAsync(row);
        }

        var orderedActive = latest.Select(x => RecentOperationRows.First(r => string.Equals(r.Key, x.Operator, StringComparison.OrdinalIgnoreCase))).ToList();
        var leaving = RecentOperationRows.Where(x => x.IsLeaving).ToList();
        RecentOperationRows = orderedActive.Concat(leaving).ToList();
    }

    private async Task ClearOperationEnterClassAsync(SortingOperationRowView row)
    {
        await Task.Delay(RowAnimationDelayMs);
        if (row.IsLeaving) return;
        row.AnimationClass = string.Empty;
        await InvokeAsync(StateHasChanged);
    }

    private async Task RemoveOperationRowAsync(SortingOperationRowView row)
    {
        await Task.Delay(RowAnimationDelayMs);
        if (!row.IsLeaving) return;
        RecentOperationRows = RecentOperationRows.Where(x => !ReferenceEquals(x, row)).ToList();
        await InvokeAsync(StateHasChanged);
    }

    // --- Metody pomocnicze dla tabeli operacji ---
    private string GetOperationDocument(WarehouseOperation op)
    {
        return Documents.FirstOrDefault(d => d.Id == op.DocId)?.Code ?? op.DocId.ToString();
    }

    private string GetOperationOperator(WarehouseOperation op)
    {
        return op.Operator;
    }

    private string GetElapsedBadgeClass(DateTime date)
    {
        var elapsed = _now - date;
        if (elapsed.TotalMinutes > 4) return "bg-danger";
        if (elapsed.TotalMinutes > 2) return "bg-warning text-dark";
        return "bg-success";
    }

    private string GetElapsedRowClass(DateTime date)
    {
        return string.Empty;
    }

    public ValueTask DisposeAsync()
    {
        _clockCts.Cancel();
        _clockCts.Dispose();
        return ValueTask.CompletedTask;
    }
}