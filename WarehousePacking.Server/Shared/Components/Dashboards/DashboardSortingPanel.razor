@using WarehousePacking.Contracts.DTOs
@using WarehousePacking.Contracts.DTOs.Dashboards
@using WarehousePacking.Contracts.Data.Enums
@using WarehousePacking.Server.Helpers

@implements IAsyncDisposable

<div class="dashboard-sorting-panel h-100 d-flex flex-column">
    <div class="row g-3 mb-3">
        <div class="col-12 col-md-3">
            <DashboardStatCard Title="Jl"
                               Subtitle="Do sortowania"
                               Value="@FormatHelper.FormatQuantity(LusTotal)"
                               IconClass="bi bi-file-earmark-text"
                               AccentClass="dashboard-kpi-primary" />
        </div>
        <div class="col-12 col-md-3">
            <DashboardStatCard Title="Towary / Ilość"
                               Subtitle="Do sortowania"
                               Value="@($"{FormatHelper.FormatQuantity(ProductsCountTotal)} / {FormatHelper.FormatQuantity(ProductsSumTotal, format: "F0")}")"
                               IconClass="bi bi-boxes"
                               AccentClass="dashboard-kpi-info" />
        </div>
        <div class="col-12 col-md-3">
            <DashboardStatCard Title="Waga"
                               Subtitle="Pozostało"
                               Value="@($"{FormatHelper.FormatQuantity(WeightTotal, "kg", "F0")}")"
                               IconClass="bi bi-speedometer2"
                               AccentClass="dashboard-kpi-warning" />
        </div>
        <div class="col-12 col-md-3">
            <DashboardStatCard Title="Operatorzy"
                               Subtitle="Aktywni (5 min)"
                               Value="@FormatHelper.FormatQuantity(ActiveOperatorsCount)"
                               IconClass="bi bi-people"
                               AccentClass="dashboard-kpi-success" />
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-12">
            <div class="card shadow-sm dashboard-courier-strip">
                <div class="card-body py-2 d-flex align-items-center flex-wrap gap-4">
                    @foreach (var courier in CourierBreakdown)
                    {
                        <div class="d-flex align-items-center gap-2">
                            @if (!string.IsNullOrEmpty(courier.LogoSrc))
                            {
                                <img src="@courier.LogoSrc" alt="@courier.Name" style="max-height: 28px; max-width: 40px; object-fit: contain;" />
                            }
                            else
                            {
                                <i class="bi bi-truck text-muted"></i>
                            }
                            <span class="text-secondary">@courier.Name</span>
                            <span class="badge text-bg-secondary"><DashboardAnimatedValue Text="@FormatHelper.FormatQuantity(courier.Count)" /></span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 dashboard-main-row flex-grow-1">
        <div class="col-12 col-xl-9 d-flex">
            <div class="card shadow-sm h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-list-check me-2"></i>@DashboardPanel.Sorting.GetDescription() - Dokumenty</span>
                </div>
                <div class="card-body p-0 mb-0 dashboard-scroll-host">
                    <div class="table-responsive dashboard-auto-scroll dashboard-scroll-fill flex-grow-1">
                        <table class="table table-striped table-hover mb-0 dashboard-table dashboard-table-auto">
                            <thead class="table-dark">
                                <tr>
                                    <th>Jl</th>
                                    <th>Strefa</th>
                                    <th>Kurierzy</th>
                                    <th>Towary (Il.)</th>
                                    <th>Waga</th>
                                    <th>Data pick.</th>
                                    <th>Operator pick.</th>
                                    <th class="dashboard-operators-cell">Operatorzy sort.</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!LuRows.Any())
                                {
                                    <tr>
                                        <td colspan="7" class="text-center text-muted py-3">
                                            @if (IsLoading)
                                            {
                                                <AppSpinner Size="lg" Label="Ładowanie danych..." Block="true" />
                                            }
                                            else
                                            {
                                                <span>Brak dokumentów sortowania.</span>
                                            }
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var row in LuRows)
                                    {
                                        <tr class="@row.AnimationClass" @key="row.Key">
                                            <td>@row.Data.Code</td>
                                            <td>@row.Data.Zone</td>
                                            <td>@row.Data.Couriers</td>
                                            <td><DashboardAnimatedValue Text="@($"{FormatHelper.FormatQuantity(row.Data.ProductsCount)} ({FormatHelper.FormatQuantity(row.Data.ProductsSum, format: "F0")})")" /></td>
                                            <td><DashboardAnimatedValue Text="@FormatHelper.FormatQuantity(row.Data.Weight, "kg", "F0")" /></td>
                                            <td>@(row.Data.LastPickingDate == null || row.Data.LastPickingDate == DateTime.MinValue ? "-" : FormatHelper.ToLocalTime(row.Data.LastPickingDate.Value).ToString("yyyy-MM-dd HH:mm"))</td>
                                            <td>@row.Data.LastPickingOperator</td>
                                            <td class="dashboard-operators-cell"><DashboardOperatorsCell Operators="@row.Data.OperatorsList" /></td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-3 d-flex">
            <div class="card shadow-sm h-100 w-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-person-workspace me-2"></i>Aktywne operacje</span>
                    <span class="small text-muted dashboard-time-text">Najdłużej: <DashboardAnimatedValue Text="@LongestActiveElapsed" CssClass="dashboard-time-text" Animate="false" /></span>
                </div>
                <div class="card-body p-0 mb-0 dashboard-scroll-host">
                    <div class="table-responsive dashboard-auto-scroll dashboard-scroll-fill flex-grow-1">
                        <table class="table table-striped table-hover mb-0 dashboard-table dashboard-table-auto">
                            <thead class="table-dark">
                                <tr>
                                    <th>Operator</th>
                                    <th>Od ost. operacji</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!RecentOperationRows.Any())
                                {
                                    <tr>
                                        <td colspan="2" class="text-center text-muted py-3">
                                            @if (IsLoading)
                                            {
                                                <AppSpinner Size="lg" Label="Ładowanie danych..." Block="true" />
                                            }
                                            else
                                            {
                                                <span>Brak aktywnych operacji (ostatnie 5 min).</span>
                                            }
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var rowState in RecentOperationRows)
                                    {
                                        var row = rowState.Data;
                                        <tr class="@($"{GetElapsedRowClass(row.Date)} {rowState.AnimationClass}".Trim())" @key="rowState.Key">
                                            <td>@GetOperationOperator(row)</td>
                                            <td class="dashboard-elapsed-cell">
                                                <span class="badge @GetElapsedBadgeClass(row.Date) dashboard-elapsed-badge dashboard-time-text">
                                                    <DashboardAnimatedValue Text="@FormatHelper.FormatElapsed(row.Date)" CssClass="dashboard-time-text" Animate="false" />
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private const int RowAnimationDelayMs = 280;
    private readonly CancellationTokenSource _clockCts = new();
    private DateTime _now = DateTime.UtcNow;
    private bool _clockStarted;

    private sealed record SortingLuSummary(
        string Key,
        string Code,
        string Couriers,
        decimal ProductsSum,
        int ProductsCount,
        decimal Weight,
        string LastPickingOperator,
        DateTime? LastPickingDate,
        string Zone,
        string OperatorsList);


    private sealed class SortingLuRowView
    {
        public string Key { get; set; } = string.Empty;
        public SortingLuSummary Data { get; set; } = null!;
        public string AnimationClass { get; set; } = string.Empty;
        public bool IsLeaving { get; set; }
    }

    private sealed class SortingOperationRowView
    {
        public string Key { get; set; } = string.Empty;
        public WarehouseOperation Data { get; set; } = null!;
        public string AnimationClass { get; set; } = string.Empty;
        public bool IsLeaving { get; set; }
    }

    [Parameter] public List<WarehouseLu> LusToSort { get; set; } = new();
    [Parameter] public List<WarehouseOperation> RecentOperations { get; set; } = new();
    [Parameter] public DashboardColorConfiguration ColorConfig { get; set; } = new();
    [Parameter] public bool IsLoading { get; set; }

    private List<SortingLuRowView> LuRows { get; set; } = new();
    private List<SortingOperationRowView> RecentOperationRows { get; set; } = new();

    private int LusTotal => LuRows.Count(x => x.Data.Code != null);
    private decimal ProductsSumTotal => LuRows.Sum(x => x.Data.ProductsSum);
    private int ProductsCountTotal => LuRows.Sum(x => x.Data.ProductsCount);
    private decimal WeightTotal => LuRows.Sum(x => x.Data.Weight);

    private int ActiveOperatorsCount => RecentOperations
            .Select(x => x.Operator)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Count();

    private sealed record CourierBreakdownItem(string Name, string LogoSrc, int Count);

    private static readonly Courier[] HighlightedCouriers = { Courier.GLS, Courier.Fedex, Courier.DPD };

    private List<CourierBreakdownItem> CourierBreakdown
    {
        get
        {
            var items = HighlightedCouriers
                .Select(courier => new CourierBreakdownItem(
                    courier.GetDescription(),
                    CourierHelper.GetCourierLogo(null, courier),
                    LusToSort.Count(x => x.Couriers != null && x.Couriers.Contains(courier))))
                .ToList();

            var otherCount = LusToSort.Count(x => x.Couriers == null || !x.Couriers.Any()
                || x.Couriers.Any(c => !HighlightedCouriers.Contains(c)));

            items.Add(new CourierBreakdownItem("Pozostali", string.Empty, otherCount));

            return items;
        }
    }

    private string LongestActiveElapsed => RecentOperationRows.Any()
        ? FormatHelper.FormatElapsed(RecentOperationRows.Min(x => x.Data.Date))
        : "-";

    protected override void OnParametersSet()
    {
        try
        {
            _now = DashboardClock.Now;
        }
        catch
        {
            _now = DateTime.UtcNow;
        }

        SyncDocumentRows();
        SyncRecentOperationRows();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_clockStarted)
        {
            _clockStarted = true;
            _ = StartClockAsync();
        }
    }

    private async Task StartClockAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await timer.WaitForNextTickAsync(_clockCts.Token))
            {
                try { _now = DashboardClock.Now; } catch { _now = DateTime.UtcNow; }
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    private List<SortingLuSummary> BuildLuSummaries()
    {
        return LusToSort
            .Select(lu =>
            {
                var operators = RecentOperations
                    .Where(op => op.SourceLuId == lu.Id)
                    .Select(op => op.Operator)
                    .Where(op => !string.IsNullOrWhiteSpace(op))
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .OrderBy(op => op)
                    .ToList();

                var couriers = lu.Couriers?
                    .Select(c => c.GetDescription())
                    .ToList() ?? [];

                return new SortingLuSummary(
                    lu.Id.ToString(),
                    lu.Code,
                    string.Join(", ", couriers),
                    lu.ProductsSum,
                    lu.ProductsCount,
                    Math.Max(1, lu.Weight),
                    lu.LastOperationOperator ?? "-",
                    lu.LastOperationDate,
                    lu.Zone ?? "-",
                    operators.Any() ? string.Join(", ", operators) : "-"
                );
            })
            .ToList();
    }

    private void SyncDocumentRows()
    {
        var latest = BuildLuSummaries();
        var latestKeys = latest.Select(x => x.Key).ToHashSet(StringComparer.OrdinalIgnoreCase);

        foreach (var item in latest)
        {
            var existing = LuRows.FirstOrDefault(x => string.Equals(x.Key, item.Key, StringComparison.OrdinalIgnoreCase));
            if (existing is null)
            {
                var added = new SortingLuRowView
                {
                    Key = item.Key,
                    Data = item,
                    AnimationClass = "dashboard-row-enter"
                };

                LuRows.Add(added);
                _ = ClearLuEnterClassAsync(added);
            }
            else
            {
                existing.Data = item;
                if (existing.IsLeaving)
                {
                    existing.IsLeaving = false;
                    existing.AnimationClass = "dashboard-row-enter";
                    _ = ClearLuEnterClassAsync(existing);
                }
            }
        }

        foreach (var row in LuRows.Where(x => !x.IsLeaving && !latestKeys.Contains(x.Key)).ToList())
        {
            row.IsLeaving = true;
            row.AnimationClass = "dashboard-row-leave";
            _ = RemoveLuRowAsync(row);
        }

        var orderedActive = latest.Select(x => LuRows.FirstOrDefault(r => string.Equals(r.Key, x.Key, StringComparison.OrdinalIgnoreCase))).Where(r => r is not null)!.ToList();
        var leaving = LuRows.Where(x => x.IsLeaving).ToList();
        LuRows = orderedActive.Concat(leaving).ToList();
    }


    private async Task ClearLuEnterClassAsync(SortingLuRowView row)
    {
        await Task.Delay(RowAnimationDelayMs);
        if (row.IsLeaving)
        {
            return;
        }

        row.AnimationClass = string.Empty;
        await InvokeAsync(StateHasChanged);
    }

    private async Task RemoveLuRowAsync(SortingLuRowView row)
    {
        await Task.Delay(RowAnimationDelayMs);
        if (!row.IsLeaving)
        {
            return;
        }

        LuRows = LuRows.Where(x => !ReferenceEquals(x, row)).ToList();
        await InvokeAsync(StateHasChanged);
    }

    private void SyncRecentOperationRows()
    {
        // Filter out empty operators, group by operator name, and pick the one with the maximum (last) date
        var latest = RecentOperations
            .Where(x => !string.IsNullOrWhiteSpace(x.Operator))
            .GroupBy(x => x.Operator, StringComparer.OrdinalIgnoreCase)
            .Select(g => g.OrderByDescending(op => op.Date).First())
            .OrderByDescending(x => x.Date)
            .ToList();

        var latestKeys = latest.Select(x => x.Operator).ToHashSet(StringComparer.OrdinalIgnoreCase);

        foreach (var item in latest)
        {
            var itemKey = item.Operator; // Key is now based on unique operator identity
            item.Date = FormatHelper.ToLocalTime(item.Date);
            var existing = RecentOperationRows.FirstOrDefault(x => string.Equals(x.Key, itemKey, StringComparison.OrdinalIgnoreCase));
            if (existing is null)
            {
                var added = new SortingOperationRowView
                {
                    Key = itemKey,
                    Data = item,
                    AnimationClass = "dashboard-row-enter"
                };

                RecentOperationRows.Add(added);
                _ = ClearOperationEnterClassAsync(added);
            }
            else
            {
                existing.Data = item;
                if (existing.IsLeaving)
                {
                    existing.IsLeaving = false;
                    existing.AnimationClass = "dashboard-row-enter";
                    _ = ClearOperationEnterClassAsync(existing);
                }
            }
        }

        foreach (var row in RecentOperationRows.Where(x => !x.IsLeaving && !latestKeys.Contains(x.Key)).ToList())
        {
            row.IsLeaving = true;
            row.AnimationClass = "dashboard-row-leave";
            _ = RemoveOperationRowAsync(row);
        }

        var orderedActive = latest.Select(x => RecentOperationRows.FirstOrDefault(r => string.Equals(r.Key, x.Operator, StringComparison.OrdinalIgnoreCase))).Where(r => r is not null)!.ToList();
        var leaving = RecentOperationRows.Where(x => x.IsLeaving).ToList();
        RecentOperationRows = orderedActive.Concat(leaving).ToList();
    }

    private async Task ClearOperationEnterClassAsync(SortingOperationRowView row)
    {
        await Task.Delay(RowAnimationDelayMs);
        if (row.IsLeaving) return;
        row.AnimationClass = string.Empty;
        await InvokeAsync(StateHasChanged);
    }

    private async Task RemoveOperationRowAsync(SortingOperationRowView row)
    {
        await Task.Delay(RowAnimationDelayMs);
        if (!row.IsLeaving) return;
        RecentOperationRows = RecentOperationRows.Where(x => !ReferenceEquals(x, row)).ToList();
        await InvokeAsync(StateHasChanged);
    }

    // --- Metody pomocnicze dla tabeli operacji ---
    private string GetOperationDocument(WarehouseOperation op)
    {
        return LusToSort.FirstOrDefault(d => d.Id == op.DocId)?.Code ?? op.DocId.ToString();
    }

    private string GetOperationOperator(WarehouseOperation op)
    {
        return op.Operator;
    }

    private string GetElapsedBadgeClass(DateTime date)
    {
        var elapsed = _now - date;
        if (elapsed.TotalMinutes > 4) return "bg-danger";
        if (elapsed.TotalMinutes > 2) return "bg-warning text-dark";
        return "bg-success";
    }

    private string GetElapsedRowClass(DateTime date)
    {
        return string.Empty;
    }

    public ValueTask DisposeAsync()
    {
        _clockCts.Cancel();
        _clockCts.Dispose();
        return ValueTask.CompletedTask;
    }
}