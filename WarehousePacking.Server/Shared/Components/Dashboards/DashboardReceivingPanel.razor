@using WarehousePacking.Contracts.DTOs
@using WarehousePacking.Contracts.DTOs.Dashboards
@using WarehousePacking.Contracts.Data.Enums
@using WarehousePacking.Server.Helpers

@implements IAsyncDisposable

<div class="dashboard-receiving-panel h-100 d-flex flex-column">
    <div class="row g-3 mb-3 flex-shrink-0">
        <div class="col-12 col-md-3">
            <DashboardStatCard Title="Dokumenty"
                             Subtitle="Do przyjęcia"
                             Value="@FormatHelper.FormatQuantity(Documents.Count())"
                             IconClass="bi bi-file-earmark-text"
                             AccentClass="dashboard-kpi-primary" />
        </div>
        <div class="col-12 col-md-3">
            <DashboardStatCard Title="Towary"
                             Subtitle="Do przyjęcia"
                             Value="@FormatHelper.FormatQuantity(RemainingQuantityTotal)"
                             IconClass="bi bi-boxes"
                             AccentClass="dashboard-kpi-info" />
        </div>
        <div class="col-12 col-md-3">
            <DashboardStatCard Title="Waga / Objętość"
                             Subtitle="Pozostało"
                             Value="@($"{FormatHelper.FormatQuantity(RemainingWeightTotal, "kg", "F0")} / {FormatHelper.FormatQuantity(RemainingVolumeTotal, "m³")}")"
                             IconClass="bi bi-speedometer2"
                             AccentClass="dashboard-kpi-warning" />
        </div>
        <div class="col-12 col-md-3">
            <DashboardStatCard Title="Operatorzy"
                             Subtitle="Aktywni (5 min)"
                             Value="@FormatHelper.FormatQuantity(ActiveOperatorsCount)"
                             IconClass="bi bi-people"
                             AccentClass="dashboard-kpi-success" />
        </div>
    </div>
    
    <div class="row g-3 dashboard-main-row flex-grow-1">
        <div class="col-12 col-xl-8 flex-grow-1 d-flex flex-column min-vh-0">
            <div class="card shadow-sm flex-grow-1 d-flex flex-column">
                <div class="card-header d-flex justify-content-between align-items-center flex-shrink-0">
                    <span><i class="bi bi-list-check me-2"></i>@DashboardPanel.Receiving.GetDescription() - Dokumenty</span>
                </div>
                <div class="card-body p-0 mb-0 dashboard-scroll-host d-flex flex-column flex-grow-1 min-vh-0">
                    <div class="table-responsive dashboard-auto-scroll dashboard-scroll-fill flex-grow-1 overflow-auto">
                        <table class="table table-striped table-hover mb-0 dashboard-table dashboard-table-auto">
                            <thead class="table-dark" style="position: sticky; top: 0; z-index: 1;">
                                <tr>
                                    <th>Dokument</th>
                                    <th>Status</th>
                                    <th>Il. zreal./Il. całk.</th>
                                    <th>Waga zreal./Waga całk.</th>
                                    <th>Obj. zreal./Obj. całk.</th>
                                    <th>Priorytet</th>
                                    <th>Operatorzy</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!DocumentRows.Any())
                                {
                                    <tr>
                                        <td colspan="6" class="text-center text-muted py-3">
                                            @if (IsLoading)
                                            {
                                                <span>Ładowanie danych...</span>
                                            }
                                            else
                                            {
                                                <span>Brak dokumentów przyjęć.</span>
                                            }
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var row in DocumentRows)
                                    {
                                        <tr class="@row.AnimationClass" @key="row.Key">
                                            <td>@row.Data.Code</td>
                                            <td>@row.Data.StatusName</td>
                                            <td><DashboardAnimatedValue Text="@($"{@FormatHelper.FormatQuantity(row.Data.QuantityReal)} / {FormatHelper.FormatQuantity(row.Data.Quantity)}")" /></td>
                                            <td><DashboardAnimatedValue Text="@($"{FormatHelper.FormatQuantity(row.Data.WeightReal, "", "F0")} / {FormatHelper.FormatQuantity(row.Data.Weight, "kg", "F0")}")" /></td>
                                            <td><DashboardAnimatedValue Text="@($"{FormatHelper.FormatQuantity(row.Data.VolumeReal)} / {FormatHelper.FormatQuantity(row.Data.Volume, "m³")}")" /></td>
                                            <td><DashboardAnimatedValue Text="@row.Data.Priority.ToString()" /></td>
                                            <td class="dashboard-operators-cell" title="@row.Data.OperatorsList">@row.Data.OperatorsList</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-4 d-flex">
            <div class="card shadow-sm h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-person-workspace me-2"></i>Aktywne operacje</span>
                    <span class="small text-muted dashboard-time-text">Najdłużej: <DashboardAnimatedValue Text="@LongestActiveElapsed" CssClass="dashboard-time-text" /></span>
                </div>
                <div class="card-body p-0 mb-0 dashboard-scroll-host">
                    <div class="table-responsive dashboard-auto-scroll dashboard-scroll-fill flex-grow-1">
                        <table class="table table-striped table-hover mb-0 dashboard-table dashboard-table-auto">
                            <thead class="table-dark">
                                <tr>
                                    <th>Dokument</th>
                                    <th>Operator</th>
                                    <th>Od ost. operacji</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!RecentOperationRows.Any())
                                {
                                    <tr>
                                        <td colspan="3" class="text-center text-muted py-3">
                                            @if (IsLoading)
                                            {
                                                <span>Ładowanie danych...</span>
                                            }
                                            else
                                            {
                                                <span>Brak aktywnych operacji (ostatnie 5 min).</span>
                                            }
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var rowState in RecentOperationRows)
                                    {
                                        var row = rowState.Data;
                                        <tr class="@($"{GetElapsedRowClass(row.Date)} {rowState.AnimationClass}".Trim())" @key="rowState.Key">
                                            <td>@GetOperationDocument(row)</td>
                                            <td>@GetOperationOperator(row)</td>
                                            <td class="dashboard-elapsed-cell">
                                                <span class="badge @GetElapsedBadgeClass(row.Date) dashboard-elapsed-badge dashboard-time-text">
                                                    <DashboardAnimatedValue Text="@FormatHelper.FormatElapsed(row.Date)" CssClass="dashboard-time-text" />
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@code {
    private const int RowAnimationDelayMs = 280;
    private readonly CancellationTokenSource _clockCts = new();
    private DateTime _now = DateTime.UtcNow;
    private bool _clockStarted;

    private sealed record ReceivingDocumentSummary(
        string Key,
        string Code,
        string CourierName,
        string CourierSrc,
        string StatusName,
        decimal Quantity,
        decimal Weight,
        decimal Volume,
        decimal QuantityReal,
        decimal WeightReal,
        decimal VolumeReal,
        int Priority,
        string OperatorsList);

    private sealed class ReceivingDocumentRowView
    {
        public string Key { get; set; } = string.Empty;
        public ReceivingDocumentSummary Data { get; set; } = null!;
        public string AnimationClass { get; set; } = string.Empty;
        public bool IsLeaving { get; set; }
    }

    private sealed class ReceivingOperationRowView
    {
        public string Key { get; set; } = string.Empty;
        public WarehouseOperation Data { get; set; } = null!;
        public string AnimationClass { get; set; } = string.Empty;
        public bool IsLeaving { get; set; }
    }

    [Parameter] public List<WarehouseDocument> Documents { get; set; } = new();
    [Parameter] public List<WarehouseOperation> RecentOperations { get; set; } = new();
    [Parameter] public bool IsLoading { get; set; }

    private List<ReceivingDocumentRowView> DocumentRows { get; set; } = new();
    private List<ReceivingOperationRowView> RecentOperationRows { get; set; } = new();

    private decimal RemainingQuantityTotal => DocumentRows.Sum(x => x.Data.Quantity - x.Data.QuantityReal);
    private decimal RemainingWeightTotal => DocumentRows.Sum(x => x.Data.Weight - x.Data.WeightReal);
    private decimal RemainingVolumeTotal => DocumentRows.Sum(x => x.Data.Volume - x.Data.VolumeReal);

    private int ActiveOperatorsCount => RecentOperations
        .Select(x => x.Operator)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Count();
    private string LongestActiveElapsed => RecentOperationRows.Any() ? FormatHelper.FormatElapsed(RecentOperationRows.Min(x => x.Data.Date)) : "-";

    protected override void OnParametersSet()
    {
        if (_now == default)
        {
            _now = DashboardClock.Now;
        }

        SyncDocumentRows();
        SyncRecentOperationRows();
    }

    private List<ReceivingDocumentSummary> BuildDocumentSummaries()
    {
        return Documents
            .Select(doc =>
            {
                var operators = RecentOperations
                    .Where(op => op.DocId == doc.Id)
                    .Select(op => op.Operator)
                    .Where(op => !string.IsNullOrWhiteSpace(op))
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .OrderBy(op => op)
                    .ToList();

                var courierName = doc.Courier == Courier.Unknown ? "Brak" : doc.Courier.GetDescription();
                var courierSrc = CourierHelper.GetCourierLogo(new ShipmentServices(), doc.Courier);

                return new ReceivingDocumentSummary(
                    doc.Id.ToString(),
                    doc.Code,
                    courierName,
                    courierSrc,
                    doc.Status.GetDescription(),
                    Math.Max(0m, doc.Quantity),
                    Math.Max(0m, doc.Weight),
                    Math.Max(0m, doc.Volume),
                    Math.Max(0m, doc.QuantityRealized),
                    Math.Max(0m, doc.WeightRealized),
                    Math.Max(0m, doc.VolumeRealized),
                    doc.Priority,
                    operators.Any() ? string.Join(", ", operators) : "-"
                );
            })
            .ToList();
    }

    private void SyncDocumentRows()
    {
        var latest = BuildDocumentSummaries();
        var latestKeys = latest.Select(x => x.Key).ToHashSet(StringComparer.OrdinalIgnoreCase);

        foreach (var item in latest)
        {
            var existing = DocumentRows.FirstOrDefault(x => string.Equals(x.Key, item.Key, StringComparison.OrdinalIgnoreCase));
            if (existing is null)
            {
                var added = new ReceivingDocumentRowView
                {
                    Key = item.Key,
                    Data = item,
                    AnimationClass = "dashboard-row-enter"
                };

                DocumentRows.Add(added);
                _ = ClearDocumentEnterClassAsync(added);
            }
            else
            {
                existing.Data = item;
                if (existing.IsLeaving)
                {
                    existing.IsLeaving = false;
                    existing.AnimationClass = "dashboard-row-enter";
                    _ = ClearDocumentEnterClassAsync(existing);
                }
            }
        }

        foreach (var row in DocumentRows.Where(x => !x.IsLeaving && !latestKeys.Contains(x.Key)).ToList())
        {
            row.IsLeaving = true;
            row.AnimationClass = "dashboard-row-leave";
            _ = RemoveDocumentRowAsync(row);
        }

        var orderedActive = latest.Select(x => DocumentRows.First(r => string.Equals(r.Key, x.Key, StringComparison.OrdinalIgnoreCase))).ToList();
        var leaving = DocumentRows.Where(x => x.IsLeaving).ToList();
        DocumentRows = orderedActive.Concat(leaving).ToList();
    }

    private void SyncRecentOperationRows()
    {
        var latest = RecentOperations
            .GroupBy(GetOperationKey, StringComparer.OrdinalIgnoreCase)
            .Select(group => group.OrderByDescending(x => x.Date).First())
            .OrderBy(x => x.Date)
            .ToList();

        var latestKeys = latest.Select(GetOperationKey).ToHashSet(StringComparer.OrdinalIgnoreCase);

        foreach (var item in latest)
        {
            var itemKey = GetOperationKey(item);
            var existing = RecentOperationRows.FirstOrDefault(x => string.Equals(x.Key, itemKey, StringComparison.OrdinalIgnoreCase));
            if (existing is null)
            {
                var added = new ReceivingOperationRowView
                {
                    Key = itemKey,
                    Data = item,
                    AnimationClass = "dashboard-row-enter"
                };

                RecentOperationRows.Add(added);
                _ = ClearOperationEnterClassAsync(added);
            }
            else
            {
                existing.Data = item;
                if (existing.IsLeaving)
                {
                    existing.IsLeaving = false;
                    existing.AnimationClass = "dashboard-row-enter";
                    _ = ClearOperationEnterClassAsync(existing);
                }
            }
        }

        foreach (var row in RecentOperationRows.Where(x => !x.IsLeaving && !latestKeys.Contains(x.Key)).ToList())
        {
            row.IsLeaving = true;
            row.AnimationClass = "dashboard-row-leave";
            _ = RemoveOperationRowAsync(row);
        }

        var orderedActive = latest.Select(x => RecentOperationRows.First(r => string.Equals(r.Key, GetOperationKey(x), StringComparison.OrdinalIgnoreCase))).ToList();
        var leaving = RecentOperationRows.Where(x => x.IsLeaving).ToList();
        RecentOperationRows = orderedActive.Concat(leaving).ToList();
    }

    private async Task ClearDocumentEnterClassAsync(ReceivingDocumentRowView row)
    {
        await Task.Delay(RowAnimationDelayMs);
        if (row.IsLeaving)
        {
            return;
        }

        row.AnimationClass = string.Empty;
        await InvokeAsync(StateHasChanged);
    }

    private async Task RemoveDocumentRowAsync(ReceivingDocumentRowView row)
    {
        await Task.Delay(RowAnimationDelayMs);
        if (!row.IsLeaving)
        {
            return;
        }

        DocumentRows = DocumentRows.Where(x => !ReferenceEquals(x, row)).ToList();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ClearOperationEnterClassAsync(ReceivingOperationRowView row)
    {
        await Task.Delay(RowAnimationDelayMs);
        if (row.IsLeaving)
        {
            return;
        }

        row.AnimationClass = string.Empty;
        await InvokeAsync(StateHasChanged);
    }

    private async Task RemoveOperationRowAsync(ReceivingOperationRowView row)
    {
        await Task.Delay(RowAnimationDelayMs);
        if (!row.IsLeaving)
        {
            return;
        }

        RecentOperationRows = RecentOperationRows.Where(x => !ReferenceEquals(x, row)).ToList();
        await InvokeAsync(StateHasChanged);
    }

    private string GetElapsedBadgeClass(DateTime start)
    {
        var elapsed = _now - FormatHelper.ToLocalTime(start);

        if (elapsed.TotalMinutes >= 45)
        {
            return "text-bg-danger";
        }

        if (elapsed.TotalMinutes >= 20)
        {
            return "text-bg-warning";
        }

        return "text-bg-success";
    }

    private string GetElapsedRowClass(DateTime start)
    {
        var elapsed = _now - FormatHelper.ToLocalTime(start);

        if (elapsed.TotalMinutes >= 45)
        {
            return "table-danger";
        }

        if (elapsed.TotalMinutes >= 20)
        {
            return "table-warning";
        }

        return string.Empty;
    }

    private static string GetOperationKey(WarehouseOperation operation)
    {
        return string.IsNullOrWhiteSpace(operation.Operator)
            ? $"id:{operation.Id}"
            : operation.Operator;
    }

    private static string GetOperationDocument(WarehouseOperation operation)
    {
        return string.IsNullOrWhiteSpace(operation.DocumentCode) ? operation.DocId.ToString() : operation.DocumentCode;
    }

    private static string GetOperationOperator(WarehouseOperation operation)
    {
        return string.IsNullOrWhiteSpace(operation.Operator) ? "-" : operation.Operator;
    }

    private async Task RunClockAsync(CancellationToken token)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
            while (await timer.WaitForNextTickAsync(token))
            {
                _now = DateTime.UtcNow;
                SyncRecentOperationRows();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    public ValueTask DisposeAsync()
    {
        _clockCts.Cancel();
        _clockCts.Dispose();
        return ValueTask.CompletedTask;
    }
}
