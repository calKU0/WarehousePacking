@using WarehousePacking.Contracts.DTOs
@using WarehousePacking.Contracts.DTOs.Dashboards
@using WarehousePacking.Contracts.Data.Enums
@using WarehousePacking.Server.Helpers

@implements IAsyncDisposable

<div class="dashboard-loading-panel h-100 d-flex flex-column">
    <div class="row g-3 mb-3 flex-shrink-0">
        <div class="col-12 col-md-3">
            <DashboardStatCard Title="Jl / Towary"
                             Subtitle="Do załadowania"
                             Value="@($"{FormatHelper.FormatQuantity(LusTotal)} / {FormatHelper.FormatQuantity(ProductsCountTotal)}")"
                             IconClass="bi bi-file-earmark-text"
                             AccentClass="dashboard-kpi-primary" />
        </div>
        <div class="col-12 col-md-3">
            <DashboardStatCard Title="Paczki / Palety"
                             Subtitle="Do załadowania"
                             Value="@($"{FormatHelper.FormatQuantity(ParcelsCount)} / {FormatHelper.FormatQuantity(PaletsCount)}")"
                             IconClass="bi bi-file-earmark-text"
                             AccentClass="dashboard-kpi-primary" />
        </div>
        <div class="col-12 col-md-3">
            <DashboardStatCard Title="Waga"
                             Subtitle="Pozostało"
                             Value="@($"{FormatHelper.FormatQuantity(WeightTotal, "kg", "F0")}")"
                             IconClass="bi bi-speedometer2"
                             AccentClass="dashboard-kpi-warning" />
        </div>
        <div class="col-12 col-md-3">
            <DashboardStatCard Title="Operatorzy"
                             Subtitle="Aktywni (5 min)"
                             Value="@FormatHelper.FormatQuantity(ActiveOperatorsCount)"
                             IconClass="bi bi-people"
                             AccentClass="dashboard-kpi-success" />
        </div>
    </div>
    
    <div class="row g-3 dashboard-main-row flex-grow-1">
        <div class="col-12 col-xl-6 d-flex">
            <div class="card shadow-sm h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-truck me-2"></i>@DashboardPanel.Loading.GetDescription() - Kurierzy</span>
                </div>
                <div class="card-body p-0 mb-0 dashboard-scroll-host">
                    <div class="table-responsive dashboard-auto-scroll dashboard-scroll-fill flex-grow-1">
                        <table class="table table-striped table-hover mb-0 dashboard-table dashboard-table-auto">
                            <thead class="table-dark">
                                <tr>
                                    <th>Kurier</th>
                                    <th>Ilość jl</th>
                                    <th>Towary (Il.)</th>
                                    <th>Waga</th>
                                    <th>Operatorzy</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!CourierRows.Any())
                                {
                                    <tr>
                                        <td colspan="6" class="text-center text-muted py-3">
                                            @if (IsLoading)
                                            {
                                                <span>Ładowanie danych...</span>
                                            }
                                            else
                                            {
                                                <span>Brak danych załadunku.</span>
                                            }
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var row in CourierRows)
                                    {
                                        <tr class="@row.AnimationClass" @key="row.Key">
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    @if (!string.IsNullOrWhiteSpace(row.Data.CourierSrc))
                                                    {
                                                        <img src="@row.Data.CourierSrc" alt="@row.Data.CourierName" style="max-height: 48px; max-width: 60px; object-fit: contain;" />
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-truck text-muted fs-5"></i>
                                                    }
                                                    <span>@row.Data.CourierName</span>
                                                </div>
                                            </td>
                                            <td><DashboardAnimatedValue Text="@row.Data.LusCount.ToString()" /></td>
                                            <td><DashboardAnimatedValue Text="@($"{FormatHelper.FormatQuantity(row.Data.ProductsCount)} ({FormatHelper.FormatQuantity(row.Data.ProductsSum, format: "F0")})")" /></td>
                                            <td><DashboardAnimatedValue Text="@FormatHelper.FormatQuantity(row.Data.Weight, "kg", "F0")" /></td>
                                            <td class="dashboard-operators-cell" title="@row.Data.OperatorsList">@row.Data.OperatorsList</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-6 d-flex">
            <div class="card shadow-sm h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-list-check me-2"></i>@DashboardPanel.Loading.GetDescription() - Jl</span>
                </div>
                <div class="card-body p-0 mb-0 dashboard-scroll-host">
                    <div class="table-responsive dashboard-auto-scroll dashboard-scroll-fill flex-grow-1">
                        <table class="table table-striped table-hover mb-0 dashboard-table dashboard-table-auto">
                            <thead class="table-dark">
                                <tr>
                                    <th>Jl</th>
                                    <th>Kurier</th>
                                    <th>Towary (Il.)</th>
                                    <th>Waga</th>
                                    <th>Data pak.</th>
                                    <th>Operatorzy</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!LuRows.Any())
                                {
                                    <tr>
                                        <td colspan="7" class="text-center text-muted py-3">
                                            @if (IsLoading)
                                            {
                                                <span>Ładowanie danych...</span>
                                            }
                                            else
                                            {
                                                <span>Brak dokumentów załadunku.</span>
                                            }
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var row in LuRows)
                                    {
                                        <tr class="@row.AnimationClass" @key="row.Key">
                                            <td>@row.Data.Code</td>
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    @if (!string.IsNullOrWhiteSpace(row.Data.CourierSrc))
                                                    {
                                                        <img src="@row.Data.CourierSrc" alt="@row.Data.CourierName" style="max-height: 48px; max-width: 60px; object-fit: contain;" />
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-truck text-muted"></i>
                                                    }
                                                    <span>@row.Data.CourierName</span>
                                                </div>
                                            </td>
                                            <td><DashboardAnimatedValue Text="@($"{FormatHelper.FormatQuantity(row.Data.ProductsCount)} ({FormatHelper.FormatQuantity(row.Data.ProductsSum, format: "F0")})")" /></td>
                                            <td><DashboardAnimatedValue Text="@FormatHelper.FormatQuantity(row.Data.Weight, "kg", "F0")" /></td>
                                            <td>@(row.Data.LastPackingDate == null || row.Data.LastPackingDate == DateTime.MinValue ? "-" : row.Data.LastPackingDate.Value.ToString("yyyy-MM-dd HH:mm"))</td>
                                            <td class="dashboard-operators-cell" title="@row.Data.OperatorsList">@row.Data.OperatorsList</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@code {
    private const int RowAnimationDelayMs = 280;

    private sealed record LoadingCourierSummary(
        Courier Courier,
        string CourierName,
        string CourierSrc,
        int LusCount,
        decimal ProductsSum,
        int ProductsCount,
        decimal Weight,
        int OperatorsCount,
        string OperatorsList);

    private sealed class LoadingRowView
    {
        public string Key { get; set; } = string.Empty;
        public LoadingCourierSummary Data { get; set; } = null!;
        public string AnimationClass { get; set; } = string.Empty;
        public bool IsLeaving { get; set; }
    }

    private sealed record LoadingLuSummary(
        string Key,
        string Code,
        string CourierName,
        string CourierSrc,
        decimal ProductsSum,
        int ProductsCount,
        decimal Weight,
        string LastPackingOperator,
        DateTime? LastPackingDate,
        string OperatorsList);

    private sealed class LoadingLuRowView
    {
        public string Key { get; set; } = string.Empty;
        public LoadingLuSummary Data { get; set; } = null!;
        public string AnimationClass { get; set; } = string.Empty;
        public bool IsLeaving { get; set; }
    }

    [Parameter] public List<WarehouseLu> LusToLoad { get; set; } = new();
    [Parameter] public List<WarehouseOperation> RecentOperations { get; set; } = new();
    [Parameter] public DashboardColorConfiguration ColorConfig { get; set; } = new();
    [Parameter] public bool IsLoading { get; set; }

    private List<LoadingRowView> CourierRows { get; set; } = new();
    private List<LoadingLuRowView> LuRows { get; set; } = new();

    private int LusTotal => LuRows.Count(x => x.Data.Code != null);
    private decimal ProductsSumTotal => LuRows.Sum(x => x.Data.ProductsSum);
    private int ProductsCountTotal => LuRows.Sum(x => x.Data.ProductsCount);
    private decimal WeightTotal => LuRows.Sum(x => x.Data.Weight);
    private int PaletsCount => LusToLoad.Count(p => p.Weight >= 30);
    private int ParcelsCount => LusToLoad.Count(p => p.Weight < 30);

    private int ActiveOperatorsCount => RecentOperations
        .Select(x => x.Operator)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Count();

    protected override void OnParametersSet()
    {
        SyncRows();
        SyncLuRows();
    }

    private void SyncRows()
    {
        var latest = BuildSummaries();
        var latestKeys = latest.Select(GetRowKey).ToHashSet(StringComparer.OrdinalIgnoreCase);

        foreach (var item in latest)
        {
            var itemKey = GetRowKey(item);
            var existing = CourierRows.FirstOrDefault(x => string.Equals(x.Key, itemKey, StringComparison.OrdinalIgnoreCase));
            if (existing is null)
            {
                var added = new LoadingRowView
                {
                    Key = itemKey,
                    Data = item,
                    AnimationClass = "dashboard-row-enter"
                };

                CourierRows.Add(added);
                _ = ClearEnterClassAsync(added);
            }
            else
            {
                existing.Data = item;
                if (existing.IsLeaving)
                {
                    existing.IsLeaving = false;
                    existing.AnimationClass = "dashboard-row-enter";
                    _ = ClearEnterClassAsync(existing);
                }
            }
        }

        foreach (var row in CourierRows.Where(x => !x.IsLeaving && !latestKeys.Contains(x.Key)).ToList())
        {
            row.IsLeaving = true;
            row.AnimationClass = "dashboard-row-leave";
            _ = RemoveRowAsync(row);
        }

        var orderedActive = latest.Select(x => CourierRows.First(r => string.Equals(r.Key, GetRowKey(x), StringComparison.OrdinalIgnoreCase))).ToList();
        var leaving = CourierRows.Where(x => x.IsLeaving).ToList();
        CourierRows = orderedActive.Concat(leaving).ToList();
    }

    private List<LoadingCourierSummary> BuildSummaries()
    {
        return LusToLoad
            .GroupBy(x => x.Couriers?.FirstOrDefault() ?? Courier.Unknown)
            .Select(group =>
            {
                var lus = group.ToList();
                var operators = RecentOperations
                    .Where(op => lus.Any(lu => op.SourceLuId == lu.Id))
                    .Select(op => op.Operator)
                    .Where(op => !string.IsNullOrWhiteSpace(op))
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .OrderBy(op => op)
                    .ToList();

                var courierName = group.Key == Courier.Unknown ? "Brak" : group.Key.GetDescription();
                var courierSrc = CourierHelper.GetCourierLogo(new ShipmentServices(), group.Key);

                return new LoadingCourierSummary(
                    group.Key,
                    courierName,
                    courierSrc,
                    lus.Count,
                    lus.Sum(x => x.ProductsSum),
                    lus.Sum(x => x.ProductsCount),
                    lus.Sum(x => x.Weight),
                    operators.Count,
                    operators.Any() ? string.Join(", ", operators) : "-"
                );
            })
            .OrderByDescending(x => x.Weight)
            .ToList();
    }

    private static string GetRowKey(LoadingCourierSummary row)
    {
        return row.Courier.ToString();
    }

    private List<LoadingLuSummary> BuildLuSummaries()
    {
        return LusToLoad
            .Select(lu =>
            {
                var operators = RecentOperations
                       .Where(op => op.SourceLuId == lu.Id)
                       .Select(op => op.Operator)
                       .Where(op => !string.IsNullOrWhiteSpace(op))
                       .Distinct(StringComparer.OrdinalIgnoreCase)
                       .OrderBy(op => op)
                       .ToList();

                var courierName = lu.Couriers?.FirstOrDefault() == Courier.Unknown ? "Brak" : lu.Couriers?.FirstOrDefault().GetDescription();
                var courierSrc = CourierHelper.GetCourierLogo(new ShipmentServices(), lu.Couriers?.FirstOrDefault());

                return new LoadingLuSummary(
                    lu.Id.ToString(),
                    lu.Code,
                    courierName,
                    courierSrc,
                    lu.ProductsSum,
                    lu.ProductsCount,
                    Math.Max(1, lu.Weight),
                    lu.LastOperationOperator ?? "-",
                    lu.LastOperationDate,
                    operators.Any() ? string.Join(", ", operators) : "-"
                );
            })
            .ToList();
    }

    private void SyncLuRows()
    {
        var latest = BuildLuSummaries();
        var latestKeys = latest.Select(x => x.Key).ToHashSet(StringComparer.OrdinalIgnoreCase);

        foreach (var item in latest)
        {
            var existing = LuRows.FirstOrDefault(x => string.Equals(x.Key, item.Key, StringComparison.OrdinalIgnoreCase));
            if (existing is null)
            {
                var added = new LoadingLuRowView
                {
                    Key = item.Key,
                    Data = item,
                    AnimationClass = "dashboard-row-enter"
                };

                LuRows.Add(added);
                _ = ClearLuEnterClassAsync(added);
            }
            else
            {
                existing.Data = item;
                if (existing.IsLeaving)
                {
                    existing.IsLeaving = false;
                    existing.AnimationClass = "dashboard-row-enter";
                    _ = ClearLuEnterClassAsync(existing);
                }
            }
        }

        foreach (var row in LuRows.Where(x => !x.IsLeaving && !latestKeys.Contains(x.Key)).ToList())
        {
            row.IsLeaving = true;
            row.AnimationClass = "dashboard-row-leave";
            _ = RemoveLuRowAsync(row);
        }

        var orderedActive = latest.Select(x => LuRows.First(r => string.Equals(r.Key, x.Key, StringComparison.OrdinalIgnoreCase))).ToList();
        var leaving = LuRows.Where(x => x.IsLeaving).ToList();
        LuRows = orderedActive.Concat(leaving).ToList();
    }

    private async Task ClearLuEnterClassAsync(LoadingLuRowView row)
    {
        await Task.Delay(RowAnimationDelayMs);
        if (row.IsLeaving)
        {
            return;
        }

        row.AnimationClass = string.Empty;
        await InvokeAsync(StateHasChanged);
    }

    private async Task RemoveLuRowAsync(LoadingLuRowView row)
    {
        await Task.Delay(RowAnimationDelayMs);
        if (!row.IsLeaving)
        {
            return;
        }

        LuRows = LuRows.Where(x => !ReferenceEquals(x, row)).ToList();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ClearEnterClassAsync(LoadingRowView row)
    {
        await Task.Delay(RowAnimationDelayMs);
        if (row.IsLeaving)
        {
            return;
        }

        row.AnimationClass = string.Empty;
        await InvokeAsync(StateHasChanged);
    }

    private async Task RemoveRowAsync(LoadingRowView row)
    {
        await Task.Delay(RowAnimationDelayMs);
        if (!row.IsLeaving)
        {
            return;
        }

        CourierRows = CourierRows.Where(x => !ReferenceEquals(x, row)).ToList();
        await InvokeAsync(StateHasChanged);
    }

    public ValueTask DisposeAsync()
    {
        return ValueTask.CompletedTask;
    }
}
