@using WarehousePacking.Contracts.DTOs
@using WarehousePacking.Contracts.DTOs.Dashboards
@using WarehousePacking.Contracts.Data.Enums
@using WarehousePacking.Server.Helpers
@using DashboardClockHelper = WarehousePacking.Server.Helpers.DashboardClock
@using WarehousePacking.Server.Shared.Components.Dashboard

@implements IAsyncDisposable

<div class="dashboard-packing-panel h-100 d-flex flex-column">
    <div class="row g-3 mb-3">
        <div class="col-12 col-md-3">
            <DashboardStatCard Title="Jl / Towary"
                               Subtitle="Do spakowania"
                               Value="@($"{FormatHelper.FormatQuantity(PackingDocumentsCount)} / {FormatHelper.FormatQuantity(PackingElementsTotal)}")"
                               IconClass="bi bi-box-seam"
                               AccentClass="dashboard-kpi-primary" />
        </div>
        <div class="col-12 col-md-3">
            <DashboardStatCard Title="Waga"
                               Subtitle="Do spakowania"
                               Value="@FormatHelper.FormatQuantity(PackingWeightRoundedTotal, "kg", "F0")"
                               IconClass="bi bi-speedometer2"
                               AccentClass="dashboard-kpi-info" />
        </div>
        <div class="col-12 col-md-3">
            <DashboardStatCard Title="Jl"
                               Subtitle="Aktualnie pakowane"
                               Value="@FormatHelper.FormatQuantity(PackingInProgressCount)"
                               IconClass="bi bi-inboxes"
                               AccentClass="dashboard-kpi-warning" />
        </div>
        <div class="col-12 col-md-3">
            <DashboardStatCard Title="Operatorzy"
                               Subtitle="Aktualnie pakujący"
                               Value="@FormatHelper.FormatQuantity(PackingOperatorsCount)"
                               IconClass="bi bi-people"
                               AccentClass="dashboard-kpi-success" />
        </div>
    </div>

    <div class="row g-3 dashboard-main-row flex-grow-1">
        <div class="col-12 col-xl-6 d-flex">
            <div class="card shadow-sm h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-truck me-2"></i>Do spakowania</span>
                </div>
                <div class="card-body p-2 d-flex flex-column gap-2 dashboard-courier-body dashboard-auto-scroll">
                    <DashboardCourierSegmentTable Sections="GetCourierSections()"
                                                IsLoading="IsLoading" />
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-6 d-flex min-width-0">
            <div class="card shadow-sm h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-person-workspace me-2"></i>Pakowane</span>
                    <span class="small text-muted dashboard-time-text">Najdłużej: <DashboardAnimatedValue Text="@LongestActiveElapsed" CssClass="dashboard-time-text" Animate="false" /></span>
                </div>
                <div class="card-body p-0 mb-0 dashboard-scroll-host">
                    <div class="table-responsive dashboard-auto-scroll dashboard-scroll-fill flex-grow-1">
                        <table class="table table-striped table-hover mb-0 dashboard-table dashboard-table-auto">
                            <colgroup>
                                <col class="packing-col-jl" />
                                <col class="packing-col-operator" />
                                <col class="packing-col-courier" />
                                <col class="packing-col-client" />
                                <col class="packing-col-station" />
                                <col class="packing-col-elapsed" />
                                <col class="packing-col-elapsed" />
                            </colgroup>
                            <thead class="table-dark">
                                <tr>
                                    <th>Jl</th>
                                    <th>Operator</th>
                                    <th>Kurier</th>
                                    <th>Klient</th>
                                    <th>Stan.</th>
                                    <th>Od podjęcia</th>
                                    <th>Od ost. skanu</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!InProgressRows.Any())
                                {
                                    <tr>
                                        <td colspan="7" class="text-center text-muted py-3">
                                            @if (IsLoading)
                                            {
                                                <span>Ładowanie danych...</span>
                                            }
                                            else
                                            {
                                                <span>Brak aktywnego pakowania.</span>
                                            }
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var rowState in InProgressRows)
                                    {
                                        var row = rowState.Data;
                                                                                     
                                        var isDownStation = rowState.Data.StationNumber.Substring(1, 1) == "2";

                                        var packingTimeRedThreshold = isDownStation
                                            ? ColorConfig.PackingDownPackingTimeRedThreshold
                                            : ColorConfig.PackingUpPackingTimeRedThreshold;

                                        var packingTimeYellowThreshold = isDownStation
                                            ? ColorConfig.PackingDownPackingTimeYellowThreshold
                                            : ColorConfig.PackingUpPackingTimeYellowThreshold;
                                                
                                        <tr class="@($"{ElapsedClassHelper.GetRowClass(row.Date, packingTimeRedThreshold, packingTimeYellowThreshold)} {rowState.AnimationClass}".Trim())" @key="rowState.Key">
                                            <td>
                                                <span class="d-inline-block text-truncate"
                                                      style="max-width: 100px;"
                                                      title="@row.Name">
                                                    @row.Name
                                                </span>
                                            </td>
                                            <td>@row.User</td>
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    @if (!string.IsNullOrEmpty(row.CourierSrc))
                                                    {
                                                        <img src="@row.CourierSrc" alt="@row.Courier" style="max-height: 48px; max-width: 60px; object-fit: contain;" />
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-truck text-muted fs-5"></i>
                                                    }
                                                    <span class="d-inline-block text-truncate"
                                                          style="max-width: 110px;"
                                                          title="@row.Courier.GetDescription()">
                                                        @row.Courier.GetDescription()
                                                    </span>
                                                </div>
                                            </td>
                                            <td>@row.ClientName</td>
                                            <td>@row.StationNumber</td>
                                            <td class="dashboard-elapsed-cell">
                                                <span class="badge @ElapsedClassHelper.GetBadgeClass(row.Date, packingTimeRedThreshold, packingTimeYellowThreshold) dashboard-elapsed-badge dashboard-time-text">
                                                    <DashboardAnimatedValue Text="@FormatHelper.FormatElapsed(row.Date)" CssClass="dashboard-time-text" Animate="false" />
                                                </span>
                                            </td>
                                            <td class="dashboard-elapsed-cell">
                                                <span class="badge @ElapsedClassHelper.GetBadgeClass(row.LastScanDate, ColorConfig.OperatorLastActivityRedThresholdMinutes, ColorConfig.OperatorLastActivityYellowThresholdMinutes) dashboard-elapsed-badge dashboard-time-text">
                                                    <DashboardAnimatedValue Text="@FormatHelper.FormatElapsed(row.LastScanDate)" CssClass="dashboard-time-text" Animate="false" />
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private const int RowAnimationDelayMs = 280;
    private DateTime _now;

    private enum CourierSegment
    {
        WarehouseAUp,
        WarehouseADown,
        WarehouseBDown
    }

    private sealed record CourierPackingSummary(CourierSegment Segment, Courier Courier, string CourierName, string CourierSrc, int Jls, decimal Weight, decimal Quantity);

    private sealed class CourierRowView
    {
        public string Key { get; set; } = string.Empty;
        public CourierPackingSummary Data { get; set; } = null!;
        public string AnimationClass { get; set; } = string.Empty;
        public bool IsLeaving { get; set; }
    }

    private sealed class InProgressRowView
    {
        public string Key { get; set; } = string.Empty;
        public JlInProgressDto Data { get; set; } = null!;
        public string AnimationClass { get; set; } = string.Empty;
        public bool IsLeaving { get; set; }
    }

    [Parameter] public List<JlData> Queue { get; set; } = new();
    [Parameter] public List<JlInProgressDto> InProgress { get; set; } = new();
    [Parameter] public DashboardColorConfiguration ColorConfig { get; set; } = new();
    [Parameter] public bool IsLoading { get; set; }

    private List<CourierRowView> CourierRows { get; set; } = new();
    private List<InProgressRowView> InProgressRows { get; set; } = new();
    private int PackingElementsTotal => Convert.ToInt32(Math.Round(Queue.Sum(x => x.Quantity)));

    private Dictionary<CourierSegment, int> SegmentTotals => Queue
        .Select(ResolveCourierSegment)
        .Where(x => x.HasValue)
        .GroupBy(x => x!.Value)
        .ToDictionary(g => g.Key, g => g.Count());

    private List<CourierPackingSummary> PackingByCourier => Queue
        .Select(x => new
        {
            Segment = ResolveCourierSegment(x),
            Courier = x.Courier,
            CourierName = x.Courier.GetDescription(),
            CourierSrc = CourierHelper.GetCourierLogo(null, x.Courier),
            Weight = x.Weight,
            Quantity = x.Quantity
        })
        .Where(x => x.Segment.HasValue)
        .GroupBy(x => new { Segment = x.Segment!.Value, x.Courier, x.CourierName })
        .Select(g => new CourierPackingSummary(
            g.Key.Segment,
            g.Key.Courier,
            g.Key.CourierName,
            g.Select(x => x.CourierSrc).FirstOrDefault(x => !string.IsNullOrWhiteSpace(x)) ?? string.Empty,
            g.Count(),
            g.Sum(x => x.Weight),
            g.Sum(x => x.Quantity)))
        .OrderByDescending(x => GetCourierShare(x.Segment, x.Jls))
        .ThenBy(x => x.CourierName)
        .ToList();

    private int PackingOperatorsCount => InProgress
        .Select(x => x.User)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Count();

    private int PackingDocumentsCount => Queue.Count;
    private int PackingWeightRoundedTotal => (int)Math.Round(Queue.Sum(x => x.Weight));
    private int PackingInProgressCount => InProgress.Count;
    private string LongestActiveElapsed => InProgressRows.Any() ? FormatHelper.FormatElapsed(InProgressRows.Min(x => x.Data.Date)) : "-";

    protected override void OnParametersSet()
    {
        if (_now == default)
        {
            _now = DashboardClock.Now;
        }

        SyncCourierRows();
        SyncInProgressRows();
    }

    private void SyncCourierRows()
    {
        var latest = PackingByCourier;
        var latestKeys = latest.Select(GetCourierRowKey).ToHashSet(StringComparer.OrdinalIgnoreCase);

        foreach (var item in latest)
        {
            var itemKey = GetCourierRowKey(item);
            var existing = CourierRows.FirstOrDefault(x => string.Equals(x.Key, itemKey, StringComparison.OrdinalIgnoreCase));
            if (existing is null)
            {
                var added = new CourierRowView
                {
                    Key = itemKey,
                    Data = item,
                    AnimationClass = "dashboard-row-enter"
                };

                CourierRows.Add(added);
                _ = ClearCourierEnterClassAsync(added);
            }
            else
            {
                existing.Data = item;
                if (existing.IsLeaving)
                {
                    existing.IsLeaving = false;
                    existing.AnimationClass = "dashboard-row-enter";
                    _ = ClearCourierEnterClassAsync(existing);
                }
            }
        }

        foreach (var row in CourierRows.Where(x => !x.IsLeaving && !latestKeys.Contains(x.Key)).ToList())
        {
            row.IsLeaving = true;
            row.AnimationClass = "dashboard-row-leave";
            _ = RemoveCourierRowAsync(row);
        }

        var orderedActive = latest.Select(x => CourierRows.FirstOrDefault(r => string.Equals(r.Key, GetCourierRowKey(x), StringComparison.OrdinalIgnoreCase))).Where(r => r is not null)!.ToList();
        var leaving = CourierRows.Where(x => x.IsLeaving).ToList();
        CourierRows = orderedActive.Concat(leaving).ToList();
    }

    private static string GetCourierRowKey(CourierPackingSummary row)
    {
        return $"{row.Segment}|{row.Courier}";
    }

    private void SyncInProgressRows()
    {
        var latest = InProgress.Select(x => new JlInProgressDto
        {
            ClientName = x.ClientName,
            Courier = x.Courier,
            CourierSrc = CourierHelper.GetCourierLogo(new ShipmentServices(), x.Courier),
            LastScanDate = DateTime.SpecifyKind(x.LastScanDate, DateTimeKind.Local),
            PackageId = x.PackageId,
            StationNumber = x.StationNumber,
            Date = DateTime.SpecifyKind(x.Date, DateTimeKind.Local),
            Name = x.Name,
            User = x.User
        }).OrderBy(x => x.Date).ToList();

        var latestKeys = latest.Select(GetInProgressKey).ToHashSet(StringComparer.OrdinalIgnoreCase);

        foreach (var item in latest)
        {
            var key = GetInProgressKey(item);
            var existing = InProgressRows.FirstOrDefault(x => string.Equals(x.Key, key, StringComparison.OrdinalIgnoreCase));
            if (existing is null)
            {
                var added = new InProgressRowView
                {
                    Key = key,
                    Data = item,
                    AnimationClass = "dashboard-row-enter"
                };

                InProgressRows.Add(added);
                _ = ClearInProgressEnterClassAsync(added);
            }
            else
            {
                existing.Data = item;
                if (existing.IsLeaving)
                {
                    existing.IsLeaving = false;
                    existing.AnimationClass = "dashboard-row-enter";
                    _ = ClearInProgressEnterClassAsync(existing);
                }
            }
        }

        foreach (var row in InProgressRows.Where(x => !x.IsLeaving && !latestKeys.Contains(x.Key)).ToList())
        {
            row.IsLeaving = true;
            row.AnimationClass = "dashboard-row-leave";
            _ = RemoveInProgressRowAsync(row);
        }

        var orderedActive = latest.Select(x => InProgressRows.FirstOrDefault(r => string.Equals(r.Key, GetInProgressKey(x), StringComparison.OrdinalIgnoreCase))).Where(r => r is not null)!.ToList();
        var leaving = InProgressRows.Where(x => x.IsLeaving).ToList();
        InProgressRows = orderedActive.Concat(leaving).ToList();
    }

    private static string GetInProgressKey(JlInProgressDto row)
    {
        return $"{row.Name}|{row.User}|{row.StationNumber}";
    }

    private async Task ClearCourierEnterClassAsync(CourierRowView row)
    {
        await Task.Delay(RowAnimationDelayMs);
        if (row.IsLeaving)
        {
            return;
        }

        row.AnimationClass = string.Empty;
        await InvokeAsync(StateHasChanged);
    }

    private async Task RemoveCourierRowAsync(CourierRowView row)
    {
        await Task.Delay(RowAnimationDelayMs);
        if (!row.IsLeaving)
        {
            return;
        }

        CourierRows = CourierRows.Where(x => !ReferenceEquals(x, row)).ToList();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ClearInProgressEnterClassAsync(InProgressRowView row)
    {
        await Task.Delay(RowAnimationDelayMs);
        if (row.IsLeaving)
        {
            return;
        }

        row.AnimationClass = string.Empty;
        await InvokeAsync(StateHasChanged);
    }

    private async Task RemoveInProgressRowAsync(InProgressRowView row)
    {
        await Task.Delay(RowAnimationDelayMs);
        if (!row.IsLeaving)
        {
            return;
        }

        InProgressRows = InProgressRows.Where(x => !ReferenceEquals(x, row)).ToList();
        await InvokeAsync(StateHasChanged);
    }

    private int GetCourierShare(CourierSegment segment, int documents)
    {
        var segmentDocs = SegmentTotals.TryGetValue(segment, out var total) ? total : 0;

        if (segmentDocs == 0)
        {
            return 0;
        }

        return (int)Math.Round((decimal)documents / segmentDocs * 100m);
    }

    private string GetCourierShareClass(CourierSegment segment, int documents)
    {
        var share = GetCourierShare(segment, documents);
        if (share >= 50)
        {
            return "bg-danger";
        }

        if (share >= 30)
        {
            return "bg-warning";
        }

        return "bg-success";
    }

    private static CourierSegment? ResolveCourierSegment(JlData jl)
    {
        return (jl.Warehouse, jl.Level) switch
        {
            (WarehousePacking.Contracts.Data.Enums.PackingWarehouse.A, WarehousePacking.Contracts.Data.Enums.PackingLevel.Up) => CourierSegment.WarehouseAUp,
            (WarehousePacking.Contracts.Data.Enums.PackingWarehouse.A, WarehousePacking.Contracts.Data.Enums.PackingLevel.Bottom) => CourierSegment.WarehouseADown,
            (WarehousePacking.Contracts.Data.Enums.PackingWarehouse.B, WarehousePacking.Contracts.Data.Enums.PackingLevel.Bottom) => CourierSegment.WarehouseBDown,
            _ => null
        };
    }

    private IReadOnlyList<CourierRowView> GetCourierRowsForSegment(CourierSegment segment)
    {
        return CourierRows
            .Where(x => x.Data.Segment == segment)
            .OrderByDescending(x => GetCourierShare(x.Data.Segment, x.Data.Jls))
            .ThenBy(x => x.Data.Courier)
            .ToList();
    }

    private IReadOnlyList<CourierSegmentTableRow> GetCourierSegmentRows(CourierSegment segment)
    {
        var alertColorClass = GetSegmentAlertClass(segment);

        return GetCourierRowsForSegment(segment)
            .Select(rowState => new CourierSegmentTableRow
            {
                Key = rowState.Key,
                Courier = rowState.Data.CourierName,
                CourierSrc = rowState.Data.CourierSrc,
                Jls = rowState.Data.Jls,
                Weight = rowState.Data.Weight,
                Quantity = rowState.Data.Quantity,
                SharePercent = GetCourierShare(rowState.Data.Segment, rowState.Data.Jls),
                ShareClass = GetCourierShareClass(rowState.Data.Segment, rowState.Data.Jls),
                AnimationClass = $"{rowState.AnimationClass} {alertColorClass}".Trim()
            })
            .ToList();
    }

    private string GetSegmentAlertClass(CourierSegment segment)
    {
        // Get the total JL counts for this segment across all couriers
        var totalSegmentJls = SegmentTotals.TryGetValue(segment, out var total) ? total : 0;

        return segment switch
        {
            CourierSegment.WarehouseAUp => totalSegmentJls < ColorConfig.PackingUpBlueThreshold ? "table-primary" :
                                           totalSegmentJls > ColorConfig.PackingUpRedThreshold ? "table-danger" :
                                           "table-warning",

            CourierSegment.WarehouseADown or CourierSegment.WarehouseBDown =>
                                           totalSegmentJls < ColorConfig.PackingDownBlueThreshold ? "table-primary" :
                                           totalSegmentJls > ColorConfig.PackingDownRedThreshold ? "table-danger" :
                                           "table-warning",
            _ => string.Empty
        }; 
    }

    private IReadOnlyList<CourierSegmentTableSection> GetCourierSections()
    {
        return new List<CourierSegmentTableSection>
        {
            new()
            {
                Title = "Magazyn A - Góra",
                Rows = GetCourierSegmentRows(CourierSegment.WarehouseAUp)
            },
            new()
            {
                Title = "Magazyn A - Dół",
                Rows = GetCourierSegmentRows(CourierSegment.WarehouseADown)
            },
            new()
            {
                Title = "Magazyn B - Dół",
                Rows = GetCourierSegmentRows(CourierSegment.WarehouseBDown)
            }
        };
    }

    public ValueTask DisposeAsync()
    {
        DashboardClock.Tick -= HandleClockTick;
        return ValueTask.CompletedTask;
    }

    protected override void OnInitialized()
    {
        DashboardClock.EnsureStarted();
        DashboardClock.Tick += HandleClockTick;
        _now = DashboardClock.Now;
    }

    private void HandleClockTick()
    {
        _now = DashboardClock.Now;
        _ = InvokeAsync(StateHasChanged);
    }
}