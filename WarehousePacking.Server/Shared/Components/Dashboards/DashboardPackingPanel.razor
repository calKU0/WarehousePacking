@using WarehousePacking.Contracts.DTOs
@using WarehousePacking.Contracts.DTOs.Dashboards
@using WarehousePacking.Contracts.Data.Enums
@using WarehousePacking.Server.Helpers

@implements IAsyncDisposable

<div class="dashboard-packing-panel h-100 d-flex flex-column">
    <div class="row g-3 mb-3">
        <div class="col-12 col-md-3">
            <DashboardStatCard Title="Jl / Towary"
                               Subtitle="Do spakowania"
                               Value="@($"{FormatHelper.FormatQuantity(PackingDocumentsCount)} / {FormatHelper.FormatQuantity(PackingElementsTotal)}")"
                               IconClass="bi bi-box-seam"
                               AccentClass="dashboard-kpi-primary" />
        </div>
        <div class="col-12 col-md-3">
            <DashboardStatCard Title="Waga"
                               Subtitle="Do spakowania"
                               Value="@FormatHelper.FormatQuantity(PackingWeightRoundedTotal, "kg", "F0")"
                               IconClass="bi bi-speedometer2"
                               AccentClass="dashboard-kpi-info" />
        </div>
        <div class="col-12 col-md-3">
            <DashboardStatCard Title="Jl"
                               Subtitle="Aktualnie pakowane"
                               Value="@FormatHelper.FormatQuantity(PackingInProgressCount)"
                               IconClass="bi bi-hourglass-split"
                               AccentClass="dashboard-kpi-warning" />
        </div>
        <div class="col-12 col-md-3">
            <DashboardStatCard Title="Operatorzy"
                               Subtitle="Aktualnie pakujący"
                               Value="@FormatHelper.FormatQuantity(PackingOperatorsCount)"
                               IconClass="bi bi-people"
                               AccentClass="dashboard-kpi-success" />
        </div>
    </div>

    <div class="row g-3 dashboard-main-row flex-grow-1">
        <div class="col-12 col-xl-6 d-flex">
            <DashboardCard Icon="bi bi-truck" Title="Do spakowania">
                @* Fixed column proportions (see .dashboard-segment-table): the share
                   bar in the last column needs a predictable width, and the three
                   segments stacked in this one table must line up with each other. *@
                <table class="table table-striped table-hover mb-0 dashboard-table dashboard-segment-table">
                    <thead class="table-dark">
                        <tr>
                            <th>Kurier</th>
                            <th>Ilość Jl</th>
                            <th>Waga</th>
                            <th>Towary</th>
                            <th>Udział</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!CourierRows.Any())
                        {
                            <DashboardEmptyRow Columns="5"
                                               IsLoading="IsLoading"
                                               Icon="bi bi-truck"
                                               Message="Brak jednostek do spakowania." />
                        }
                        else
                        {
                            @foreach (var segment in CourierSegments)
                            {
                                var segmentRows = GetCourierRowsForSegment(segment.Segment);
                                // The whole segment is tinted by how big its queue is.
                                var segmentState = GetSegmentAlertClass(segment.Segment);

                                <tr class="dashboard-table__section">
                                    <td colspan="5">@segment.Title</td>
                                </tr>

                                if (!segmentRows.Any())
                                {
                                    <DashboardEmptyRow Columns="5" Icon="bi bi-check2-circle" Message="Brak danych." />
                                }
                                else
                                {
                                    @foreach (var row in segmentRows)
                                    {
                                        var share = GetCourierShare(row.Data.Segment, row.Data.Jls);

                                        <tr class="@($"{segmentState} {row.AnimationClass}".Trim())" @key="row.Key">
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    @if (!string.IsNullOrEmpty(row.Data.CourierSrc))
                                                    {
                                                        <img src="@row.Data.CourierSrc" alt="@row.Data.CourierName" class="dashboard-logo" />
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-truck text-muted fs-5"></i>
                                                    }
                                                    <span class="text-truncate" title="@row.Data.CourierName">@row.Data.CourierName</span>
                                                </div>
                                            </td>
                                            <td><DashboardAnimatedValue Text="@row.Data.Jls.ToString()" /></td>
                                            <td><DashboardAnimatedValue Text="@FormatHelper.FormatQuantity(row.Data.Weight, "kg", "F0")" /></td>
                                            <td><DashboardAnimatedValue Text="@FormatHelper.FormatQuantity(row.Data.Quantity)" /></td>
                                            <td>
                                                <div class="d-flex align-items-center gap-2 dashboard-share-wrap">
                                                    <div class="progress flex-grow-1" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@share">
                                                        <div class="progress-bar dashboard-share-bar @GetCourierShareClass(row.Data.Segment, row.Data.Jls)" style="width:@share%"></div>
                                                    </div>
                                                    <span class="badge text-bg-secondary"><DashboardAnimatedValue Text="@($"{share}%")" /></span>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            }
                        }
                    </tbody>
                </table>
            </DashboardCard>
        </div>

        <div class="col-12 col-xl-6 d-flex min-width-0">
            <DashboardCard Icon="bi bi-person-workspace" Title="Pakowane">
                <Meta>
                    <span class="dashboard-time-text">Najdłużej: <DashboardAnimatedValue Text="@LongestActiveElapsed" CssClass="dashboard-time-text" /></span>
                </Meta>
                <ChildContent>
                        <table class="table table-striped table-hover mb-0 dashboard-table dashboard-table-auto">
                            <colgroup>
                                <col class="packing-col-jl" />
                                <col class="packing-col-operator" />
                                <col class="packing-col-courier" />
                                <col class="packing-col-client" />
                                <col class="packing-col-station" />
                                <col class="packing-col-elapsed" />
                                <col class="packing-col-elapsed" />
                            </colgroup>
                            <thead class="table-dark">
                                <tr>
                                    <th>Jl</th>
                                    <th>Operator</th>
                                    <th>Kurier</th>
                                    <th>Klient</th>
                                    <th>Stan.</th>
                                    <th>Od podjęcia</th>
                                    <th>Od ost. skanu</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!InProgressRows.Any())
                                {
                                    <DashboardEmptyRow Columns="7"
                                                       IsLoading="IsLoading"
                                                       Icon="bi bi-box-seam"
                                                       Message="Brak aktywnego pakowania." />
                                }
                                else
                                {
                                    @foreach (var rowState in InProgressRows)
                                    {
                                        var row = rowState.Data;
                                                                                     
                                        var isDownStation = rowState.Data.StationNumber.Substring(1, 1) == "2";

                                        var packingTimeRedThreshold = isDownStation
                                            ? ColorConfig.PackingDownPackingTimeRedThreshold
                                            : ColorConfig.PackingUpPackingTimeRedThreshold;

                                        var packingTimeYellowThreshold = isDownStation
                                            ? ColorConfig.PackingDownPackingTimeYellowThreshold
                                            : ColorConfig.PackingUpPackingTimeYellowThreshold;
                                                
                                        <tr class="@($"{ElapsedClassHelper.GetRowClass(row.Date, packingTimeRedThreshold, packingTimeYellowThreshold)} {rowState.AnimationClass}".Trim())" @key="rowState.Key">
                                            <td>
                                                <span class="dashboard-truncate-jl" title="@row.Name">@row.Name</span>
                                            </td>
                                            <td>@row.User</td>
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    @if (!string.IsNullOrEmpty(row.CourierSrc))
                                                    {
                                                        <img src="@row.CourierSrc" alt="@row.Courier" class="dashboard-logo" />
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-truck text-muted fs-5"></i>
                                                    }
                                                    <span class="dashboard-truncate-courier" title="@row.Courier.GetDescription()">@row.Courier.GetDescription()</span>
                                                </div>
                                            </td>
                                            <td>@row.ClientName</td>
                                            <td>@row.StationNumber</td>
                                            <td class="dashboard-elapsed-cell">
                                                <DashboardElapsedBadge Since="row.Date"
                                                                       RedThresholdMinutes="packingTimeRedThreshold"
                                                                       YellowThresholdMinutes="packingTimeYellowThreshold" />
                                            </td>
                                            <td class="dashboard-elapsed-cell">
                                                <DashboardElapsedBadge Since="row.LastScanDate"
                                                                       RedThresholdMinutes="ColorConfig.OperatorLastActivityRedThresholdMinutes"
                                                                       YellowThresholdMinutes="ColorConfig.OperatorLastActivityYellowThresholdMinutes" />
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                </ChildContent>
            </DashboardCard>
        </div>
    </div>
</div>

@code {
    private enum CourierSegment
    {
        WarehouseAUp,
        WarehouseADown,
        WarehouseBDown
    }

    private sealed record CourierPackingSummary(CourierSegment Segment, Courier Courier, string CourierName, string CourierSrc, int Jls, decimal Weight, decimal Quantity);

    [Parameter] public List<JlData> Queue { get; set; } = new();
    [Parameter] public List<JlInProgressDto> InProgress { get; set; } = new();
    [Parameter] public DashboardColorConfiguration ColorConfig { get; set; } = new();
    [Parameter] public bool IsLoading { get; set; }

    // Rows animate only as they join or leave; see DashboardRowSync.
    private readonly DashboardRowSync<CourierPackingSummary> _courierSync;
    private readonly DashboardRowSync<JlInProgressDto> _inProgressSync;

    public DashboardPackingPanel()
    {
        _courierSync = new DashboardRowSync<CourierPackingSummary>(() => InvokeAsync(StateHasChanged));
        _inProgressSync = new DashboardRowSync<JlInProgressDto>(() => InvokeAsync(StateHasChanged));
    }

    private List<DashboardRow<CourierPackingSummary>> CourierRows => _courierSync.Rows;
    private List<DashboardRow<JlInProgressDto>> InProgressRows => _inProgressSync.Rows;

    private int PackingElementsTotal => Convert.ToInt32(Math.Round(Queue.Sum(x => x.Quantity)));

    private Dictionary<CourierSegment, int> SegmentTotals => Queue
        .Select(ResolveCourierSegment)
        .Where(x => x.HasValue)
        .GroupBy(x => x!.Value)
        .ToDictionary(g => g.Key, g => g.Count());

    private List<CourierPackingSummary> PackingByCourier => Queue
        .Select(x => new
        {
            Segment = ResolveCourierSegment(x),
            Courier = x.Courier,
            CourierName = x.Courier.GetDescription(),
            CourierSrc = CourierHelper.GetCourierLogo(null, x.Courier),
            Weight = x.Weight,
            Quantity = x.Quantity
        })
        .Where(x => x.Segment.HasValue)
        .GroupBy(x => new { Segment = x.Segment!.Value, x.Courier, x.CourierName })
        .Select(g => new CourierPackingSummary(
            g.Key.Segment,
            g.Key.Courier,
            g.Key.CourierName,
            g.Select(x => x.CourierSrc).FirstOrDefault(x => !string.IsNullOrWhiteSpace(x)) ?? string.Empty,
            g.Count(),
            g.Sum(x => x.Weight),
            g.Sum(x => x.Quantity)))
        .OrderByDescending(x => GetCourierShare(x.Segment, x.Jls))
        .ThenBy(x => x.CourierName)
        .ToList();

    private int PackingOperatorsCount => InProgress
        .Select(x => x.User)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Count();

    private int PackingDocumentsCount => Queue.Count;
    private int PackingWeightRoundedTotal => (int)Math.Round(Queue.Sum(x => x.Weight));
    private int PackingInProgressCount => InProgress.Count;
    private string LongestActiveElapsed => InProgressRows.Any() ? FormatHelper.FormatElapsed(InProgressRows.Min(x => x.Data.Date)) : "-";

    protected override void OnParametersSet()
    {
        _courierSync.Sync(PackingByCourier, GetCourierRowKey);
        _inProgressSync.Sync(BuildInProgressRows(), GetInProgressKey);
    }

    private static string GetCourierRowKey(CourierPackingSummary row)
    {
        return $"{row.Segment}|{row.Courier}";
    }

    private List<JlInProgressDto> BuildInProgressRows()
    {
        return InProgress.Select(x => new JlInProgressDto
        {
            ClientName = x.ClientName,
            Courier = x.Courier,
            CourierSrc = CourierHelper.GetCourierLogo(new ShipmentServices(), x.Courier),
            LastScanDate = DateTime.SpecifyKind(x.LastScanDate, DateTimeKind.Local),
            PackageId = x.PackageId,
            StationNumber = x.StationNumber,
            Date = DateTime.SpecifyKind(x.Date, DateTimeKind.Local),
            Name = x.Name,
            User = x.User
        }).OrderBy(x => x.Date).ToList();
    }

    private static string GetInProgressKey(JlInProgressDto row)
    {
        return $"{row.Name}|{row.User}|{row.StationNumber}";
    }

    private int GetCourierShare(CourierSegment segment, int documents)
    {
        var segmentDocs = SegmentTotals.TryGetValue(segment, out var total) ? total : 0;

        if (segmentDocs == 0)
        {
            return 0;
        }

        return (int)Math.Round((decimal)documents / segmentDocs * 100m);
    }

    private string GetCourierShareClass(CourierSegment segment, int documents)
    {
        var share = GetCourierShare(segment, documents);
        if (share >= 50)
        {
            return "bg-danger";
        }

        if (share >= 30)
        {
            return "bg-warning";
        }

        return "bg-success";
    }

    private static CourierSegment? ResolveCourierSegment(JlData jl)
    {
        return (jl.Warehouse, jl.Level) switch
        {
            (WarehousePacking.Contracts.Data.Enums.PackingWarehouse.A, WarehousePacking.Contracts.Data.Enums.PackingLevel.Up) => CourierSegment.WarehouseAUp,
            (WarehousePacking.Contracts.Data.Enums.PackingWarehouse.A, WarehousePacking.Contracts.Data.Enums.PackingLevel.Bottom) => CourierSegment.WarehouseADown,
            (WarehousePacking.Contracts.Data.Enums.PackingWarehouse.B, WarehousePacking.Contracts.Data.Enums.PackingLevel.Bottom) => CourierSegment.WarehouseBDown,
            _ => null
        };
    }

    private IReadOnlyList<DashboardRow<CourierPackingSummary>> GetCourierRowsForSegment(CourierSegment segment)
    {
        return CourierRows
            .Where(x => x.Data.Segment == segment)
            .OrderByDescending(x => GetCourierShare(x.Data.Segment, x.Data.Jls))
            .ThenBy(x => x.Data.Courier)
            .ToList();
    }

    /// <summary>
    /// Tints a whole segment by how big its queue is: comfortably below the
    /// threshold is green, over the red threshold is red, in between is amber.
    /// Uses the app-wide `is-*` row states so the wallboard's greens and reds
    /// match the packing list's.
    /// </summary>
    private string GetSegmentAlertClass(CourierSegment segment)
    {
        // Get the total JL counts for this segment across all couriers
        var totalSegmentJls = SegmentTotals.TryGetValue(segment, out var total) ? total : 0;

        return segment switch
        {
            CourierSegment.WarehouseAUp => totalSegmentJls < ColorConfig.PackingUpBlueThreshold ? "is-ready" :
                                           totalSegmentJls > ColorConfig.PackingUpRedThreshold ? "is-error" :
                                           "is-warning",

            CourierSegment.WarehouseADown or CourierSegment.WarehouseBDown =>
                                           totalSegmentJls < ColorConfig.PackingDownBlueThreshold ? "is-ready" :
                                           totalSegmentJls > ColorConfig.PackingDownRedThreshold ? "is-error" :
                                           "is-warning",
            _ => string.Empty
        };
    }

    /// <summary>The three packing areas, in the order they appear on the wall.</summary>
    private static readonly (CourierSegment Segment, string Title)[] CourierSegments =
    [
        (CourierSegment.WarehouseAUp, "Magazyn A - Góra"),
        (CourierSegment.WarehouseADown, "Magazyn A - Dół"),
        (CourierSegment.WarehouseBDown, "Magazyn B - Dół")
    ];

    public ValueTask DisposeAsync()
    {
        DashboardClock.Tick -= HandleClockTick;
        _courierSync.Dispose();
        _inProgressSync.Dispose();
        return ValueTask.CompletedTask;
    }

    protected override void OnInitialized()
    {
        DashboardClock.EnsureStarted();
        DashboardClock.Tick += HandleClockTick;
    }

    private void HandleClockTick() => _ = InvokeAsync(StateHasChanged);
}