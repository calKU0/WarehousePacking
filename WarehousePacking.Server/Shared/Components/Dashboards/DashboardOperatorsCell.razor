@*
    The operators working on a row, listed in full and comma-separated — the
    same plain treatment the logistic-unit codes get in the personal-collection
    panel.

    Deliberately NOT chips with a "+N" overflow counter. This is read from
    across the warehouse, and an operator hidden behind "+3" may as well not be
    on the screen at all. The cell wraps onto another line instead and the row
    grows to fit; pair it with `.dashboard-wrap-col` on both the <th> and the
    <td> so the column takes the leftover width and is allowed to wrap.

    The list still gets normalised here rather than in six panels: the API uses
    a bare "-" for "nobody", and entries arrive with stray whitespace.
*@

@if (_names.Count == 0)
{
    <span class="text-muted">-</span>
}
else
{
    @string.Join(", ", _names)
}

@code {
    /// <summary>Comma-separated operator list, exactly as the panels already build it.</summary>
    [Parameter] public string? Operators { get; set; }

    private List<string> _names = new();

    protected override void OnParametersSet()
    {
        _names = (Operators ?? string.Empty)
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(name => name != "-")
            .ToList();
    }
}
