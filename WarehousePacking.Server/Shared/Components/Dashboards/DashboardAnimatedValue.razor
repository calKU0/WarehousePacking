<span class="dashboard-roll-wrap @CssClass">
    @foreach (var part in _parts)
    {
        if (part.Animate)
        {
            <span class="dashboard-roll-value" @key="part.Key">@part.Text</span>
        }
        else
        {
            <span>@part.Text</span>
        }
    }
</span>

@*
    A value that animates the part of itself that changed, and nothing else.

    "3m 42s" ticking to "3m 43s" shares the prefix "3m 4" and the suffix "s", so
    only the "2"→"3" digit is re-keyed and rolls; the rest of the string is
    patched in place. That is what lets an elapsed timer animate every second
    without the whole value flickering, and it is the same treatment the
    "Odświeżenie za" countdown in the dashboard header gets.
*@

@code {
    private sealed record AnimatedPart(string Text, bool Animate, string Key);

    [Parameter] public string Text { get; set; } = string.Empty;
    [Parameter] public string CssClass { get; set; } = string.Empty;

    /// <summary>
    /// Escape hatch for a value that should swap silently. Left in place because
    /// the diffing below is what makes per-second animation cheap — but nothing
    /// currently needs it, so prefer leaving it on.
    /// </summary>
    [Parameter] public bool Animate { get; set; } = true;

    private string _lastText = string.Empty;
    private int _version;
    private IReadOnlyList<AnimatedPart> _parts = Array.Empty<AnimatedPart>();

    protected override void OnParametersSet()
    {
        var newText = Text ?? string.Empty;

        if (string.Equals(_lastText, newText, StringComparison.Ordinal))
        {
            if (_parts.Count == 0)
            {
                _parts = [new AnimatedPart(newText, false, "static")];
            }

            return;
        }

        if (!Animate)
        {
            // Stable key: the text is swapped in place, with no element churn.
            _parts = [new AnimatedPart(newText, false, "static")];
            _lastText = newText;
            return;
        }

        _version++;
        _parts = BuildParts(_lastText, newText, _version);
        _lastText = newText;
    }

    private static IReadOnlyList<AnimatedPart> BuildParts(string oldValue, string newValue, int version)
    {
        if (string.IsNullOrEmpty(oldValue))
        {
            return [new AnimatedPart(newValue, false, $"initial-{version}")];
        }

        var prefixLength = 0;
        while (prefixLength < oldValue.Length &&
               prefixLength < newValue.Length &&
               oldValue[prefixLength] == newValue[prefixLength])
        {
            prefixLength++;
        }

        var suffixLength = 0;
        while (suffixLength < oldValue.Length - prefixLength &&
               suffixLength < newValue.Length - prefixLength &&
               oldValue[oldValue.Length - 1 - suffixLength] == newValue[newValue.Length - 1 - suffixLength])
        {
            suffixLength++;
        }

        var prefix = prefixLength > 0 ? newValue[..prefixLength] : string.Empty;
        var changedLength = newValue.Length - prefixLength - suffixLength;
        var changed = changedLength > 0 ? newValue.Substring(prefixLength, changedLength) : string.Empty;
        var suffix = suffixLength > 0 ? newValue[^suffixLength..] : string.Empty;

        // Only the changed segment carries the version in its key. The stable
        // prefix/suffix keys let Blazor patch their text in place instead of
        // tearing the spans down and rebuilding them on every update — that
        // churn is what made the panels flicker.
        var result = new List<AnimatedPart>(3);
        if (!string.IsNullOrEmpty(prefix))
        {
            result.Add(new AnimatedPart(prefix, false, "prefix"));
        }

        if (!string.IsNullOrEmpty(changed))
        {
            result.Add(new AnimatedPart(changed, true, $"changed-{version}"));
        }

        if (!string.IsNullOrEmpty(suffix))
        {
            result.Add(new AnimatedPart(suffix, false, "suffix"));
        }

        if (result.Count == 0)
        {
            result.Add(new AnimatedPart(newValue, true, $"fallback-{version}"));
        }

        return result;
    }
}
