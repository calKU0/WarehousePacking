<div class="card shadow-sm h-100 monitor-kpi-card @AccentClass">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start gap-2">
            <div>
                <div class="text-muted small text-uppercase"><strong>@Title</strong></div>
                @if (!string.IsNullOrWhiteSpace(Subtitle))
                {
                    <div class="small text-secondary">@Subtitle</div>
                }
                <div class="display-6 fw-semibold mt-1">
                    <MonitorAnimatedValue Text="@Value" />
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(IconClass))
            {
                <span class="monitor-kpi-icon">
                    <i class="@IconClass"></i>
                </span>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public string Subtitle { get; set; } = string.Empty;
    [Parameter] public string IconClass { get; set; } = string.Empty;
    [Parameter] public string AccentClass { get; set; } = string.Empty;
}
