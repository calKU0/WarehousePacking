<div class="border rounded-3 overflow-hidden monitor-courier-segment d-flex flex-column">
    <div class="table-responsive monitor-auto-scroll monitor-scroll-fill">
        <table class="table table-striped table-hover mb-0 monitor-table monitor-table-fixed">
            <colgroup>
                <col style="width: 30%;" />
                <col style="width: 12%;" />
                <col style="width: 16%;" />
                <col style="width: 14%;" />
                <col style="width: 28%;" />
            </colgroup>
            <thead class="table-dark">
                <tr>
                    <th>Kurier</th>
                    <th>Ilość Jl</th>
                    <th>Waga (kg)</th>
                    <th>Towary</th>
                    <th>Udział</th>
                </tr>
            </thead>
            <tbody>
                @if (Sections.All(x => !x.Rows.Any()))
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-3">
                            @if (IsLoading)
                            {
                                <span>Ładowanie danych...</span>
                            }
                            else
                            {
                                <span>Brak danych.</span>
                            }
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var segment in Sections)
                    {
                        <tr class="table-secondary">
                            <td colspan="5" class="fw-semibold text-dark">@segment.Title</td>
                        </tr>

                        if (!segment.Rows.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-2">Brak danych.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var row in segment.Rows)
                            {
                                <tr class="@row.AnimationClass" @key="row.Key">
                                    <td>@row.Courier</td>
                                    <td><MonitorAnimatedValue Text="@row.Jls.ToString()" /></td>
                                    <td><MonitorAnimatedValue Text="@($"{Math.Round(row.Weight):F0}")" /></td>
                                    <td><MonitorAnimatedValue Text="@FormatQuantity(row.Elements)" /></td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2 monitor-share-wrap">
                                            <div class="progress flex-grow-1" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@row.SharePercent">
                                                <div class="progress-bar monitor-share-bar @row.ShareClass" style="width:@row.SharePercent%"></div>
                                            </div>
                                            <span class="badge text-bg-secondary"><MonitorAnimatedValue Text="@($"{row.SharePercent}%")" /></span>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    [Parameter] public IReadOnlyList<CourierSegmentTableSection> Sections { get; set; } = Array.Empty<CourierSegmentTableSection>();
    [Parameter] public bool IsLoading { get; set; }

    private static string FormatQuantity(decimal value)
    {
        return value % 1 == 0 ? value.ToString("F0") : value.ToString("F2");
    }
}
