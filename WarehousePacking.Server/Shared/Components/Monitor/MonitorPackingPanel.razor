@using WarehousePacking.Shared.DTOs
@using WarehousePacking.Shared.Helpers
@implements IAsyncDisposable

<div class="monitor-packing-panel h-100 d-flex flex-column">
<div class="row g-3 mb-3">
    <div class="col-12 col-md-3">
        <MonitorStatCard Title="Jl / Towary"
                         Subtitle="Do spakowania"
                         Value="@($"{PackingDocumentsCount} / {FormatQuantity(PackingElementsTotal)}")"
                         IconClass="bi bi-box-seam"
                         AccentClass="monitor-kpi-primary" />
    </div>
    <div class="col-12 col-md-3">
        <MonitorStatCard Title="Waga"
                         Subtitle="Do spakowania"
                         Value="@($"{PackingWeightRoundedTotal} kg")"
                         IconClass="bi bi-speedometer2"
                         AccentClass="monitor-kpi-info" />
    </div>
    <div class="col-12 col-md-3">
        <MonitorStatCard Title="Jl"
                         Subtitle="Aktualnie pakowane"
                         Value="@PackingInProgressCount.ToString()"
                         IconClass="bi bi-inboxes"
                         AccentClass="monitor-kpi-warning" />
    </div>
    <div class="col-12 col-md-3">
        <MonitorStatCard Title="Operatorzy"
                         Subtitle="Aktualnie pakujący"
                         Value="@PackingOperatorsCount.ToString()"
                         IconClass="bi bi-people"
                         AccentClass="monitor-kpi-success" />
    </div>
</div>

<div class="row g-3 monitor-main-row flex-grow-1">
    <div class="col-12 col-xl-6 d-flex">
        <div class="card shadow-sm h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-truck me-2"></i>Do spakowania</span>
            </div>
            <div class="card-body p-2 d-flex flex-column gap-2 monitor-courier-body monitor-auto-scroll">
                <MonitorCourierSegmentTable Sections="GetCourierSections()"
                                           IsLoading="IsLoading" />
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-6 d-flex">
        <div class="card shadow-sm h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-person-workspace me-2"></i>Pakowane</span>
                <span class="small text-muted monitor-time-text">Najdłużej: <MonitorAnimatedValue Text="@LongestActiveElapsed" CssClass="monitor-time-text" /></span>
            </div>
            <div class="card-body p-0 mb-0 monitor-scroll-host">
                <div class="table-responsive monitor-auto-scroll monitor-scroll-fill flex-grow-1">
                    <table class="table table-striped table-hover mb-0 monitor-table monitor-table-auto">
                        <thead class="table-dark">
                            <tr>
                                <th>Jl</th>
                                <th>Operator</th>
                                <th>Kurier</th>
                                <th>Klient</th>
                                <th>Stanowisko</th>
                                <th>Od podjęcia</th>
                                <th>Od ost. skanu</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!InProgressRows.Any())
                            {
                                <tr>
                                    <td colspan="7" class="text-center text-muted py-3">
                                        @if (IsLoading)
                                        {
                                            <span>Ładowanie danych...</span>
                                        }
                                        else
                                        {
                                            <span>Brak aktywnego pakowania.</span>
                                        }
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var rowState in InProgressRows)
                                {
                                    var row = rowState.Data;
                                    <tr class="@($"{GetElapsedRowClass(row.Date)} {rowState.AnimationClass}".Trim())" @key="rowState.Key">
                                        <td>@row.Name</td>
                                        <td>@row.User</td>
                                        <td>@row.Courier</td>
                                        <td>@row.ClientName</td>
                                        <td>@row.StationNumber</td>
                                        <td class="monitor-elapsed-cell">
                                            <span class="badge @GetElapsedBadgeClass(row.Date) monitor-elapsed-badge monitor-time-text">
                                                <MonitorAnimatedValue Text="@FormatElapsed(row.Date)" CssClass="monitor-time-text" />
                                            </span>
                                        </td>
                                        <td class="monitor-elapsed-cell">
                                            <span class="badge @GetElapsedBadgeClass(row.LastScanDate) monitor-elapsed-badge monitor-time-text">
                                                <MonitorAnimatedValue Text="@FormatElapsed(row.LastScanDate)" CssClass="monitor-time-text" />
                                            </span>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            </div>
        </div>
    </div>
</div>

@code {
    private const int RowAnimationDelayMs = 280;
    private readonly CancellationTokenSource _clockCts = new();
    private DateTime _now = DateTime.Now;
    private bool _clockStarted;

    private enum CourierSegment
    {
        WarehouseAUp,
        WarehouseADown,
        WarehouseBDown
    }

    private sealed record CourierPackingSummary(CourierSegment Segment, string Courier, int Jls, decimal Weight, decimal Elements);

    private sealed class CourierRowView
    {
        public string Key { get; set; } = string.Empty;
        public CourierPackingSummary Data { get; set; } = null!;
        public string AnimationClass { get; set; } = string.Empty;
        public bool IsLeaving { get; set; }
    }

    private sealed class InProgressRowView
    {
        public string Key { get; set; } = string.Empty;
        public JlInProgressDto Data { get; set; } = null!;
        public string AnimationClass { get; set; } = string.Empty;
        public bool IsLeaving { get; set; }
    }

    [Parameter] public List<JlData> Queue { get; set; } = new();
    [Parameter] public List<JlInProgressDto> InProgress { get; set; } = new();
    [Parameter] public Dictionary<string, decimal> ElementsByJl { get; set; } = new(StringComparer.OrdinalIgnoreCase);
    [Parameter] public bool IsLoading { get; set; }

    private List<CourierRowView> CourierRows { get; set; } = new();
    private List<InProgressRowView> InProgressRows { get; set; } = new();

    private Dictionary<CourierSegment, int> SegmentTotals => Queue
        .Select(ResolveCourierSegment)
        .Where(x => x.HasValue)
        .GroupBy(x => x!.Value)
        .ToDictionary(g => g.Key, g => g.Count());

    private List<CourierPackingSummary> PackingByCourier => Queue
        .Select(x => new
        {
            Segment = ResolveCourierSegment(x),
            Courier = string.IsNullOrWhiteSpace(x.CourierName) ? "Brak" : x.CourierName,
            Weight = x.Weight,
            Elements = GetJlElements(x.Name)
        })
        .Where(x => x.Segment.HasValue)
        .GroupBy(x => new { Segment = x.Segment!.Value, x.Courier })
        .Select(g => new CourierPackingSummary(
            g.Key.Segment,
            g.Key.Courier,
            g.Count(),
            g.Sum(x => x.Weight),
            g.Sum(x => x.Elements)))
        .OrderByDescending(x => GetCourierShare(x.Segment, x.Jls))
        .ThenBy(x => x.Courier)
        .ToList();

    private int PackingOperatorsCount => InProgress
        .Select(x => x.User)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Count();

    private int PackingDocumentsCount => Queue.Count;
    private int PackingWeightRoundedTotal => (int)Math.Round(Queue.Sum(x => x.Weight));
    private decimal PackingElementsTotal => Queue.Sum(x => GetJlElements(x.Name));
    private int PackingInProgressCount => InProgress.Count;
    private string LongestActiveElapsed => InProgressRows.Any() ? FormatElapsed(InProgressRows.Min(x => x.Data.Date)) : "-";

    protected override void OnParametersSet()
    {
        if (!_clockStarted)
        {
            _clockStarted = true;
            _ = RunClockAsync(_clockCts.Token);
        }

        SyncCourierRows();
        SyncInProgressRows();
    }

    private void SyncCourierRows()
    {
        var latest = PackingByCourier;
        var latestKeys = latest.Select(GetCourierRowKey).ToHashSet(StringComparer.OrdinalIgnoreCase);

        foreach (var item in latest)
        {
            var itemKey = GetCourierRowKey(item);
            var existing = CourierRows.FirstOrDefault(x => string.Equals(x.Key, itemKey, StringComparison.OrdinalIgnoreCase));
            if (existing is null)
            {
                var added = new CourierRowView
                {
                    Key = itemKey,
                    Data = item,
                    AnimationClass = "monitor-row-enter"
                };

                CourierRows.Add(added);
                _ = ClearCourierEnterClassAsync(added);
            }
            else
            {
                existing.Data = item;
                if (existing.IsLeaving)
                {
                    existing.IsLeaving = false;
                    existing.AnimationClass = "monitor-row-enter";
                    _ = ClearCourierEnterClassAsync(existing);
                }
            }
        }

        foreach (var row in CourierRows.Where(x => !x.IsLeaving && !latestKeys.Contains(x.Key)).ToList())
        {
            row.IsLeaving = true;
            row.AnimationClass = "monitor-row-leave";
            _ = RemoveCourierRowAsync(row);
        }

        var orderedActive = latest.Select(x => CourierRows.First(r => string.Equals(r.Key, GetCourierRowKey(x), StringComparison.OrdinalIgnoreCase))).ToList();
        var leaving = CourierRows.Where(x => x.IsLeaving).ToList();
        CourierRows = orderedActive.Concat(leaving).ToList();
    }

    private static string GetCourierRowKey(CourierPackingSummary row)
    {
        return $"{row.Segment}|{row.Courier}";
    }

    private void SyncInProgressRows()
    {
        var latest = InProgress.OrderBy(x => x.Date).ToList();
        var latestKeys = latest.Select(GetInProgressKey).ToHashSet(StringComparer.OrdinalIgnoreCase);

        foreach (var item in latest)
        {
            var key = GetInProgressKey(item);
            var existing = InProgressRows.FirstOrDefault(x => string.Equals(x.Key, key, StringComparison.OrdinalIgnoreCase));
            if (existing is null)
            {
                var added = new InProgressRowView
                {
                    Key = key,
                    Data = item,
                    AnimationClass = "monitor-row-enter"
                };

                InProgressRows.Add(added);
                _ = ClearInProgressEnterClassAsync(added);
            }
            else
            {
                existing.Data = item;
                if (existing.IsLeaving)
                {
                    existing.IsLeaving = false;
                    existing.AnimationClass = "monitor-row-enter";
                    _ = ClearInProgressEnterClassAsync(existing);
                }
            }
        }

        foreach (var row in InProgressRows.Where(x => !x.IsLeaving && !latestKeys.Contains(x.Key)).ToList())
        {
            row.IsLeaving = true;
            row.AnimationClass = "monitor-row-leave";
            _ = RemoveInProgressRowAsync(row);
        }

        var orderedActive = latest.Select(x => InProgressRows.First(r => string.Equals(r.Key, GetInProgressKey(x), StringComparison.OrdinalIgnoreCase))).ToList();
        var leaving = InProgressRows.Where(x => x.IsLeaving).ToList();
        InProgressRows = orderedActive.Concat(leaving).ToList();
    }

    private static string GetInProgressKey(JlInProgressDto row)
    {
        return $"{row.Name}|{row.User}|{row.StationNumber}";
    }

    private async Task ClearCourierEnterClassAsync(CourierRowView row)
    {
        await Task.Delay(RowAnimationDelayMs);
        if (row.IsLeaving)
        {
            return;
        }

        row.AnimationClass = string.Empty;
        await InvokeAsync(StateHasChanged);
    }

    private async Task RemoveCourierRowAsync(CourierRowView row)
    {
        await Task.Delay(RowAnimationDelayMs);
        if (!row.IsLeaving)
        {
            return;
        }

        CourierRows = CourierRows.Where(x => !ReferenceEquals(x, row)).ToList();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ClearInProgressEnterClassAsync(InProgressRowView row)
    {
        await Task.Delay(RowAnimationDelayMs);
        if (row.IsLeaving)
        {
            return;
        }

        row.AnimationClass = string.Empty;
        await InvokeAsync(StateHasChanged);
    }

    private async Task RemoveInProgressRowAsync(InProgressRowView row)
    {
        await Task.Delay(RowAnimationDelayMs);
        if (!row.IsLeaving)
        {
            return;
        }

        InProgressRows = InProgressRows.Where(x => !ReferenceEquals(x, row)).ToList();
        await InvokeAsync(StateHasChanged);
    }

    private decimal GetJlElements(string? jlCode)
    {
        if (string.IsNullOrWhiteSpace(jlCode))
        {
            return 0m;
        }

        return ElementsByJl.TryGetValue(jlCode, out var value) ? value : 0m;
    }

    private int GetCourierShare(CourierSegment segment, int documents)
    {
        var segmentDocs = SegmentTotals.TryGetValue(segment, out var total) ? total : 0;

        if (segmentDocs == 0)
        {
            return 0;
        }

        return (int)Math.Round((decimal)documents / segmentDocs * 100m);
    }

    private string GetCourierShareClass(CourierSegment segment, int documents)
    {
        var share = GetCourierShare(segment, documents);
        if (share >= 50)
        {
            return "bg-danger";
        }

        if (share >= 30)
        {
            return "bg-warning";
        }

        return "bg-success";
    }

    private static CourierSegment? ResolveCourierSegment(JlData jl)
    {
        return (jl.Warehouse, jl.Level) switch
        {
            (WarehousePacking.Shared.Enums.PackingWarehouse.A, WarehousePacking.Shared.Enums.PackingLevel.Up) => CourierSegment.WarehouseAUp,
            (WarehousePacking.Shared.Enums.PackingWarehouse.A, WarehousePacking.Shared.Enums.PackingLevel.Bottom) => CourierSegment.WarehouseADown,
            (WarehousePacking.Shared.Enums.PackingWarehouse.B, WarehousePacking.Shared.Enums.PackingLevel.Bottom) => CourierSegment.WarehouseBDown,
            _ => null
        };
    }

    private IReadOnlyList<CourierRowView> GetCourierRowsForSegment(CourierSegment segment)
    {
        return CourierRows
            .Where(x => x.Data.Segment == segment)
            .OrderByDescending(x => GetCourierShare(x.Data.Segment, x.Data.Jls))
            .ThenBy(x => x.Data.Courier)
            .ToList();
    }

    private IReadOnlyList<CourierSegmentTableRow> GetCourierSegmentRows(CourierSegment segment)
    {
        return GetCourierRowsForSegment(segment)
            .Select(rowState => new CourierSegmentTableRow
            {
                Key = rowState.Key,
                Courier = rowState.Data.Courier,
                Jls = rowState.Data.Jls,
                Weight = rowState.Data.Weight,
                Elements = rowState.Data.Elements,
                SharePercent = GetCourierShare(rowState.Data.Segment, rowState.Data.Jls),
                ShareClass = GetCourierShareClass(rowState.Data.Segment, rowState.Data.Jls),
                AnimationClass = rowState.AnimationClass
            })
            .ToList();
    }

    private IReadOnlyList<CourierSegmentTableSection> GetCourierSections()
    {
        return new List<CourierSegmentTableSection>
        {
            new()
            {
                Title = "Magazyn A - Góra",
                Rows = GetCourierSegmentRows(CourierSegment.WarehouseAUp)
            },
            new()
            {
                Title = "Magazyn A - Dół",
                Rows = GetCourierSegmentRows(CourierSegment.WarehouseADown)
            },
            new()
            {
                Title = "Magazyn B - Dół",
                Rows = GetCourierSegmentRows(CourierSegment.WarehouseBDown)
            }
        };
    }

    private static string FormatQuantity(decimal value)
    {
        return value % 1 == 0 ? value.ToString("F0") : value.ToString("F2");
    }

    private string FormatElapsed(DateTime start)
    {
        var elapsed = _now - start;
        if (elapsed.TotalDays >= 1)
        {
            return $"{(int)elapsed.TotalDays}d {(int)elapsed.TotalHours % 24}h";
        }

        if (elapsed.TotalHours >= 1)
        {
            return $"{(int)elapsed.TotalHours}h {elapsed.Minutes}m";
        }

        return $"{Math.Max(0, elapsed.Minutes)}m {Math.Max(0, elapsed.Seconds)}s";
    }

    private string GetElapsedBadgeClass(DateTime start)
    {
        var elapsed = _now - start;

        if (elapsed.TotalMinutes >= 45)
        {
            return "text-bg-danger";
        }

        if (elapsed.TotalMinutes >= 20)
        {
            return "text-bg-warning";
        }

        return "text-bg-success";
    }

    private string GetElapsedRowClass(DateTime start)
    {
        var elapsed = _now - start;

        if (elapsed.TotalMinutes >= 45)
        {
            return "table-danger";
        }

        if (elapsed.TotalMinutes >= 20)
        {
            return "table-warning";
        }

        return string.Empty;
    }

    private async Task RunClockAsync(CancellationToken token)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
            while (await timer.WaitForNextTickAsync(token))
            {
                _now = DateTime.Now;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    public ValueTask DisposeAsync()
    {
        _clockCts.Cancel();
        _clockCts.Dispose();
        return ValueTask.CompletedTask;
    }
}
