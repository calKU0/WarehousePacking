@using WarehousePacking.Contracts.DTOs

@*
    Merges two already-closed packages into one. Enter advances through the
    fields in scan order so the whole form can be completed with a scanner.
*@

<AppModal IsVisible="IsVisible" Title="Podaj kody kreskowe i wymiary" Icon="bi bi-union" OnClose="Close">
    <ChildContent>
        <div class="mb-3">
            <label class="form-label app-section-label" for="mergeInitial">Kod kreskowy pierwszej paczki</label>
            <input id="mergeInitial"
                   type="text"
                   class="form-control form-control-lg"
                   @bind="InitialBarcode"
                   @ref="_initialBarcodeRef"
                   @onkeydown="e => FocusNextOnEnter(e, _mergingBarcodeRef)"
                   autocomplete="off"
                   autofocus />
        </div>

        <div class="mb-3">
            <label class="form-label app-section-label" for="mergeSecond">Kod kreskowy drugiej paczki</label>
            <input id="mergeSecond"
                   type="text"
                   class="form-control form-control-lg"
                   @bind="MergingBarcode"
                   @ref="_mergingBarcodeRef"
                   @onkeydown="e => FocusNextOnEnter(e, _lengthRef)"
                   autocomplete="off" />
        </div>

        <div class="merge-packages__dimensions">
            <div>
                <label class="form-label app-section-label" for="mergeLength">Długość (cm)</label>
                <input id="mergeLength" type="number" inputmode="numeric" class="form-control form-control-lg"
                       @bind="Length" @ref="_lengthRef" min="0"
                       @onkeydown="e => FocusNextOnEnter(e, _widthRef)" />
            </div>
            <div>
                <label class="form-label app-section-label" for="mergeWidth">Szerokość (cm)</label>
                <input id="mergeWidth" type="number" inputmode="numeric" class="form-control form-control-lg"
                       @bind="Width" @ref="_widthRef" min="0"
                       @onkeydown="e => FocusNextOnEnter(e, _heightRef)" />
            </div>
            <div>
                <label class="form-label app-section-label" for="mergeHeight">Wysokość (cm)</label>
                <input id="mergeHeight" type="number" inputmode="numeric" class="form-control form-control-lg"
                       @bind="Height" @ref="_heightRef" min="0"
                       @onkeydown="ConfirmOnEnter" />
            </div>
        </div>
    </ChildContent>

    <Footer>
        <button type="button" class="btn btn-primary" style="flex: 7;" @onclick="Confirm">Potwierdź</button>
        <button type="button" class="btn btn-secondary" style="flex: 3;" @onclick="Close">Anuluj</button>
    </Footer>
</AppModal>

@code {
    private TaskCompletionSource<MergePackagesDto?>? _tcs;

    public bool IsVisible { get; private set; }

    public string InitialBarcode { get; set; } = string.Empty;
    public string MergingBarcode { get; set; } = string.Empty;

    public int Height { get; set; }
    public int Width { get; set; }
    public int Length { get; set; }

    private ElementReference _initialBarcodeRef;
    private ElementReference _mergingBarcodeRef;
    private ElementReference _lengthRef;
    private ElementReference _widthRef;
    private ElementReference _heightRef;

    public async Task<MergePackagesDto?> Show(
        string initialBarcode = "",
        string mergingBarcode = "",
        int height = 0,
        int width = 0,
        int length = 0)
    {
        InitialBarcode = initialBarcode;
        MergingBarcode = mergingBarcode;

        Height = height;
        Width = width;
        Length = length;

        IsVisible = true;
        StateHasChanged();

        _tcs = new TaskCompletionSource<MergePackagesDto?>();

        // Yield once so the dialog is in the DOM before we focus its first field.
        await Task.Delay(1);
        await _initialBarcodeRef.FocusAsync();

        return await _tcs.Task;
    }

    private static async Task FocusNextOnEnter(KeyboardEventArgs e, ElementReference next)
    {
        if (e.Key == "Enter")
            await next.FocusAsync();
    }

    private void ConfirmOnEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            Confirm();
    }

    private void Confirm() => Complete(new MergePackagesDto
    {
        InitialBarcode = InitialBarcode,
        MergingBarcode = MergingBarcode,
        Dimensions = new Dimensions
        {
            Height = Height,
            Width = Width,
            Length = Length
        }
    });

    private void Close() => Complete(null);

    private void Complete(MergePackagesDto? result)
    {
        IsVisible = false;
        _tcs?.TrySetResult(result);
        StateHasChanged();
    }
}
