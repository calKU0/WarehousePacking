@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@inject IJSRuntime JSRuntime

@if (IsVisible)
{
    <div class="modal-backdrop fade show" @onclick="Cancel"></div>

    <div class="modal d-block">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">@Title</h5>
                    <button type="button" class="btn-close" @onclick="Cancel"></button>
                </div>

                <div class="modal-body">
                    <p>@Message</p>

                    @if (IsLoading)
                    {
                        <div class="text-center py-4">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Ładowanie...</span>
                            </div>
                            <div class="mt-2">@LoadingMessage</div>
                        </div>
                    }
                    else
                    {
                        @for (int i = 0; i < ComboBoxes.Count; i++)
                        {
                            var combo = ComboBoxes[i];

                            <div class="mb-3">
                                <label class="form-label">@combo.Label</label>

                                <select class="form-select"
                                        value="@combo.SelectedValue"
                                        @onchange="e => OnValueChanged(combo, e.Value?.ToString())"
                                        @onkeydown="HandleKeyDown">

                                    <option value="" disabled selected hidden>
                                        @combo.Placeholder
                                    </option>

                                    @foreach (var item in combo.Items)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                </select>
                            </div>
                        }
                    }
                </div>

                <div class="modal-footer d-flex gap-2 w-100">
                    <button class="btn btn-primary btn-lg tall-btn"
                            style="flex:7"
                            disabled="@(!CanConfirm)"
                            @onclick="Confirm">
                        Potwierdź
                    </button>

                    <button class="btn btn-secondary btn-lg tall-btn"
                            style="flex:3"
                            @onclick="Cancel">
                        Anuluj
                    </button>
                </div>

            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string Title { get; set; } = "Wybierz wartości";
    [Parameter] public string Message { get; set; } = "Wybierz z listy";
    [Parameter] public EventCallback OnClose { get; set; }

    public bool IsVisible { get; set; }
    public bool IsLoading { get; set; }
    public string LoadingMessage { get; set; } = "Ładowanie danych...";
    private bool CanConfirm =>
        !IsLoading &&
        ComboBoxes.Any() &&
        ComboBoxes.All(c => !string.IsNullOrWhiteSpace(c.SelectedValue));

    public List<ComboBoxDefinition> ComboBoxes { get; set; } = new();

    private TaskCompletionSource<List<string>> _tcs;

    public Task<List<string>> Show(string title, string message, List<ComboBoxDefinition> comboBoxes)
    {
        Title = title;
        Message = message;
        IsLoading = false;

        ComboBoxes = comboBoxes;

        foreach (var cb in ComboBoxes)
            cb.SelectedValue = string.Empty;

        IsVisible = true;
        StateHasChanged();

        _tcs = new TaskCompletionSource<List<string>>();
        return _tcs.Task;
    }

    public Task<List<string>> ShowLoading(string title, string message, string loadingMessage = "Ładowanie danych...")
    {
        Title = title;
        Message = message;
        LoadingMessage = loadingMessage;
        ComboBoxes = new List<ComboBoxDefinition>();
        IsLoading = true;
        IsVisible = true;
        StateHasChanged();

        _tcs = new TaskCompletionSource<List<string>>();
        return _tcs.Task;
    }

    public void SetData(List<ComboBoxDefinition> comboBoxes)
    {
        ComboBoxes = comboBoxes;

        foreach (var cb in ComboBoxes)
            cb.SelectedValue = string.Empty;

        IsLoading = false;
        StateHasChanged();
    }

    public void CloseModal()
    {
        _tcs?.TrySetResult(null);
        Close();
    }

    private void OnValueChanged(ComboBoxDefinition combo, string value)
    {
        combo.SelectedValue = value;
    }

    private void Confirm()
    {
        var results = ComboBoxes
            .Select(c => c.SelectedValue)
            .ToList();

        _tcs?.SetResult(results);
        Close();
    }

    private void Cancel()
    {
        _tcs?.SetResult(null);
        Close();
    }

    private void Close()
    {
        IsVisible = false;
        StateHasChanged();
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (!IsLoading && e.Key == "Enter")
        {
            Confirm();
        }
    }
}
