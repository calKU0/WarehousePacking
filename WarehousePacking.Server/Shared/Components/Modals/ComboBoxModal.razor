@inject IJSRuntime JSRuntime

@*
    Generic multi-dropdown prompt. Can be opened in a loading state
    (ShowLoading) and populated later via SetData once data arrives.
    Resolves to the selected values in order, or null if cancelled.
*@

<AppModal IsVisible="IsVisible" Title="@Title" Icon="bi bi-list-check" Size="lg" OnClose="Cancel">
    <ChildContent>
        @if (!string.IsNullOrWhiteSpace(Message))
        {
            <p class="text-muted">@Message</p>
        }

        @if (IsLoading)
        {
            <div class="app-empty">
                <div class="app-spinner"></div>
                <p class="app-empty__text">@LoadingMessage</p>
            </div>
        }
        else
        {
            @foreach (var combo in ComboBoxes)
            {
                <div class="mb-3">
                    <label class="form-label app-section-label">@combo.Label</label>
                    <select class="form-select form-select-lg"
                            value="@combo.SelectedValue"
                            @onchange="e => OnValueChanged(combo, e.Value?.ToString())"
                            @onkeydown="HandleKeyDown">
                        <option value="" disabled selected hidden>@combo.Placeholder</option>
                        @foreach (var item in combo.Items)
                        {
                            <option value="@item">@item</option>
                        }
                    </select>
                </div>
            }
        }
    </ChildContent>

    <Footer>
        <button type="button" class="btn btn-primary" style="flex: 7;" disabled="@(!CanConfirm)" @onclick="Confirm">
            Potwierdź
        </button>
        <button type="button" class="btn btn-secondary" style="flex: 3;" @onclick="Cancel">Anuluj</button>
    </Footer>
</AppModal>

@code {
    [Parameter] public string Title { get; set; } = "Wybierz wartości";
    [Parameter] public string Message { get; set; } = "Wybierz z listy";
    [Parameter] public EventCallback OnClose { get; set; }

    public bool IsVisible { get; set; }
    public bool IsLoading { get; set; }
    public string LoadingMessage { get; set; } = "Ładowanie danych...";
    public List<ComboBoxDefinition> ComboBoxes { get; set; } = new();

    private TaskCompletionSource<List<string>?>? _tcs;

    private bool CanConfirm =>
        !IsLoading &&
        ComboBoxes.Any() &&
        ComboBoxes.All(c => !string.IsNullOrWhiteSpace(c.SelectedValue));

    public Task<List<string>?> Show(string title, string message, List<ComboBoxDefinition> comboBoxes)
    {
        Title = title;
        Message = message;
        IsLoading = false;

        SetSelections(comboBoxes);

        IsVisible = true;
        StateHasChanged();

        return StartRequest();
    }

    /// <summary>
    /// Opens immediately in a loading state so the operator sees feedback while
    /// the caller fetches the option lists; finish with <see cref="SetData"/>.
    /// </summary>
    public Task<List<string>?> ShowLoading(string title, string message, string loadingMessage = "Ładowanie danych...")
    {
        Title = title;
        Message = message;
        LoadingMessage = loadingMessage;
        ComboBoxes = new List<ComboBoxDefinition>();
        IsLoading = true;
        IsVisible = true;
        StateHasChanged();

        return StartRequest();
    }

    public void SetData(List<ComboBoxDefinition> comboBoxes)
    {
        SetSelections(comboBoxes);
        IsLoading = false;
        StateHasChanged();
    }

    public void CloseModal() => Complete(null);

    private Task<List<string>?> StartRequest()
    {
        _tcs = new TaskCompletionSource<List<string>?>();
        return _tcs.Task;
    }

    private void SetSelections(List<ComboBoxDefinition> comboBoxes)
    {
        ComboBoxes = comboBoxes;

        foreach (var cb in ComboBoxes)
            cb.SelectedValue = string.Empty;
    }

    private static void OnValueChanged(ComboBoxDefinition combo, string? value)
        => combo.SelectedValue = value ?? string.Empty;

    private void Confirm() => Complete(ComboBoxes.Select(c => c.SelectedValue).ToList());

    private void Cancel() => Complete(null);

    private void Complete(List<string>? result)
    {
        _tcs?.TrySetResult(result);
        IsVisible = false;
        StateHasChanged();
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (!IsLoading && e.Key == "Enter" && CanConfirm)
        {
            Confirm();
        }
    }
}
