@using WarehousePacking.Contracts.Data.Enums
@using WarehousePacking.Server.Helpers

@*
    Courier picker used when a route is closed and the shipment must be moved
    to a different carrier. Resolves to the chosen courier, or null if the
    operator backs out.
*@

<AppModal IsVisible="IsVisible" Title="Wybierz kuriera" Icon="bi bi-truck" Size="sm" OnClose="Cancel">
    <ChildContent>
        <div class="d-flex flex-column gap-2">
            @foreach (var courier in Couriers)
            {
                <button type="button"
                        class="btn @(SelectedCourier == courier ? "btn-primary" : "btn-outline-secondary") courier-modal__option"
                        @onclick="() => SelectedCourier = courier">
                    <CourierLabel Courier="courier" />
                </button>
            }
        </div>
    </ChildContent>


    <Footer>
        <button type="button" class="btn btn-secondary" @onclick="Cancel">Zamknij</button>
        <button type="button" class="btn btn-primary" @onclick="Confirm" disabled="@(!SelectedCourier.HasValue)">
            Zatwierdź
        </button>
    </Footer>
</AppModal>

@code {
    private static readonly Courier[] Couriers = { Courier.DPD, Courier.GLS, Courier.Fedex };

    private bool IsVisible { get; set; }
    private Courier? SelectedCourier { get; set; }

    private TaskCompletionSource<Courier?>? _tcs;

    public Task<Courier?> ShowModal(Courier? defaultCourier = null)
    {
        SelectedCourier = defaultCourier;
        IsVisible = true;
        StateHasChanged();

        _tcs = new TaskCompletionSource<Courier?>();
        return _tcs.Task;
    }

    private void Confirm() => Close(SelectedCourier);

    private void Cancel() => Close(null);

    /// <summary>
    /// Always completes the pending task. Previously the cancel/close path left
    /// it unresolved, so an awaiting caller hung forever.
    /// </summary>
    private void Close(Courier? result)
    {
        _tcs?.TrySetResult(result);

        IsVisible = false;
        SelectedCourier = null;
        StateHasChanged();
    }
}
