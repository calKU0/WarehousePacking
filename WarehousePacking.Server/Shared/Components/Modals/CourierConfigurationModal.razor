@using WarehousePacking.Shared.DTOs

@if (IsVisible)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-xl modal-dialog-scrollable" role="document">
            <div class="modal-content shadow-lg">
                <div class="modal-header bg-light">
                    <h5 class="modal-title">Konfiguracja Kurierów</h5>
                    <button type="button" class="btn-close" @onclick="HandleCancel"></button>
                </div>
                <div class="modal-body">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-dark">
                                <tr>
                                    <th>Kurier</th>
                                    <th>Automatyczne generowanie FV</th>
                                    <th>Generowanie FV Start/Koniec (HH:mm:ss)</th>
                                    <th>Waga PL (Dół/Góra)</th>
                                    <th>Waga Exp (Dół/Góra)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var config in Configurations)
                                {
                                    <tr>
                                        <td class="fw-bold">@config.Courier</td>
                                        <td>
                                            <div class="form-check form-switch">
                                                <input class="form-check-input" type="checkbox" @bind="config.AutomaticFvGeneration">
                                            </div>
                                        </td>
                                        <td>
                                            <div class="input-group input-group-sm">
                                                <input type="time" step="1" class="form-control"
                                                       value="@(config.AutomaticFvStart?.ToString(@"hh\:mm\:ss"))"
                                                       @onchange="@(e => config.AutomaticFvStart = HandleTimeChange(e.Value))" />

                                                <input type="time" step="1" class="form-control"
                                                       value="@(config.AutomaticFvEnd?.ToString(@"hh\:mm\:ss"))"
                                                       @onchange="@(e => config.AutomaticFvEnd = HandleTimeChange(e.Value))" />
                                            </div>
                                        </td>
                                        <td>
                                            <div class="input-group input-group-sm">
                                                <input type="number" class="form-control" @bind="config.WeightBottomPL" step="0.01" />
                                                <input type="number" class="form-control" @bind="config.WeightUpPL" step="0.01" />
                                            </div>
                                        </td>
                                        <td>
                                            <div class="input-group input-group-sm">
                                                <input type="number" class="form-control" @bind="config.WeightBottomExport" step="0.01" />
                                                <input type="number" class="form-control" @bind="config.WeightUpExport" step="0.01" />
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary" @onclick="HandleCancel">Anuluj</button>
                    <button type="button" class="btn btn-primary" @onclick="HandleConfirm">
                        <i class="bi bi-save"></i> Zapisz zmiany
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool IsVisible { get; set; }
    private List<CourierConfiguration> Configurations { get; set; } = new();

    private Func<Task>? OnConfirm { get; set; }
    private Func<Task>? OnCancel { get; set; }

    public void Show(List<CourierConfiguration> configs, Func<Task> onConfirm, Func<Task> onCancel)
    {
        Configurations = configs;
        OnConfirm = onConfirm;
        OnCancel = onCancel;
        IsVisible = true;
        StateHasChanged();
    }

    private async Task HandleConfirm()
    {
        if (OnConfirm != null) await OnConfirm.Invoke();
        IsVisible = false;
    }

    private async Task HandleCancel()
    {
        if (OnCancel != null) await OnCancel.Invoke();
        IsVisible = false;
    }

    private TimeSpan? HandleTimeChange(object? value)
    {
        if (value != null && TimeSpan.TryParse(value.ToString(), out var result))
        {
            return result;
        }
        return null;
    }

}