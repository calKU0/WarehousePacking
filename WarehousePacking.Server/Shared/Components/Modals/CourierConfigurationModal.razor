@using WarehousePacking.Contracts.DTOs

@*
    Per-courier settings: automatic invoice generation window and the weight
    thresholds that decide bottom/top packing level. Edits mutate the supplied
    list in place; the host persists them in its OnConfirm callback.
*@

<AppModal IsVisible="IsVisible" Title="Konfiguracja kurierów" Icon="bi bi-gear" Size="xl"
          FlushBody="true" FooterAlignEnd="true" OnClose="HandleCancel">
    <ChildContent>
        @if (IsLoading)
        {
            <div class="app-overlay app-overlay--local">
                <div class="app-spinner"></div>
            </div>
        }

        <table class="app-table app-table--striped courier-config__table">
            <thead>
                <tr>
                    <th>Kurier</th>
                    <th>Auto. FV</th>
                    <th>Generowanie FV start / koniec</th>
                    <th>Waga PL (dół / góra)</th>
                    <th>Waga Exp (dół / góra)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var config in Configurations)
                {
                    <tr @key="config.Courier">
                        <td class="fw-bold">@config.Courier</td>
                        <td>
                            <div class="form-check form-switch m-0">
                                <input class="form-check-input" type="checkbox" @bind="config.AutomaticFvGeneration" disabled="@IsLoading" />
                            </div>
                        </td>
                        <td>
                            <div class="input-group input-group-sm">
                                <input type="time" step="1" class="form-control"
                                       value="@(config.AutomaticFvStart?.ToString(@"hh\:mm\:ss"))"
                                       @onchange="@(e => config.AutomaticFvStart = ParseTime(e.Value))"
                                       disabled="@IsLoading" />
                                <input type="time" step="1" class="form-control"
                                       value="@(config.AutomaticFvEnd?.ToString(@"hh\:mm\:ss"))"
                                       @onchange="@(e => config.AutomaticFvEnd = ParseTime(e.Value))"
                                       disabled="@IsLoading" />
                            </div>
                        </td>
                        <td>
                            <div class="input-group input-group-sm">
                                <input type="number" class="form-control" @bind="config.WeightBottomPL" step="0.01" disabled="@IsLoading" />
                                <input type="number" class="form-control" @bind="config.WeightUpPL" step="0.01" disabled="@IsLoading" />
                            </div>
                        </td>
                        <td>
                            <div class="input-group input-group-sm">
                                <input type="number" class="form-control" @bind="config.WeightBottomExport" step="0.01" disabled="@IsLoading" />
                                <input type="number" class="form-control" @bind="config.WeightUpExport" step="0.01" disabled="@IsLoading" />
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </ChildContent>

    <Footer>
        <button type="button" class="btn btn-outline-secondary" @onclick="HandleCancel" disabled="@IsLoading">Anuluj</button>
        <button type="button" class="btn btn-primary" @onclick="HandleConfirm" disabled="@IsLoading">
            @if (IsLoading)
            {
                <span class="app-spinner app-spinner--sm me-2"></span>
            }
            else
            {
                <i class="bi bi-save me-1"></i>
            }
            Zapisz zmiany
        </button>
    </Footer>
</AppModal>

@code {
    private bool IsVisible { get; set; }
    private bool IsLoading { get; set; }
    private List<CourierConfiguration> Configurations { get; set; } = new();

    private Func<Task>? OnConfirm { get; set; }
    private Func<Task>? OnCancel { get; set; }

    public void Show(List<CourierConfiguration> configs, Func<Task> onConfirm, Func<Task> onCancel)
    {
        Configurations = configs;
        OnConfirm = onConfirm;
        OnCancel = onCancel;
        IsVisible = true;
        StateHasChanged();
    }

    private async Task HandleConfirm()
    {
        try
        {
            IsLoading = true;
            await InvokeAsync(StateHasChanged);

            if (OnConfirm != null)
                await OnConfirm.Invoke();

            IsVisible = false;
        }
        finally
        {
            IsLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task HandleCancel()
    {
        if (IsLoading)
            return;

        if (OnCancel != null)
            await OnCancel.Invoke();

        IsVisible = false;
    }

    private static TimeSpan? ParseTime(object? value)
        => TimeSpan.TryParse(value?.ToString(), out var result) ? result : null;
}
