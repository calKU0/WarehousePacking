@using WarehousePacking.Contracts.DTOs
@using WarehousePacking.Server.Helpers
@using WarehousePacking.Server.Services
@using WarehousePacking.Contracts.Data.Enums
@using WarehousePacking.Server.Settings
@inject PackingService PackingService
@inject WorkstationService WorkstationService

@*
    Supervisor view of JLs currently taken for packing, with a read-only
    preview of each one's progress and the ability to release them.
*@

<AppModal IsVisible="Show" Title="Kuwety podjęte do realizacji" Icon="bi bi-hand-index"
          Size="xl" FlushBody="true" FooterAlignEnd="true" OnClose="Close">
    <ChildContent>
        @if (IsLoading)
        {
            <div class="app-empty">
                <div class="app-spinner"></div>
                <p class="app-empty__text">Ładowanie...</p>
            </div>
        }
        else if (JlList.Count == 0)
        {
            <div class="app-empty">
                <i class="bi bi-inbox app-empty__icon"></i>
                <p class="app-empty__text">Brak kuwet podjętych do realizacji.</p>
            </div>
        }
        else
        {
            <table class="app-table app-table--striped">
                <thead>
                    <tr>
                        <th></th>
                        <th>Nazwa</th>
                        <th>Użytkownik</th>
                        <th>Nr. stanowiska</th>
                        <th>Kurier</th>
                        <th>Klient</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var jl in JlList)
                    {
                        var key = BuildSelectionKey(jl.Name, jl.User);
                        <tr class="@(SelectedJlKeys.Contains(key) ? "is-highlight" : null)" @key="key">
                            <td>
                                <input type="checkbox"
                                       class="form-check-input"
                                       checked="@SelectedJlKeys.Contains(key)"
                                       @onchange="e => ToggleSelection(jl.Name, jl.User, e.Value)" />
                            </td>
                            <td class="app-table__code">@jl.Name</td>
                            <td>@jl.User</td>
                            <td>@jl.StationNumber</td>
                            <td>@jl.Courier.GetDescription()</td>
                            <td>@jl.ClientName</td>
                            <td class="text-end text-nowrap">
                                <button type="button" class="btn btn-sm btn-outline-primary me-1" @onclick="() => ShowPreview(jl)">
                                    <i class="bi bi-eye me-1"></i>Podgląd
                                </button>
                                <button type="button" class="btn btn-sm btn-danger" @onclick="() => ConfirmRemove(jl)">
                                    <i class="bi bi-trash me-1"></i>Usuń
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </ChildContent>

    <Footer>
        @if (SelectedJlKeys.Any())
        {
            <button type="button" class="btn btn-danger" @onclick="ConfirmRemoveSelected">
                <i class="bi bi-trash me-1"></i>Usuń zaznaczone (@SelectedJlKeys.Count)
            </button>
        }
        <button type="button" class="btn btn-secondary" @onclick="Close">Zamknij</button>
    </Footer>
</AppModal>

<AppModal IsVisible="ShowPreviewModal" Title="@($"Podgląd pakowania: {PreviewJlName}")"
          Icon="bi bi-eye" Size="xl" OnClose="ClosePreview">
    <ChildContent>
        @if (PreviewLoading)
        {
            <div class="app-empty">
                <div class="app-spinner"></div>
                <p class="app-empty__text">Ładowanie...</p>
            </div>
        }
        else
        {
            <div class="jl-preview">
                <section class="app-card">
                    <div class="app-card__header app-card__header--accent">
                        <span class="app-card__title"><i class="bi bi-box-seam"></i>Do spakowania</span>
                    </div>
                    <div class="app-scroll jl-preview__scroll">
                        <table class="app-table app-table--striped">
                            <thead>
                                <tr>
                                    <th>Kod</th>
                                    <th class="app-table__num">Ilość</th>
                                    <th>Nazwa</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (PreviewNotPackedItems.Count == 0)
                                {
                                    <tr><td colspan="3"><div class="app-empty"><p class="app-empty__text">Brak pozycji</p></div></td></tr>
                                }
                                else
                                {
                                    @foreach (var item in PreviewNotPackedItems)
                                    {
                                        <tr>
                                            <td class="app-table__code">@item.ItemCode</td>
                                            <td class="app-table__num">@item.JlQuantity</td>
                                            <td>@item.ItemName</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </section>

                <section class="app-card">
                    <div class="app-card__header">
                        <span class="app-card__title"><i class="bi bi-bag-check"></i>Spakowane</span>
                    </div>
                    <div class="app-scroll jl-preview__scroll">
                        <table class="app-table app-table--striped">
                            <thead>
                                <tr>
                                    <th>Kod</th>
                                    <th class="app-table__num">Ilość</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (PreviewPackedItems.Count == 0)
                                {
                                    <tr><td colspan="2"><div class="app-empty"><p class="app-empty__text">Brak pozycji</p></div></td></tr>
                                }
                                else
                                {
                                    @foreach (var item in PreviewPackedItems)
                                    {
                                        <tr>
                                            <td class="app-table__code">@item.ItemCode</td>
                                            <td class="app-table__num">@item.JlQuantity</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
            </div>
        }
    </ChildContent>
</AppModal>

<ConfirmDialog @ref="ConfirmDialog" />

<Toast @ref="Toast"/>

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public EventCallback<bool> ShowChanged { get; set; }

    private List<JlInProgressDto> JlList = new();
    private ConfirmDialog ConfirmDialog = new();
    private JlInProgressDto? SelectedJl { get; set; }
    private HashSet<string> SelectedJlKeys { get; set; } = new(StringComparer.OrdinalIgnoreCase);
    private WorkstationSettings Settings = new();
    private Toast Toast = new();
    private bool IsLoading { get; set; }

    private bool ShowPreviewModal { get; set; }
    private bool PreviewLoading { get; set; }
    private string PreviewJlName { get; set; } = string.Empty;
    private List<JlItemDto> PreviewPackedItems { get; set; } = new();
    private List<JlItemDto> PreviewNotPackedItems { get; set; } = new();

    public async Task ShowModal()
    {
        Show = true;
        StateHasChanged();
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            IsLoading = true;
            Settings = await WorkstationService.GetSettingsAsync();
            JlList = await PackingService.GetJlListInProgress();
            SelectedJlKeys.RemoveWhere(key => !JlList.Any(x => string.Equals(BuildSelectionKey(x.Name, x.User), key, StringComparison.OrdinalIgnoreCase)));
        }
        catch (Exception ex)
        {
            Toast.Show("Błąd!", $"Błąd przy próbie pobrania listy kuwet: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ShowPreview(JlInProgressDto jl)
    {
        try
        {
            ShowPreviewModal = true;
            PreviewLoading = true;
            PreviewJlName = jl.Name;
            PreviewPackedItems = new List<JlItemDto>();
            PreviewNotPackedItems = new List<JlItemDto>();
            await InvokeAsync(StateHasChanged);

            if (string.IsNullOrWhiteSpace(Settings.StationNumber))
                Settings = await WorkstationService.GetSettingsAsync();

            var allItems = await PackingService.GetJlItems(jl.Name) ?? new List<JlItemDto>();
            var packedItems = await PackingService.GetPackingJlItems(jl.PackageId) ?? new List<JlItemDto>();

            PreviewPackedItems = packedItems
                .GroupBy(x => new { x.ItemCode, x.DocumentId, x.ErpPositionNumber })
                .Select(g =>
                {
                    var first = g.First();
                    first.JlQuantity = g.Sum(x => x.JlQuantity);
                    return first;
                })
                .ToList();

            PreviewNotPackedItems = CalculateNotPacked(allItems, PreviewPackedItems);
        }
        catch (Exception ex)
        {
            Toast.Show("Błąd!", $"Błąd przy podglądzie zawartości: {ex.Message}");
            ShowPreviewModal = false;
        }
        finally
        {
            PreviewLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static List<JlItemDto> CalculateNotPacked(List<JlItemDto> allItems, List<JlItemDto> packedItems)
    {
        var packedLookup = packedItems
            .GroupBy(x => BuildKey(x.ItemCode, x.DocumentId, x.ErpPositionNumber))
            .ToDictionary(g => g.Key, g => g.Sum(GetEffectiveQuantity));

        var packedByItemCode = packedItems
            .GroupBy(x => Normalize(x.ItemCode))
            .ToDictionary(g => g.Key, g => g.Sum(GetEffectiveQuantity));

        var notPacked = new List<JlItemDto>();
        foreach (var item in allItems)
        {
            var key = BuildKey(item.ItemCode, item.DocumentId, item.ErpPositionNumber);
            var packedQty = packedLookup.TryGetValue(key, out var value)
                ? value
                : packedByItemCode.TryGetValue(Normalize(item.ItemCode), out var byItemCode)
                    ? byItemCode
                    : 0;

            var remaining = GetEffectiveQuantity(item) - packedQty;
            if (remaining <= 0)
                continue;

            var clone = CloneItem(item);
            clone.JlQuantity = remaining;
            notPacked.Add(clone);
        }

        return notPacked;
    }

    private static JlItemDto CloneItem(JlItemDto source)
    {
        return new JlItemDto
        {
            JlCode = source.JlCode,
            JlEanCode = source.JlEanCode,
            ItemErpId = source.ItemErpId,
            ItemWmsId = source.ItemWmsId,
            ErpPositionNumber = source.ErpPositionNumber,
            ItemCode = source.ItemCode,
            ItemName = source.ItemName,
            ItemEan = source.ItemEan?.ToList() ?? new List<string>(),
            ItemUnit = source.ItemUnit,
            ItemType = source.ItemType,
            ItemImage = source.ItemImage,
            ItemWeight = source.ItemWeight,
            ItemVolume = source.ItemVolume,
            PackedWMS = source.PackedWMS,
            SupplierCode = source.SupplierCode?.ToList() ?? new List<string>(),
            ClientErpId = source.ClientErpId,
            AddressName = source.AddressName,
            AddressCity = source.AddressCity,
            AddressStreet = source.AddressStreet,
            AddressPostalCode = source.AddressPostalCode,
            AddressCountry = source.AddressCountry,
            ClientName = source.ClientName,
            ClientSymbol = source.ClientSymbol,
            DestinationCountry = source.DestinationCountry,
            PackingRequirements = source.PackingRequirements,
            ScanDate = source.ScanDate,
            CourierName = source.CourierName,
            Courier = source.Courier,
            LogoCourier = source.LogoCourier,
            ShipmentServices = source.ShipmentServices,
            BatchId = source.BatchId,
            BatchNumber = source.BatchNumber,
            TermValidity = source.TermValidity,
            ErpDocumentId = source.ErpDocumentId,
            DocumentId = source.DocumentId,
            DocumentType = source.DocumentType,
            DocumentQuantity = source.DocumentQuantity,
            JlQuantity = source.JlQuantity
        };
    }

    private static string BuildKey(string itemCode, int documentId, int position)
        => $"{Normalize(itemCode)}|{documentId}|{position}";

    private static decimal GetEffectiveQuantity(JlItemDto item)
        => item.JlQuantity > 0 ? item.JlQuantity : item.DocumentQuantity;

    private static string Normalize(string? value)
        => string.IsNullOrWhiteSpace(value) ? string.Empty : value.Trim().ToUpperInvariant();

    private void ClosePreview()
    {
        ShowPreviewModal = false;
        PreviewLoading = false;
        PreviewPackedItems = new List<JlItemDto>();
        PreviewNotPackedItems = new List<JlItemDto>();
        PreviewJlName = string.Empty;
        StateHasChanged();
    }

    private void ConfirmRemove(JlInProgressDto jl)
    {
        SelectedJl = jl;

        ConfirmDialog.Show(
            title: "Usuń kuwetę",
            message: "Czy na pewno chcesz usunąć kuwetę z realizacji?",
            onConfirm: async () =>
            {
                if (SelectedJl == null)
                    return;

                try
                {
                    await PackingService.RemoveJlRealization(SelectedJl.Name, SelectedJl.User, true);
                    Toast.Show("Sukces!", "Kuweta została usunięta z realizacji.", ToastType.Success);
                }
                catch (Exception ex)
                {
                    Toast.Show("Błąd!", $"Błąd przy próbie usuwania JL z realizacji: {ex.Message}");
                }
                finally
                {
                    SelectedJl = null;
                    SelectedJlKeys.Remove(BuildSelectionKey(jl.Name, jl.User));
                    await LoadData();
                    await InvokeAsync(StateHasChanged);
                }
            },
            onCancel: async () =>
            {
                SelectedJl = null;
                await InvokeAsync(StateHasChanged);
            }
        );
    }

    private void ToggleSelection(string? jlName, string? username, object? isChecked)
    {
        var selectionKey = BuildSelectionKey(jlName, username);
        var value = isChecked is bool b && b;
        if (value)
            SelectedJlKeys.Add(selectionKey);
        else
            SelectedJlKeys.Remove(selectionKey);
    }

    private void ConfirmRemoveSelected()
    {
        var selectedRealizations = SelectedJlKeys
            .Select(key =>
            {
                var parts = key.Split('|', 2);
                return new { Name = parts.ElementAtOrDefault(0) ?? string.Empty, User = parts.ElementAtOrDefault(1) ?? string.Empty };
            })
            .ToList();

        if (!selectedRealizations.Any())
            return;

        ConfirmDialog.Show(
            title: "Usuń zaznaczone kuwety",
            message: $"Czy na pewno chcesz usunąć {selectedRealizations.Count} zaznaczonych realizacji?",
            onConfirm: async () =>
            {
                try
                {
                    foreach (var item in selectedRealizations)
                    {
                        await PackingService.RemoveJlRealization(item.Name, item.User, true);
                    }

                    SelectedJlKeys.Clear();
                    Toast.Show("Sukces!", "Zaznaczone realizacje zostały usunięte.", ToastType.Success);
                }
                catch (Exception ex)
                {
                    Toast.Show("Błąd!", $"Błąd przy usuwaniu zaznaczonych realizacji: {ex.Message}");
                }
                finally
                {
                    await LoadData();
                    await InvokeAsync(StateHasChanged);
                }
            },
            onCancel: async () =>
            {
                await InvokeAsync(StateHasChanged);
            }
        );
    }

    private static string BuildSelectionKey(string? jlName, string? username)
        => $"{jlName}|{username}";

    private void Close()
    {
        Show = false;
        SelectedJl = null;
        StateHasChanged();
    }
}
