@using WarehousePacking.Contracts.DTOs
@using WarehousePacking.Contracts.Data.Enums
@using WarehousePacking.Server.Services
@inject ClientPrinterService ClientPrinterService
@*
    Offers other JLs going to the same address so they can be packed together.
    Returns the selected JLs, or an empty list when merging is skipped.
*@

<AppModal IsVisible="IsVisible" Title="Połącz kuwety" Icon="bi bi-union" Size="lg" OnClose="Cancel">
    <ChildContent>
        <p class="text-muted">Wybierz kuwety do połączenia z wybraną:</p>

        <table class="app-table app-table--striped app-table--interactive merge-jls__table">
            <thead>
                <tr>
                    <th></th>
                    <th>Jl</th>
                    <th class="app-table__num">Waga</th>
                    <th>Lokalizacja</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var jl in AvailableJls)
                {
                    var isSelected = SelectedJlsNames.Contains((jl.Code, jl.Location));
                    var rowKey = jl.Code + "|" + jl.Location;
                    <tr class="@(isSelected ? "is-highlight" : null)"
                        @key="rowKey"
                        @onclick="() => ToggleSelection(jl.Code, jl.Location)">
                        <td>
                            <input class="form-check-input"
                                   type="checkbox"
                                   checked="@isSelected"
                                   @onclick:stopPropagation="true"
                                   @onchange="e => OnCheckboxChanged(e.Value!, jl.Code, jl.Location)" />
                        </td>
                        <td class="app-table__code">@jl.Code</td>
                        <td class="app-table__num">@jl.Weight.ToString("0.##") kg</td>
                        <td>@jl.Location</td>
                    </tr>
                }
            </tbody>
        </table>
    </ChildContent>

    <Footer>
        <button type="button" class="btn btn-secondary" @onclick="SkipMerge">Nie łącz kuwet</button>
        <button type="button" class="btn btn-secondary" @onclick="PrintList" disabled="@IsPrinting">
            @if (IsPrinting)
            {
                <span class="app-spinner app-spinner--sm me-2"></span>
            }
            else
            {
                <i class="bi bi-printer me-1"></i>
            }
            Drukuj listę
        </button>
        <button type="button" class="btn btn-primary" @onclick="Confirm">Połącz zaznaczone kuwety</button>
    </Footer>
</AppModal>

@code {
    private TaskCompletionSource<List<(string jlName, string locationCode)>>? _tcs;

    private bool IsVisible = false;
    private bool IsPrinting = false;
    private List<JlData> AvailableJls = new();
    private List<(string jlName, string locationCode)> SelectedJlsNames = new();
    private string Printer = string.Empty;
    private JlData? BaseJl;

    public bool WasCancelled { get; private set; }

    public Task<List<(string jlName, string locationCode)>> Show(List<JlData> availableJls, string printer, JlData? baseJl = null)
    {
        AvailableJls = availableJls;
        SelectedJlsNames = new List<(string jlName, string locationCode)>();
        Printer = printer;
        BaseJl = baseJl;
        WasCancelled = false;
        IsVisible = true;
        StateHasChanged();

        _tcs = new TaskCompletionSource<List<(string jlName, string locationCode)>>();
        return _tcs.Task;
    }

    private void OnCheckboxChanged(object value, string jlName, string location)
        => SetSelected(jlName, location, value is bool b && b);

    /// <summary>Tapping anywhere on the row toggles it — a bigger touch target.</summary>
    private void ToggleSelection(string jlName, string location)
        => SetSelected(jlName, location, !SelectedJlsNames.Contains((jlName, location)));

    private void SetSelected(string jlName, string location, bool isSelected)
    {
        var key = (jlName, location);

        if (isSelected)
        {
            if (!SelectedJlsNames.Contains(key))
                SelectedJlsNames.Add(key);
        }
        else
        {
            SelectedJlsNames.Remove(key);
        }
    }

    private void Cancel()
    {
        WasCancelled = true;
        IsVisible = false;
        _tcs?.TrySetResult(new List<(string jlName, string locationCode)>());
        StateHasChanged();
    }

    private void SkipMerge()
    {
        IsVisible = false;
        _tcs?.TrySetResult(new List<(string jlName, string locationCode)>());
        StateHasChanged();
    }

    private void Confirm()
    {
        IsVisible = false;
        _tcs?.TrySetResult(SelectedJlsNames);
        StateHasChanged();
    }

    private async Task PrintList()
    {
        if (IsPrinting || string.IsNullOrWhiteSpace(Printer) || !AvailableJls.Any())
            return;

        IsPrinting = true;
        try
        {
            var zpl = BuildListZpl(AvailableJls, BaseJl);
            var zplBase64 = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(zpl));
            await ClientPrinterService.PrintAsync(Printer, PrintDataType.ZPL.ToString(), zplBase64);
        }
        finally
        {
            IsPrinting = false;
            StateHasChanged();
        }
    }

    private static string BuildListZpl(List<JlData> jls, JlData? baseJl)
    {
        // Sized to fit a narrow (3") label's printable area; also prints fine on
        // wider labels (just leaves extra right margin). Everything — the header
        // rule and the right-aligned weight — is kept within contentWidth so
        // nothing runs off the edge.
        const int marginX = 16;
        const int marginTop = 24;
        const int contentWidth = 560;
        const int boxSize = 28;
        const int codeFontSize = 34;
        const int locationFontSize = 24;
        const int rowHeight = 74;
        const int headerFontSize = 40;

        var sb = new System.Text.StringBuilder();
        sb.AppendLine("^XA");
        // Reset label home / shift: these persist on the printer across jobs until
        // explicitly changed, so a previous (e.g. courier) label can otherwise leave
        // a stale offset that makes our own margins look like they do nothing.
        sb.AppendLine("^LH0,0");
        sb.AppendLine("^LS0");

        // Header
        sb.AppendLine($"^CF0,{headerFontSize}");
        sb.AppendLine($"^FO{marginX},{marginTop}^FDLista kuwet do polaczenia^FS");
        sb.AppendLine($"^FO{marginX},{marginTop + 44}^GB{contentWidth},3,3^FS");

        // Subheader: print time + item count
        var totalCount = jls.Count + (baseJl is not null ? 1 : 0);
        sb.AppendLine("^CF0,22");
        sb.AppendLine($"^FO{marginX},{marginTop + 56}^FD{DateTime.Now:dd.MM.yyyy HH:mm}   Pozycji: {totalCount}^FS");

        int y = marginTop + 94;
        var textX = marginX + boxSize + 14;
        // Reserve room on the right for the weight so a long code can't run into it.
        var codeWidth = contentWidth - boxSize - 14 - 140;

        void AppendRow(string code, decimal weight, string location)
        {
            // checkbox always unchecked (outline only)
            sb.AppendLine($"^FO{marginX},{y}^GB{boxSize},{boxSize},2^FS");

            // Code (clipped to a single line so it never collides with the weight)
            sb.AppendLine($"^CF0,{codeFontSize}");
            sb.AppendLine($"^FO{textX},{y - 4}^FB{codeWidth},1,0,L,0^FD{code}^FS");

            // Weight as a right-aligned column on the code line, within contentWidth
            var weightText = $"{weight.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)} kg";
            sb.AppendLine($"^FO{marginX},{y - 4}^FB{contentWidth},1,0,R,0^FD{weightText}^FS");

            // Location on the second line, kept inside contentWidth
            sb.AppendLine($"^CF0,{locationFontSize}");
            sb.AppendLine($"^FO{textX},{y + codeFontSize + 2}^FB{contentWidth - boxSize - 14},1,0,L,0^FDLokalizacja: {location}^FS");

            y += rowHeight;
        }

        if (baseJl is not null)
            AppendRow(baseJl.Code, baseJl.Weight, baseJl.Location);

        foreach (var jl in jls)
        {
            AppendRow(jl.Code, jl.Weight, jl.Location);
        }

        sb.AppendLine("^XZ");
        return sb.ToString();
    }
}
