@using WarehousePacking.Contracts.DTOs
@using WarehousePacking.Contracts.Data.Enums
@using WarehousePacking.Server.Services
@inject ClientPrinterService ClientPrinterService
@if (IsVisible)
{
    <div class="modal-backdrop @(IsVisible ? "show" : "")">
        <div class="modal-container">
            <div class="modal-header">
                <h5 class="modal-title">Połącz kuwety</h5>
                <button type="button" class="btn-close" @onclick="Cancel" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Wybierz kuwety do połączenia z wybraną:</p>
                <table class="table table-hover table-tall">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Jl</th>
                            <th>Lokalizacja</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var jl in AvailableJls)
                        {
                            <tr>
                                <td>
                                    <input type="checkbox" checked="@SelectedJlsNames.Contains((jl.Code, jl.Location))"
                                           @onchange="e => OnCheckboxChanged(e.Value!, jl.Code, jl.Location)" />
                                </td>
                                <td>@jl.Code</td>
                                <td>@jl.Location</td>
                            </tr>
                        }

                    </tbody>
                </table>
            </div>
            <div class="modal-footer d-flex gap-2 w-100">
                <button class="btn btn-primary btn-lg tall-btn" style="flex: 6;" @onclick="Confirm">Połącz zaznaczone kuwety</button>
                <button class="btn btn-outline-secondary btn-lg tall-btn" style="flex: 3;" @onclick="PrintList" disabled="@IsPrinting">Drukuj listę</button>
                <button class="btn btn-secondary btn-lg tall-btn" style="flex: 3;" @onclick="SkipMerge">Nie łącz kuwet</button>
            </div>
        </div>
    </div>
}

@code {
    private TaskCompletionSource<List<(string jlName, string locationCode)>>? _tcs;

    private bool IsVisible = false;
    private bool IsPrinting = false;
    private List<JlData> AvailableJls = new();
    private List<(string jlName, string locationCode)> SelectedJlsNames = new();
    private string Printer = string.Empty;
    private JlData? BaseJl;

    public bool WasCancelled { get; private set; }

    public Task<List<(string jlName, string locationCode)>> Show(List<JlData> availableJls, string printer, JlData? baseJl = null)
    {
        AvailableJls = availableJls;
        SelectedJlsNames = new List<(string jlName, string locationCode)>();
        Printer = printer;
        BaseJl = baseJl;
        WasCancelled = false;
        IsVisible = true;
        StateHasChanged();

        _tcs = new TaskCompletionSource<List<(string jlName, string locationCode)>>();
        return _tcs.Task;
    }

    private void OnCheckboxChanged(object value, string jlName, string location)
    {
        bool isChecked = (bool)value;
        if (isChecked)
        {
            if (!SelectedJlsNames.Contains((jlName, location)))
                SelectedJlsNames.Add((jlName, location));
        }
        else
        {
            SelectedJlsNames.Remove((jlName, location));
        }
    }

    private void Cancel()
    {
        WasCancelled = true;
        IsVisible = false;
        _tcs?.TrySetResult(new List<(string jlName, string locationCode)>());
        StateHasChanged();
    }

    private void SkipMerge()
    {
        IsVisible = false;
        _tcs?.TrySetResult(new List<(string jlName, string locationCode)>());
        StateHasChanged();
    }

    private void Confirm()
    {
        IsVisible = false;
        _tcs?.TrySetResult(SelectedJlsNames);
        StateHasChanged();
    }

    private async Task PrintList()
    {
        if (IsPrinting || string.IsNullOrWhiteSpace(Printer) || !AvailableJls.Any())
            return;

        IsPrinting = true;
        try
        {
            var zpl = BuildListZpl(AvailableJls, BaseJl);
            var zplBase64 = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(zpl));
            await ClientPrinterService.PrintAsync(Printer, PrintDataType.ZPL.ToString(), zplBase64);
        }
        finally
        {
            IsPrinting = false;
            StateHasChanged();
        }
    }

    private static string BuildListZpl(List<JlData> jls, JlData? baseJl)
    {
        const int marginX = 0;
        const int marginTop = 40;
        const int contentWidth = 740;
        const int boxSize = 30;
        const int codeFontSize = 38;
        const int locationFontSize = 26;
        const int rowHeight = 80;

        var sb = new System.Text.StringBuilder();
        sb.AppendLine("^XA");
        // Reset label home / shift: these persist on the printer across jobs until
        // explicitly changed, so a previous (e.g. courier) label can otherwise leave
        // a stale offset that makes our own margins look like they do nothing.
        sb.AppendLine("^LH0,0");
        sb.AppendLine("^LS0");

        // Header
        sb.AppendLine("^CF0,46");
        sb.AppendLine($"^FO{marginX},{marginTop}^FDLista kuwet do polaczenia^FS");
        sb.AppendLine($"^FO{marginX},{marginTop + 50}^GB{contentWidth},3,3^FS");

        // Subheader: print time + item count
        var totalCount = jls.Count + (baseJl is not null ? 1 : 0);
        sb.AppendLine("^CF0,22");
        sb.AppendLine($"^FO{marginX},{marginTop + 64}^FD{DateTime.Now:dd.MM.yyyy HH:mm}   Pozycji: {totalCount}^FS");

        int y = marginTop + 104;
        var textX = marginX + boxSize + 16;

        void AppendRow(string code, string location)
        {
            // checkbox always unchecked (outline only)
            sb.AppendLine($"^FO{marginX},{y}^GB{boxSize},{boxSize},2^FS");

            sb.AppendLine($"^CF0,{codeFontSize}");
            sb.AppendLine($"^FO{textX},{y - 4}^FD{code}^FS");

            sb.AppendLine($"^CF0,{locationFontSize}");
            sb.AppendLine($"^FO{textX},{y + codeFontSize + 2}^FDLokalizacja: {location}^FS");

            y += rowHeight;
        }

        if (baseJl is not null)
            AppendRow(baseJl.Code, baseJl.Location);

        foreach (var jl in jls)
        {
            AppendRow(jl.Code, jl.Location);
        }

        sb.AppendLine("^XZ");
        return sb.ToString();
    }
}
