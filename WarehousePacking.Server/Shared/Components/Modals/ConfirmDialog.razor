@*
    Generic confirm/cancel prompt driven by callbacks supplied at Show() time.
*@

<AppModal IsVisible="IsVisible" Title="@Title" Icon="bi bi-question-circle" Size="sm" ShowClose="false">
    <ChildContent>
        <p class="mb-0">@Message</p>
    </ChildContent>


    <Footer>
        <button type="button"
                class="btn btn-danger"
                style="flex: 7;"
                disabled="@IsProcessing"
                @onclick="OnConfirm">
            @if (IsProcessing)
            {
                <span class="app-spinner app-spinner--sm me-2"></span>
                <span>Przetwarzanie...</span>
            }
            else
            {
                <span>Potwierdź</span>
            }
        </button>
        <button type="button" class="btn btn-secondary" style="flex: 3;" @onclick="OnCancel">Anuluj</button>
    </Footer>
</AppModal>

@code {
    private string Title { get; set; } = string.Empty;
    private string Message { get; set; } = string.Empty;
    protected bool IsVisible { get; set; }

    private bool IsProcessing;

    private Func<Task> ConfirmAction { get; set; } = () => Task.CompletedTask;
    private Func<Task> CancelAction { get; set; } = () => Task.CompletedTask;

    public void Show(string title = "Potwierdzenie", string message = "Czy jesteś pewny?", Func<Task>? onConfirm = null, Func<Task>? onCancel = null)
    {
        Title = title;
        Message = message;
        ConfirmAction = onConfirm ?? (() => Task.CompletedTask);
        CancelAction = onCancel ?? (() => Task.CompletedTask);
        IsVisible = true;
        StateHasChanged();
    }

    public void Hide()
    {
        IsVisible = false;
        StateHasChanged();
    }

    private async Task OnConfirm()
    {
        if (IsProcessing)
            return;

        try
        {
            IsProcessing = true;
            await InvokeAsync(StateHasChanged);

            await ConfirmAction.Invoke();
            Hide();
        }
        finally
        {
            IsProcessing = false;
        }
    }

    private async Task OnCancel()
    {
        await CancelAction.Invoke();
        Hide();
    }
}
