@using WarehousePacking.Contracts.DTOs
@using WarehousePacking.Contracts.Data.Enums
@inject IJSRuntime JSRuntime

@*
    Quantity entry for a scanned product. Touch-first: an on-screen numeric
    keypad is the primary input, since operators often wear gloves.
*@

<AppModal IsVisible="IsVisible" Size="lg" ShowHeader="false" OnClose="Close">
    <ChildContent>
        <div class="product-select">

            <header class="product-select__summary">
                <div class="product-select__thumb">
                    <img src="@(Product?.ItemImage ?? NoImage)" alt="@Product?.ItemName" />
                </div>

                <div class="product-select__details">
                    <h5 class="product-select__name">@Product?.ItemName</h5>

                    <dl class="product-select__facts">
                        <dt>Kod</dt>
                        <dd class="app-table__code">@Product?.ItemCode</dd>

                        <dt>Kod dostawcy</dt>
                        <dd>@(Product?.SupplierCode?.FirstOrDefault() ?? "-")</dd>

                        <dt>Waga</dt>
                        <dd>@Product?.ItemWeight kg</dd>
                    </dl>

                    <div class="product-select__quantities">
                        <span class="app-chip">
                            <span class="app-chip__label">Na dok.</span>
                            <span class="app-chip__value">@FormatQuantity(Product?.DocumentQuantity) @Product?.ItemUnit</span>
                        </span>
                        <span class="app-chip app-chip--brand">
                            <span class="app-chip__label">W kuwecie</span>
                            <span class="app-chip__value">@FormatQuantity(Product?.JlQuantity) @Product?.ItemUnit</span>
                        </span>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(ProductTypeImage))
                {
                    <img class="product-select__type" src="@ProductTypeImage" alt="@Product?.ItemType" title="@Product?.ItemType" />
                }

                <button type="button" class="app-modal__close product-select__close" aria-label="Zamknij" @onclick="Close">
                    <i class="bi bi-x-lg"></i>
                </button>
            </header>

            <div class="product-select__entry">
                <label class="app-section-label" for="qtyInput">Podaj ilość</label>
                <input id="qtyInput"
                       type="text"
                       inputmode="decimal"
                       class="form-control product-select__input"
                       @ref="_quantityInputRef"
                       @bind="InputQuantity"
                       autofocus />
            </div>

            <NumericKeypad @bind-Value="InputQuantity"
                           AllowDecimal="true"
                           OnEnter="Confirm"
                           IsBusy="IsSubmitting"
                           EnterDisabled="IsSubmitting" />

            @* Hosted inside the dialog on purpose: a popover rendered outside an
               open modal <dialog> lands in the top layer but stays inert, so its
               close button never fires. Inside the dialog's subtree it is both
               interactive and still painted on top. *@
            <Toast @ref="Toast" />
        </div>
    </ChildContent>
</AppModal>

@code {
    private const string NoImage = "images/no-image.jpeg";

    [Parameter] public EventCallback<decimal> OnConfirm { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private JlItemDto? Product { get; set; }
    private ElementReference _quantityInputRef;
    private string InputQuantity = string.Empty;
    private Toast Toast = new();
    private bool IsVisible;
    private bool IsSubmitting;

    private string ProductTypeImage => Product?.ItemType switch
    {
        "Ciężki" => "images/product_types/heavy.jpg",
        "Delikatny" => "images/product_types/glass.jpg",
        _ => string.Empty
    };

    // Whole quantities show without a trailing ",0"; fractional ones keep only
    // the digits they need. Mirrors PackingTables so the screen is consistent.
    private static string FormatQuantity(decimal? value)
    {
        var qty = value ?? 0m;
        return qty == decimal.Truncate(qty) ? qty.ToString("0") : qty.ToString("0.###");
    }

    public async Task Show(JlItemDto product)
    {
        Product = product;
        // Pre-fill the common case of a single unit so the operator can just confirm.
        InputQuantity = product.JlQuantity == 1 ? product.JlQuantity.ToString() : string.Empty;
        IsVisible = true;
        IsSubmitting = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task Confirm()
    {
        if (IsSubmitting || Product is null)
            return;

        var parsed = decimal.TryParse(
            InputQuantity.Replace(',', '.'),
            System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture,
            out var qty);

        if (!parsed)
        {
            Toast.Show("Uwaga", "Podano błędną wartość w polu ilość. Spróbuj wprowadzić ilość ponownie.", ToastType.Warning);
            return;
        }

        if (qty > Product.JlQuantity)
        {
            Toast.Show("Uwaga", "Nie możesz spakować ilości większej niż jest w kuwecie! Zmień ilość i spróbuj ponownie.", ToastType.Warning);
            return;
        }

        IsSubmitting = true;
        try
        {
            await OnConfirm.InvokeAsync(qty);
            IsVisible = false;
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private async Task Close()
    {
        if (OnClose.HasDelegate)
            await OnClose.InvokeAsync();

        IsVisible = false;
    }
}
