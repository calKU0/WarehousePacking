@using System.Net
@using WarehousePacking.Contracts.DTOs
@inject ShipmentService ShipmentService
@inject IJSRuntime JSRuntime

@*
    Manual shipment setup: pick a recipient address (required) and optionally an
    invoice to attach. Address must be chosen first; the invoice search unlocks
    afterwards.
*@

<AppModal IsVisible="IsVisible" Title="Wybierz adres i (opcjonalnie) fakturę" Icon="bi bi-geo-alt" Size="xl" OnClose="Hide">
    <ChildContent>
        <div class="address-invoice">

            @* ----- Address ------------------------------------------------ *@
            <section class="address-invoice__col">
                <h6 class="app-section-label mb-2">Adres odbiorcy</h6>

                <div class="app-scan mb-2 @(LeftDisabled ? "is-disabled" : null)">
                    <span class="app-scan__icon" aria-hidden="true"><i class="bi bi-search"></i></span>
                    <input class="app-scan__input"
                           placeholder="Szukaj adresu..."
                           value="@AddressSearch"
                           @oninput="OnAddressInput"
                           @ref="AddressInputRef"
                           disabled="@LeftDisabled"
                           autocomplete="off"
                           autofocus />
                </div>

                <div class="address-invoice__status">
                    @if (IsAddressLoading)
                    {
                        <span class="app-spinner app-spinner--sm me-1"></span>
                        <span>Ładowanie...</span>
                    }
                </div>

                <div class="app-card app-card--flush">
                    <div class="address-invoice__scroll">
                        <table class="app-table app-table--striped app-table--interactive">
                            <thead>
                                <tr>
                                    <th>Akronim</th>
                                    <th>Nazwa</th>
                                    <th>Miasto</th>
                                    <th>Ulica</th>
                                </tr>
                            </thead>
                            <tbody class="@(LeftDisabled ? "is-disabled" : null)">
                                @if (AddressResults != null)
                                {
                                    @foreach (var item in AddressResults)
                                    {
                                        <tr @onclick="() => SelectRecipient(item)">
                                            <td class="app-table__code">@item.Acronym</td>
                                            <td>@item.Name</td>
                                            <td>@item.City</td>
                                            <td>@item.Street</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="address-invoice__chosen">
                    @if (SelectedRecipient != null)
                    {
                        <div class="alert alert-success mb-0 py-2">
                            <i class="bi bi-check-circle me-1"></i>Wybrano adres: <strong>@SelectedRecipient.Name</strong>
                        </div>
                    }
                </div>
            </section>

            @* ----- Invoice ------------------------------------------------ *@
            <section class="address-invoice__col">
                <h6 class="app-section-label mb-2">Faktura (opcjonalne)</h6>

                <div class="app-scan mb-2 @(RightDisabled ? "is-disabled" : null)">
                    <span class="app-scan__icon" aria-hidden="true"><i class="bi bi-search"></i></span>
                    <input class="app-scan__input"
                           placeholder="Szukaj faktury..."
                           value="@InvoiceSearch"
                           @oninput="OnInvoiceInput"
                           @ref="InvoiceInputRef"
                           disabled="@RightDisabled"
                           autocomplete="off" />
                </div>

                <div class="address-invoice__status">
                    @if (IsInvoiceLoading)
                    {
                        <span class="app-spinner app-spinner--sm me-1"></span>
                        <span>Ładowanie...</span>
                    }
                </div>

                <div class="app-card app-card--flush">
                    <div class="address-invoice__scroll">
                        <table class="app-table app-table--striped app-table--interactive">
                            <thead>
                                <tr>
                                    <th>Nazwa</th>
                                    <th>Klient</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (InvoiceResults != null)
                                {
                                    @foreach (var item in InvoiceResults)
                                    {
                                        <tr @onclick="() => SelectInvoice(item)">
                                            <td class="app-table__code">@item.InvoiceName</td>
                                            <td>@item.ClientName</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="address-invoice__chosen">
                    @if (SelectedInvoice != null)
                    {
                        <div class="alert alert-info mb-0 py-2">
                            <i class="bi bi-receipt me-1"></i>Wybrano fakturę: <strong>@SelectedInvoice.InvoiceName</strong>
                        </div>
                    }
                </div>
            </section>
        </div>
    </ChildContent>

    <Footer>
        <button type="button" class="btn btn-secondary" @onclick="Hide">Zamknij</button>
        <button type="button" class="btn btn-primary" @onclick="Confirm" disabled="@(!CanConfirm)">Zatwierdź</button>
    </Footer>
</AppModal>

@code {
    public bool IsVisible { get; set; }

    // Inputs
    private string AddressSearch { get; set; } = "";
    private string InvoiceSearch { get; set; } = "";
    private ElementReference AddressInputRef;
    private ElementReference InvoiceInputRef;

    // Results
    private List<Recipient>? AddressResults;
    private List<SearchInvoiceResult>? InvoiceResults;

    // Selected
    private Recipient? SelectedRecipient;
    private SearchInvoiceResult? SelectedInvoice;

    // States
    private bool LeftDisabled => SelectedRecipient != null;
    private bool RightDisabled => SelectedRecipient == null;
    private bool IsAddressLoading;
    private bool IsInvoiceLoading;

    public EventCallback<Recipient> OnRecipientSelected { get; set; }

    [Parameter]
    public EventCallback<(Recipient Recipient, SearchInvoiceResult? Invoice)> OnConfirmed { get; set; }

    private bool CanConfirm => SelectedRecipient != null;

    // PUBLIC API
    public async Task ShowAsync()
    {
        ResetState();
        IsVisible = true;
        await InvokeAsync(StateHasChanged);
    }

    private void Hide()
    {
        IsVisible = false;
    }

    private void ResetState()
    {
        AddressSearch = "";
        InvoiceSearch = "";
        AddressResults = null;
        InvoiceResults = null;
        SelectedRecipient = null;
        SelectedInvoice = null;
    }

    // ADDRESS HANDLER
    private async Task OnAddressInput(ChangeEventArgs args)
    {
        AddressSearch = args.Value?.ToString() ?? "";

        if (AddressSearch.Length < 3)
        {
            AddressResults = null;
            return;
        }

        IsAddressLoading = true;
        StateHasChanged();

        AddressResults = await ShipmentService.SearchAddress(AddressSearch);

        IsAddressLoading = false;
    }

    private async Task SelectRecipient(Recipient r)
    {
        if (LeftDisabled) return;
        SelectedRecipient = r;
        await Task.Yield();
        await JSRuntime.InvokeVoidAsync("blazorFocus.focusElement", InvoiceInputRef);
    }

    // INVOICE HANDLER
    private async Task OnInvoiceInput(ChangeEventArgs args)
    {
        if (RightDisabled) return;

        InvoiceSearch = args.Value?.ToString() ?? "";

        if (InvoiceSearch.Length < 3)
        {
            InvoiceResults = null;
            return;
        }

        IsInvoiceLoading = true;
        StateHasChanged();

        InvoiceResults = await ShipmentService.SearchInvoice(InvoiceSearch);

        IsInvoiceLoading = false;
    }

    private void SelectInvoice(SearchInvoiceResult item)
    {
        SelectedInvoice = item;
    }

    private async Task Confirm()
    {
        Hide();
        await OnConfirmed.InvokeAsync((SelectedRecipient!, SelectedInvoice));
    }
}
