@using WarehousePacking.Contracts.DTOs

@*
    Confirmation that the scanned package matches the waybill in the operator's
    hand, with the option to print an internal label instead.
*@

<AppModal IsVisible="IsVisible" Title="Przesyłka z listem przewozowym" Icon="bi bi-file-earmark-text"
          Size="lg" OnClose="Close">
    <ChildContent>
        <p>Sprawdź zgodność danych zeskanowanej paczki/palety z dostarczonym listem przewozowym.</p>
        <p class="text-muted">Jeśli nie masz listu, wygeneruj etykietę wewnętrzną i naklej na przesyłkę.</p>

        <h6 class="app-section-label mt-4 mb-2">Dane odbiorcy</h6>
        <dl class="app-facts">
            <dt>Akronim</dt>
            <dd class="app-table__code">@Recipient?.Name</dd>

            <dt>Ulica</dt>
            <dd>@Recipient?.Street</dd>

            <dt>Kod pocztowy</dt>
            <dd>@Recipient?.PostalCode</dd>

            <dt>Kraj</dt>
            <dd>@Recipient?.Country</dd>

            <dt>Sposób wysyłki</dt>
            <dd><strong>@Courier</strong></dd>
        </dl>

        <label class="form-label app-section-label mt-4" for="packingListTracking">Numer przesyłki</label>
        <div class="app-scan">
            <span class="app-scan__icon" aria-hidden="true"><i class="bi bi-upc-scan"></i></span>
            <input id="packingListTracking"
                   class="app-scan__input"
                   placeholder="Zeskanuj lub wpisz numer"
                   @bind="TrackingNumber"
                   @bind:event="oninput"
                   autocomplete="off"
                   autofocus />
        </div>
    </ChildContent>

    <Footer>
        <button type="button" class="btn btn-secondary" @onclick="Close">Zamknij</button>
        <button type="button" class="btn btn-secondary" @onclick="TriggerPrint">
            <i class="bi bi-printer me-1"></i>Drukuj etykietę wewn.
        </button>
        <button type="button" class="btn btn-primary" @onclick="TriggerSave">Zapisz numer</button>
    </Footer>
</AppModal>

@code {
    private bool IsVisible;
    private string TrackingNumber = string.Empty;
    private Recipient Recipient { get; set; } = new();
    private string Courier { get; set; } = string.Empty;

    [Parameter] public EventCallback<string> OnSaveNumber { get; set; }
    [Parameter] public EventCallback<Recipient> OnPrintLabel { get; set; }

    public async Task Show(Recipient recipient, string courier)
    {
        Recipient = recipient;
        Courier = courier;
        TrackingNumber = string.Empty;
        IsVisible = true;

        await InvokeAsync(StateHasChanged);
    }

    private async Task TriggerSave()
    {
        await OnSaveNumber.InvokeAsync(TrackingNumber);
        Close();
    }

    private async Task TriggerPrint()
    {
        await OnPrintLabel.InvokeAsync(Recipient);
        Close();
    }

    private void Close() => IsVisible = false;
}
