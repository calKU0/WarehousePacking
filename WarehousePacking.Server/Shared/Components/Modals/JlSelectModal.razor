@inject IJSRuntime JSRuntime

@*
    Disambiguates a scanned product code that exists in more than one JL.
    The operator can either pick from the list or scan the JL directly.
*@

<AppModal IsVisible="IsVisible" Title="@Title" Icon="bi bi-box-seam" OnClose="Cancel">
    <ChildContent>
        <p class="text-muted">@Message</p>

        <div class="mb-3">
            <label class="form-label app-section-label" for="jlSelect">Wybierz kuwetę</label>
            <select id="jlSelect" class="form-select form-select-lg" value="@SelectedJl" @onchange="HandleSelectChanged">
                <option value="" disabled selected hidden>Wybierz JL</option>
                @foreach (var jl in JlCodes)
                {
                    <option value="@jl.JlCode">@jl.JlCode</option>
                }
            </select>
        </div>

        <div>
            <label class="form-label app-section-label" for="jlScan">Zeskanuj kuwetę</label>
            <div class="app-scan" id="jlScan">
                <span class="app-scan__icon" aria-hidden="true"><i class="bi bi-upc-scan"></i></span>
                <input class="app-scan__input"
                       @bind="ScanValue"
                       @bind:event="oninput"
                       @ref="_scanInputRef"
                       @onkeydown="HandleScanKeyDown"
                       placeholder="Zeskanuj kod JL"
                       autocomplete="off"
                       autofocus />
            </div>
        </div>
    </ChildContent>


    <Footer>
        <button type="button"
                class="btn btn-primary"
                style="flex: 7;"
                disabled="@string.IsNullOrWhiteSpace(SelectedJl)"
                @onclick="Confirm">
            Potwierdź
        </button>
        <button type="button" class="btn btn-secondary" style="flex: 3;" @onclick="Cancel">Anuluj</button>
    </Footer>
</AppModal>

<Toast @ref="Toast" />

@code {
    private ElementReference _scanInputRef;
    private TaskCompletionSource<string?>? _tcs;
    private bool _shouldFocus;

    private string SelectedJl { get; set; } = string.Empty;
    private string ScanValue { get; set; } = string.Empty;
    private Toast Toast = new();

    public string Title { get; set; } = "Wybierz kuwetę";
    public string Message { get; set; } = "Towar znajduje się w więcej niż jednej kuwecie. Wybierz kuwetę.";
    public bool IsVisible { get; set; }
    public List<(string JlCode, string JlEanCode)> JlCodes { get; set; } = new();

    public Task<string?> ShowAsync(List<(string JlCode, string JlEanCode)> jlCodes, string scannedCode)
    {
        JlCodes = jlCodes;
        SelectedJl = string.Empty;
        ScanValue = string.Empty;
        Message = $"Kod {scannedCode} znajduje się w więcej niż jednej kuwecie. Wybierz kuwetę.";
        IsVisible = true;
        _shouldFocus = true;
        StateHasChanged();

        _tcs = new TaskCompletionSource<string?>();
        return _tcs.Task;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_shouldFocus)
        {
            _shouldFocus = false;
            await JSRuntime.InvokeVoidAsync("blazorFocus.focusElement", _scanInputRef);
        }
    }

    private void HandleSelectChanged(ChangeEventArgs e)
    {
        SelectedJl = e.Value?.ToString() ?? string.Empty;
        StateHasChanged();
    }

    private void Confirm() => Close(SelectedJl);

    private void Cancel() => Close(null);

    private void Close(string? result)
    {
        _tcs?.TrySetResult(result);
        IsVisible = false;
        StateHasChanged();
    }

    private void HandleScanKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Enter")
            return;

        var match = JlCodes.FirstOrDefault(jl =>
            string.Equals(jl.JlCode, ScanValue, StringComparison.OrdinalIgnoreCase) ||
            string.Equals(jl.JlEanCode, ScanValue, StringComparison.OrdinalIgnoreCase));

        if (string.IsNullOrWhiteSpace(match.JlCode))
        {
            Toast.Show("Błąd!", "Nie znaleziono kuwety o podanym kodzie.");
            ScanValue = string.Empty;
            return;
        }

        SelectedJl = match.JlCode;
        Confirm();
    }
}
