@inject IJSRuntime JSRuntime

@*
    Single-field text prompt. Returns the entered value, or null if dismissed.
*@

<AppModal IsVisible="IsVisible" Title="@Title" Icon="bi bi-pencil-square" OnClose="Close">
    <ChildContent>
        @if (!string.IsNullOrWhiteSpace(Message))
        {
            <p class="text-muted">@Message</p>
        }

        <input class="form-control form-control-lg"
               type="@InputType"
               @bind="InputValue"
               @bind:event="oninput"
               @ref="_inputRef"
               @onkeydown="HandleKeyDown"
               placeholder="@InputPlaceholder"
               autocomplete="off"
               autofocus />
    </ChildContent>


    <Footer>
        <button type="button" class="btn btn-primary" style="flex: 7;" @onclick="Confirm">Potwierdź</button>
        <button type="button" class="btn btn-secondary" style="flex: 3;" @onclick="Close">Anuluj</button>
    </Footer>
</AppModal>

@code {
    [Parameter] public string Title { get; set; } = "Tytuł";
    [Parameter] public string Message { get; set; } = "Wiadomość";
    [Parameter] public string InputPlaceholder { get; set; } = "Wprowadź tekst...";
    [Parameter] public string InputType { get; set; } = "text";
    [Parameter] public EventCallback OnClose { get; set; }

    public bool IsVisible { get; set; }
    public string InputValue { get; set; } = string.Empty;

    private ElementReference _inputRef;
    private TaskCompletionSource<string?>? _tcs;
    private bool _shouldFocus;

    public Task<string?> Show(string? title = null, string? message = null, string? placeholder = null, string inputType = "text")
    {
        if (!string.IsNullOrEmpty(title)) Title = title;
        if (!string.IsNullOrEmpty(message)) Message = message;
        if (!string.IsNullOrEmpty(placeholder)) InputPlaceholder = placeholder;
        InputType = string.IsNullOrWhiteSpace(inputType) ? "text" : inputType;

        InputValue = string.Empty;
        IsVisible = true;
        _shouldFocus = true;
        StateHasChanged();

        _tcs = new TaskCompletionSource<string?>();
        return _tcs.Task;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_shouldFocus)
        {
            _shouldFocus = false;
            await JSRuntime.InvokeVoidAsync("blazorFocus.focusElement", _inputRef);
        }
    }

    private void Confirm()
    {
        _tcs?.TrySetResult(InputValue);
        Close();
    }

    /// <summary>
    /// Also the dismiss path: any still-pending caller is completed with null
    /// so awaiting code never hangs.
    /// </summary>
    private void Close()
    {
        _tcs?.TrySetResult(null);

        InputValue = string.Empty;
        IsVisible = false;
        StateHasChanged();
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            Confirm();
        }
    }
}
