@inject IJSRuntime JSRuntime

@*
    Manager password prompt. Returns the entered password, or null if cancelled.
*@

<AppModal IsVisible="IsVisible" Title="@Title" Icon="bi bi-shield-lock" Size="sm" OnClose="Cancel">
    <ChildContent>
        @if (!string.IsNullOrWhiteSpace(BodyText))
        {
            <p class="text-muted">@BodyText</p>
        }

        <input type="password"
               class="form-control form-control-lg"
               @bind-value="Password"
               @bind-value:event="oninput"
               @ref="_inputRef"
               @onkeydown="HandleKeyDown"
               placeholder="Hasło"
               autocomplete="current-password"
               autofocus />
    </ChildContent>


    <Footer>
        <button type="button" class="btn btn-secondary" @onclick="Cancel">Anuluj</button>
        <button type="button" class="btn btn-primary" @onclick="Confirm">Potwierdź</button>
    </Footer>
</AppModal>

@code {
    private bool IsVisible;
    private string Password = string.Empty;
    private ElementReference _inputRef;
    private bool _shouldFocus;

    private ScanInput? ScanInput;
    private TaskCompletionSource<string?>? _tcs;

    private string Title = "Wpisz hasło";
    private string BodyText = string.Empty;

    public Task<string?> ShowAsync(
        string title = "Wprowadź hasło",
        string bodyText = "",
        ScanInput? scanInput = null)
    {
        Title = title;
        BodyText = bodyText;
        ScanInput = scanInput;

        Password = string.Empty;
        IsVisible = true;
        _shouldFocus = true;

        _tcs = new TaskCompletionSource<string?>();

        StateHasChanged();
        return _tcs.Task;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_shouldFocus)
        {
            _shouldFocus = false;
            await JSRuntime.InvokeVoidAsync("blazorFocus.focusElement", _inputRef);
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await Confirm();
        }
    }

    private async Task Confirm()
    {
        _tcs?.TrySetResult(Password);
        await Hide();
    }

    private async Task Cancel()
    {
        _tcs?.TrySetResult(null);
        await Hide();

        if (ScanInput != null)
        {
            await ScanInput.FocusAsync();
        }
    }

    private Task Hide()
    {
        IsVisible = false;
        Password = string.Empty;
        StateHasChanged();
        return Task.CompletedTask;
    }
}
