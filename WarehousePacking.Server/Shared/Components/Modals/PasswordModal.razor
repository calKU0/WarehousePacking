@inject IJSRuntime JSRuntime
@inherits ModalBase<string>

@*
    Manager password prompt. Returns the entered password, or null if cancelled.
*@

<AppModal IsVisible="IsVisible" Title="@Title" Icon="bi bi-shield-lock" Size="sm" OnClose="Cancel">
    <ChildContent>
        @* Both stay plain text — never markup — since a caller's emphasis is
           typically an error message that came back from the API. pre-line so a
           multi-line message keeps its breaks, matching Toast. *@
        @if (!string.IsNullOrWhiteSpace(EmphasisText))
        {
            <p class="fw-bold" style="white-space: pre-line;">@EmphasisText</p>
        }

        @if (!string.IsNullOrWhiteSpace(BodyText))
        {
            <p class="text-muted" style="white-space: pre-line;">@BodyText</p>
        }

        <input type="password"
               class="form-control"
               @bind-value="Password"
               @bind-value:event="oninput"
               @ref="_inputRef"
               @onkeydown="HandleKeyDown"
               placeholder="Hasło"
               autocomplete="current-password"
               autofocus />
    </ChildContent>


    <Footer>
        <button type="button" class="btn btn-secondary" @onclick="Cancel">Zamknij</button>
        <button type="button" class="btn btn-primary" @onclick="() => Confirm(Password)">Potwierdź</button>
    </Footer>
</AppModal>

@code {
    private string Password = string.Empty;
    private ElementReference _inputRef;

    private string Title = "Wpisz hasło";
    private string BodyText = string.Empty;
    private string EmphasisText = string.Empty;

    /// <param name="emphasisText">
    /// Shown in bold above the body — the reason the operator is being asked.
    /// </param>
    public Task<string?> ShowAsync(string title = "Wprowadź hasło", string bodyText = "", string emphasisText = "")
    {
        Title = title;
        BodyText = bodyText;
        EmphasisText = emphasisText;
        Password = string.Empty;

        return OpenAsync();
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") Confirm(Password);
    }
}
