@inject IJSRuntime JSRuntime
@inherits ModalBase<string>

@*
    Manager password prompt. Returns the entered password, or null if cancelled.
*@

<AppModal IsVisible="IsVisible" Title="@Title" Icon="bi bi-shield-lock" Size="sm" OnClose="Cancel">
    <ChildContent>
        @if (!string.IsNullOrWhiteSpace(BodyText))
        {
            <p class="text-muted">@BodyText</p>
        }

        <input type="password"
               class="form-control"
               @bind-value="Password"
               @bind-value:event="oninput"
               @ref="_inputRef"
               @onkeydown="HandleKeyDown"
               placeholder="Hasło"
               autocomplete="current-password"
               autofocus />
    </ChildContent>


    <Footer>
        <button type="button" class="btn btn-secondary" @onclick="Cancel">Zamknij</button>
        <button type="button" class="btn btn-primary" @onclick="() => Confirm(Password)">Potwierdź</button>
    </Footer>
</AppModal>

@code {
    private string Password = string.Empty;
    private ElementReference _inputRef;

    private string Title = "Wpisz hasło";
    private string BodyText = string.Empty;

    public Task<string?> ShowAsync(string title = "Wprowadź hasło", string bodyText = "")
    {
        Title = title;
        BodyText = bodyText;
        Password = string.Empty;

        return OpenAsync();
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") Confirm(Password);
    }
}
