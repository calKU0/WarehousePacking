@using WarehousePacking.Server.Helpers
@using WarehousePacking.Server.Services
@using WarehousePacking.Contracts.Data.Enums

@inject PackingService PackingService
@inject IJSRuntime JSRuntime

@*
    Reassigns the storage warehouse of an already-closed package. The operator
    scans the internal barcode; the current warehouse is then loaded and can be
    changed.
*@

<AppModal IsVisible="IsVisible" Title="Zmień magazyn składowania" Icon="bi bi-building" OnClose="Close">
    <ChildContent>
        @if (IsLoading)
        {
            <div class="app-overlay app-overlay--local">
                <div class="app-spinner"></div>
            </div>
        }

        <div class="mb-3">
            <label class="form-label app-section-label" for="warehouseBarcode">Kod wewnętrzny</label>
            <div class="app-scan" id="warehouseBarcode">
                <span class="app-scan__icon" aria-hidden="true"><i class="bi bi-upc-scan"></i></span>
                <input class="app-scan__input"
                       @bind="InputText"
                       @ref="InputRef"
                       @onkeydown="OnEnterKey"
                       disabled="@IsLoading"
                       autocomplete="off"
                       autofocus />
            </div>
        </div>

        @if (ShowSelect)
        {
            <div class="app-fade-in">
                <label class="form-label app-section-label" for="warehouseSelect">Magazyn składowania</label>
                <select id="warehouseSelect" class="form-select form-select-lg" @bind="SelectedWarehouse" disabled="@IsLoading">
                    @foreach (var warehouse in Enum.GetValues<PackingWarehouse>())
                    {
                        <option value="@warehouse">@warehouse.GetDescription()</option>
                    }
                </select>
            </div>
        }
    </ChildContent>

    <Footer>
        @if (ShowSelect)
        {
            <button type="button" class="btn btn-primary" @onclick="Save" disabled="@IsLoading">
                <i class="bi bi-save me-1"></i>Zapisz
            </button>
        }
        <button type="button" class="btn btn-secondary" @onclick="Close" disabled="@IsLoading">Wyjdź</button>
    </Footer>
</AppModal>

<Toast @ref="Toast" />

@code {
    private bool IsVisible { get; set; }
    private string InputText { get; set; } = string.Empty;
    private bool ShowSelect { get; set; }
    private PackingWarehouse SelectedWarehouse { get; set; }
    private Toast Toast = new();
    private ElementReference InputRef;
    private bool _shouldFocus;
    private bool IsLoading { get; set; }

    public async Task Show()
    {
        IsVisible = true;
        ShowSelect = false;
        InputText = string.Empty;
        _shouldFocus = true;
        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_shouldFocus)
        {
            _shouldFocus = false;
            await JSRuntime.InvokeVoidAsync("blazorFocus.focusElement", InputRef);
        }
    }

    private async Task OnEnterKey(KeyboardEventArgs e)
    {
        if (e.Key != "Enter")
            return;

        try
        {
            IsLoading = true;
            await InvokeAsync(StateHasChanged);

            SelectedWarehouse = await PackingService.GetPackageWarehouse(InputText);
            ShowSelect = true;
        }
        catch (Exception ex)
        {
            Toast.Show("Błąd!", $"Błąd przy pobieraniu magazynu składowania dla podanego kodu kreskowego: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task Save()
    {
        try
        {
            IsLoading = true;
            await InvokeAsync(StateHasChanged);

            await PackingService.UpdatePackageWarehouse(InputText, SelectedWarehouse);
            Close();
        }
        catch (Exception ex)
        {
            Toast.Show("Błąd!", $"Błąd przy aktualizacji magazynu składowania dla podanego kodu kreskowego: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void Close()
    {
        IsVisible = false;
        StateHasChanged();
    }
}
