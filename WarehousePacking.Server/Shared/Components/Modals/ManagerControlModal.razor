@*
    Supervisor action panel, unlocked by password. The action ids are a
    contract with the host page's HandleManagerClick switch — do not renumber.
*@

<button type="button" class="btn btn-secondary manager-lock" @onclick="OnLockClick" title="Funkcje kierownika">
    <i class="bi bi-lock"></i>
</button>

<AppModal IsVisible="IsOpen" Title="Przyciski kierownika" Icon="bi bi-sliders" Size="lg" OnClose="CloseModal">
    <ChildContent>
        <div class="manager-grid">
            @foreach (var action in VisibleActions)
            {
                <button type="button"
                        class="btn btn-primary manager-grid__btn"
                        disabled="@IsLoading"
                        @onclick="() => HandleClick(action.Id)">
                    <i class="@action.Icon"></i>
                    <span>@action.Label</span>
                </button>
            }
        </div>
    </ChildContent>

    <Footer>
        <button type="button" class="btn btn-secondary" id="zamknijBtn" disabled="@IsLoading" @onclick="CloseModal">
            Zamknij
        </button>
    </Footer>
</AppModal>

@code {
    /// <summary>
    /// A supervisor action. <paramref name="Id"/> is dispatched to the host page.
    /// </summary>
    private sealed record ManagerAction(int Id, string Label, string Icon, bool PackingOnly = false);

    // Ids 1 (Etykiety), 3 (Zawartość) and 10 (Zabuforuj paczkę) were previously
    // commented out in the markup; they stay retired but the numbering is kept
    // so the host switch statement remains valid.
    private static readonly ManagerAction[] Actions =
    {
        new(2,  "Spakuj",          "bi bi-box-seam",        PackingOnly: true),
        new(4,  "Kurier",          "bi bi-truck",           PackingOnly: true),
        new(5,  "Zalogowani",      "bi bi-people"),
        new(6,  "Kuwety podjęte",  "bi bi-hand-index"),
        new(7,  "Zamknij paczkę",  "bi bi-door-closed"),
        new(8,  "Zm. magazyn",     "bi bi-building"),
        new(9,  "Połącz paczki",   "bi bi-union"),
        new(11, "Konf. kurierów",  "bi bi-gear"),
        new(12, "Zmień hasło",     "bi bi-key")
    };

    [Parameter] public EventCallback<int> OnButtonClick { get; set; }
    [Parameter] public EventCallback OnRequestPassword { get; set; }
    [Parameter] public bool ShowPackingButtons { get; set; }

    private bool IsOpen;
    private bool IsLoading;
    private ScanInput? ScanInput;

    private IEnumerable<ManagerAction> VisibleActions =>
        Actions.Where(a => ShowPackingButtons || !a.PackingOnly);

    private async Task OnLockClick()
    {
        if (OnRequestPassword.HasDelegate)
        {
            await OnRequestPassword.InvokeAsync();
        }
    }

    public void OpenModal(ScanInput? scanInput = null)
    {
        IsOpen = true;
        ScanInput = scanInput;
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task CloseModal()
    {
        IsOpen = false;

        if (ScanInput != null)
        {
            await ScanInput.FocusAsync();
        }
    }

    private async Task HandleClick(int value)
    {
        if (IsLoading)
            return;

        // Stay open beneath the action's own modal. The action's modal is a
        // top-layer <dialog> that stacks on top of this panel, so:
        //   - closing it returns straight here (no re-entering the password),
        //     which is the "back" the operator wants, and
        //   - this panel's backdrop never goes away, so there's no jarring
        //     flash-to-bright between one dialog closing and the next opening.
        IsLoading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            await OnButtonClick.InvokeAsync(value);
        }
        finally
        {
            IsLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }
}
