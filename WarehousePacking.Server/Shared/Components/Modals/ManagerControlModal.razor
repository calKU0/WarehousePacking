@*
    Supervisor action panel, unlocked by password. The action ids are a
    actions are dispatched to the host page as ManagerAction values.
*@

<button type="button" class="btn btn-secondary btn-icon manager-lock" @onclick="OnLockClick" title="Funkcje kierownika">
    <i class="bi bi-lock"></i>
</button>

<AppModal IsVisible="IsOpen" Title="Przyciski kierownika" Icon="bi bi-sliders" Size="lg" OnClose="CloseModal">
    <ChildContent>
        <div class="manager-grid">
            @foreach (var tile in VisibleActions)
            {
                <button type="button"
                        class="btn btn-primary manager-grid__btn"
                        disabled="@IsLoading"
                        @onclick="() => HandleClick(tile.Action)">
                    <i class="@tile.Icon"></i>
                    <span>@tile.Label</span>
                </button>
            }
        </div>
    </ChildContent>

    <Footer>
        <button type="button" class="btn btn-secondary" id="zamknijBtn" disabled="@IsLoading" @onclick="CloseModal">
            Zamknij
        </button>
    </Footer>
</AppModal>

@code {
    /// <summary>A tile on the panel; <paramref name="Action"/> is what the host page receives.</summary>
    private sealed record ActionTile(ManagerAction Action, string Label, string Icon, bool PackingOnly = false);

    private static readonly ActionTile[] Tiles =
    {
        new(ManagerAction.PackAll,               "Spakuj",         "bi bi-box-seam", PackingOnly: true),
        new(ManagerAction.Courier,               "Kurier",         "bi bi-truck",    PackingOnly: true),
        new(ManagerAction.LoggedOperators,       "Zalogowani",     "bi bi-people"),
        new(ManagerAction.JlsInProgress,         "Kuwety podjęte", "bi bi-hand-index"),
        new(ManagerAction.ReleasePackage,        "Zamknij paczkę", "bi bi-door-closed"),
        new(ManagerAction.ChangeWarehouse,       "Zm. magazyn",    "bi bi-building"),
        new(ManagerAction.MergePackages,         "Połącz paczki",  "bi bi-union"),
        new(ManagerAction.CourierConfiguration,  "Konf. kurierów", "bi bi-gear"),
        new(ManagerAction.ChangePassword,        "Zmień hasło",    "bi bi-key")
    };

    [Parameter] public EventCallback<ManagerAction> OnButtonClick { get; set; }
    [Parameter] public EventCallback OnRequestPassword { get; set; }
    [Parameter] public bool ShowPackingButtons { get; set; }

    private bool IsOpen;
    private bool IsLoading;

    private IEnumerable<ActionTile> VisibleActions =>
        Tiles.Where(a => ShowPackingButtons || !a.PackingOnly);

    private async Task OnLockClick()
    {
        if (OnRequestPassword.HasDelegate)
        {
            await OnRequestPassword.InvokeAsync();
        }
    }

    public void OpenModal()
    {
        IsOpen = true;
        _ = InvokeAsync(StateHasChanged);
    }

    private void CloseModal()
    {
        IsOpen = false;
    }

    private async Task HandleClick(ManagerAction action)
    {
        if (IsLoading)
            return;

        // Stay open beneath the action's own modal. The action's modal is a
        // top-layer <dialog> that stacks on top of this panel, so:
        //   - closing it returns straight here (no re-entering the password),
        //     which is the "back" the operator wants, and
        //   - this panel's backdrop never goes away, so there's no jarring
        //     flash-to-bright between one dialog closing and the next opening.
        IsLoading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            await OnButtonClick.InvokeAsync(action);
        }
        finally
        {
            IsLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }
}
