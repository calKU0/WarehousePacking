@using Microsoft.AspNetCore.Components

<div>
    <!-- Lock button (always visible) -->
    <button class="btn btn-secondary" @onclick="OnLockClick">
        <i class="bi bi-lock"></i>
    </button>

    <!-- Manager Modal -->
    @if (IsOpen)
    {
        <div class="modal fade show d-block" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Przyciski Kierownika</h5>
                        <button type="button" class="btn-close" aria-label="Close" @onclick="CloseModal"></button>
                    </div>
                    <div class="modal-body position-relative">
                        @if (IsLoading)
                        {
                            <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center bg-white bg-opacity-75" style="z-index: 10;">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Ładowanie...</span>
                                </div>
                            </div>
                        }
                        <div class="container">
                            <div class="row g-3">
                                @if (ShowPackingButtons)
                                {
                                    @* <div class="col-4">
                                        <button class="btn btn-primary w-100 py-3" @onclick="() => HandleClick(1)">Etykiety</button>
                                    </div> *@

                                    <div class="col-4">
                                        <button class="btn btn-primary w-100 py-3" @onclick="() => HandleClick(2)" disabled="@IsLoading">Spakuj</button>
                                    </div>
 
                                    @* <div class="col-4">
                                        <button class="btn btn-primary w-100 py-3" @onclick="() => HandleClick(3)">Zawartość</button>
                                    </div> *@

                                    <div class="col-4">
                                        <button class="btn btn-primary w-100 py-3" @onclick="() => HandleClick(4)" disabled="@IsLoading">Kurier</button>
                                    </div>
                                }
                                <div class="col-4">
                                    <button class="btn btn-primary w-100 py-3" @onclick="() => HandleClick(5)" disabled="@IsLoading">Zalogowani</button>
                                </div>
                                <div class="col-4">
                                    <button class="btn btn-primary w-100 py-3" @onclick="() => HandleClick(6)" disabled="@IsLoading">Kuwety podjęte</button>
                                </div>
                                <div class="col-4">
                                    <button class="btn btn-primary w-100 py-3" @onclick="() => HandleClick(7)" disabled="@IsLoading">Zamknij paczke</button>
                                </div>
                                <div class="col-4">
                                    <button class="btn btn-primary w-100 py-3" @onclick="() => HandleClick(8)" disabled="@IsLoading">Zm. magazyn</button>
                                </div>
                                <div class="col-4">
                                    <button class="btn btn-primary w-100 py-3" @onclick="() => HandleClick(9)" disabled="@IsLoading">Połącz paczki</button>
                                </div>
                                @* <div class="col-4">
                                    <button class="btn btn-primary w-100 py-3 px-0" @onclick="() => HandleClick(10)">Zabuforuj paczke</button>
                                </div> *@
                                <div class="col-4">
                                    <button class="btn btn-primary w-100 py-3" @onclick="() => HandleClick(11)" disabled="@IsLoading">Konf. kurierów</button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" @onclick="CloseModal" id="zamknijBtn" disabled="@IsLoading">Zamknij</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal-backdrop fade show"></div>
    }
</div>

@code {
    private bool IsOpen = false;
    private bool IsLoading = false;

    [Parameter] public EventCallback<int> OnButtonClick { get; set; }
    [Parameter] public EventCallback OnRequestPassword { get; set; }
    [Parameter] public bool ShowPackingButtons { get; set; } = false;
    private ScanInput? ScanInput = null;

    private async Task OnLockClick()
    {
        if (OnRequestPassword.HasDelegate)
        {
            await OnRequestPassword.InvokeAsync();
        }
    }

    public async void OpenModal(ScanInput scanInput = null)
    {
        IsOpen = true;
        ScanInput = scanInput;
        await InvokeAsync(StateHasChanged);
    }
    private async Task CloseModal()
    {
        IsOpen = false;
        if (ScanInput != null)
        {
            await ScanInput.FocusAsync();
        }
    }

    private async Task HandleClick(int value)
    {
        if (IsLoading)
            return;

        IsLoading = true;
        IsOpen = false;
        await InvokeAsync(StateHasChanged);

        try
        {
            await OnButtonClick.InvokeAsync(value);
        }
        finally
        {
            IsLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }
}
