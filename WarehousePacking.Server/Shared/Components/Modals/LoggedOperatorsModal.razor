@using WarehousePacking.Contracts.DTOs
@using WarehousePacking.Contracts.Data.Enums
@inject AuthService AuthService

@*
    Supervisor view of currently logged-in operators, with the ability to force
    a logout (e.g. a station left signed in at shift end).
*@

<AppModal IsVisible="IsVisible" Title="Zalogowani operatorzy" Icon="bi bi-people" Size="lg" FlushBody="true" OnClose="Close">
    <ChildContent>
        @if (IsLoading)
        {
            <div class="app-empty">
                <div class="app-spinner"></div>
                <p class="app-empty__text">Ładowanie...</p>
            </div>
        }
        else if (Users.Count == 0)
        {
            <div class="app-empty">
                <i class="bi bi-person-slash app-empty__icon"></i>
                <p class="app-empty__text">Brak zalogowanych operatorów.</p>
            </div>
        }
        else
        {
            <table class="app-table app-table--striped">
                <thead>
                    <tr>
                        <th>Operator</th>
                        <th>Stanowisko</th>
                        <th>Data zalogowania</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Users)
                    {
                        <tr @key="user.Username">
                            <td class="fw-semibold">@user.Username</td>
                            <td>@user.StationNumber</td>
                            <td class="text-muted">@user.LoginDate</td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-danger" @onclick="() => ConfirmRemove(user)">
                                    <i class="bi bi-box-arrow-right me-1"></i>Wyloguj
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        @* Kept inside the dialog so its close button stays interactive while the modal is open. *@
        <Toast @ref="Toast" />
    </ChildContent>

    <Footer>
        <button type="button" class="btn btn-secondary" @onclick="Close">Zamknij</button>
    </Footer>
</AppModal>

<ConfirmDialog @ref="ConfirmDialog" />

@code {
    private bool IsVisible { get; set; }
    private ConfirmDialog ConfirmDialog = new();
    private List<LoginDto> Users { get; set; } = new();
    private LoginDto? SelectedUser { get; set; }
    private Toast Toast = new();
    private bool IsLoading { get; set; }

    public async Task ShowModal()
    {
        IsVisible = true;
        await InvokeAsync(StateHasChanged);
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            IsLoading = true;
            Users = await AuthService.GetLoggedUsers();
        }
        catch (Exception ex)
        {
            Toast.Show("Błąd!", $"Błąd przy próbie pobrania listy operatorów: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ConfirmRemove(LoginDto op)
    {
        SelectedUser = op;

        ConfirmDialog.Show(
            title: "Usuń operatora",
            message: "Czy na pewno chcesz usunąć operatora?",
            onConfirm: async () =>
            {
                if (SelectedUser == null)
                    return;

                try
                {
                    await AuthService.Logout(SelectedUser.Username);
                    Toast.Show("Sukces!", $"Operator {SelectedUser.Username} został usunięty.", ToastType.Success);
                }
                catch (Exception ex)
                {
                    Toast.Show("Błąd!", $"Błąd przy próbie usuwania operatora: {ex.Message}");
                }
                finally
                {
                    SelectedUser = null;
                    await LoadData();
                    await InvokeAsync(StateHasChanged);
                }
            },
            onCancel: async () =>
            {
                SelectedUser = null;
                await InvokeAsync(StateHasChanged);
            }
        );
    }

    private void Close()
    {
        IsVisible = false;
        SelectedUser = null;
        StateHasChanged();
    }
}
