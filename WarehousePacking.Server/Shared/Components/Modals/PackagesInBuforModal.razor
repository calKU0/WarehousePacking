@using WarehousePacking.Contracts.DTOs
@inject IJSRuntime JSRuntime

@*
    Offers buffered packages already open for this client so the new items can
    be added to one instead of creating another package. Resolves to the chosen
    package, or null to start a fresh one.
*@

<AppModal IsVisible="IsVisible" Title="Dopakuj towary do paczki" Icon="bi bi-inboxes" Size="lg" OnClose="Cancel">
    <ChildContent>
        <p class="text-muted">Klient posiada zabuforowane paczki/palety. Zeskanuj lub wybierz paczkę:</p>

        <div class="app-scan mb-3">
            <span class="app-scan__icon" aria-hidden="true"><i class="bi bi-upc-scan"></i></span>
            <input class="app-scan__input"
                   @bind="ScanInput"
                   @bind:event="oninput"
                   @onkeydown="OnScanKeyDown"
                   @ref="InputRef"
                   placeholder="Zeskanuj kod kreskowy..."
                   autocomplete="off"
                   autofocus />
        </div>

        <table class="app-table app-table--interactive">
            <thead>
                <tr>
                    <th>Paczka</th>
                    <th>Kurier</th>
                    <th>Kod kreskowy wewnętrzny</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var package in AvaliablePackages)
                {
                    <tr class="@(package.Id == SelectedPackage ? "is-selected" : null)"
                        @key="package.Id"
                        @ondblclick="() => OnRowDoubleClick(package)">
                        <td class="fw-semibold">@package.PackageName</td>
                        <td>@package.CourierName</td>
                        <td class="app-table__code">@package.InternalBarcode</td>
                    </tr>
                }
            </tbody>
        </table>
    </ChildContent>

    <Footer>
        <button type="button" class="btn btn-secondary" @onclick="SkipBuforing">
            Utwórz nową paczkę (bez dopakowania)
        </button>
    </Footer>
</AppModal>

@code {
    private TaskCompletionSource<PackageSelectionResult?>? _tcs;

    private bool IsVisible;
    private List<PackageData> AvaliablePackages = new();
    private int? SelectedPackage;
    private string ScanInput = string.Empty;
    private ElementReference InputRef;

    /// <summary>
    /// True when the operator dismissed the dialog outright (as opposed to
    /// deliberately choosing to create a new package). Callers use this to
    /// abort the whole flow.
    /// </summary>
    public bool WasCancelled { get; private set; }

    public async Task<PackageSelectionResult?> Show(List<PackageData> avaliablePackages)
    {
        AvaliablePackages = avaliablePackages;
        ScanInput = string.Empty;
        WasCancelled = false;

        IsVisible = true;
        await InvokeAsync(StateHasChanged); // ensure render scheduled
        _tcs = new TaskCompletionSource<PackageSelectionResult?>();

        return await _tcs.Task;
    }

    private void OnScanKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Enter")
            return;

        var input = ScanInput?.Trim();
        if (string.IsNullOrEmpty(input))
            return;

        var pkg = AvaliablePackages.FirstOrDefault(p =>
            string.Equals(p.InternalBarcode?.Trim(), input, StringComparison.OrdinalIgnoreCase));

        // Unknown code: leave the dialog open so the operator can rescan.
        if (pkg is null)
            return;

        SelectedPackage = pkg.Id;
        Confirm();
    }

    private void OnRowDoubleClick(PackageData package)
    {
        SelectedPackage = package.Id;
        Confirm();
    }

    private void Cancel()
    {
        WasCancelled = true;
        Complete(null);
    }

    private void SkipBuforing() => Complete(null);

    private void Confirm()
    {
        var result = AvaliablePackages
            .Where(x => x.Id == SelectedPackage)
            .Select(x => new PackageSelectionResult
            {
                PackageId = x.Id,
                InternalBarcode = x.InternalBarcode
            })
            .FirstOrDefault();

        Complete(result);
    }

    private void Complete(PackageSelectionResult? result)
    {
        IsVisible = false;
        _tcs?.TrySetResult(result);
        StateHasChanged();
    }
}
