@using WarehousePacking.Contracts.Data.Enums
@using WarehousePacking.Server.Helpers

@*
    Terminal step of a package: choose how it leaves the station. Options are
    conditional on courier capability and packing level.
*@

<AppModal IsVisible="IsVisible" Title="Zakończ pakowanie" Icon="bi bi-check2-circle" OnClose="Hide">
    <ChildContent>
        <div class="finish-packing__identity">
            @if (!string.IsNullOrWhiteSpace(CourierSrc))
            {
                <img src="@CourierSrc" alt="@Courier.GetDescription()" class="finish-packing__courier" />
            }

            @if (IsExport)
            {
                <img src="images/exp.jpg" alt="Eksport" class="finish-packing__export" />
            }
        </div>

        <p class="text-center text-muted mb-0">Wybierz jedną z opcji:</p>
    </ChildContent>


    <Footer>
        <div class="finish-packing__actions">
            @if (CanPrintCourierLabel)
            {
                <button type="button" class="btn btn-primary" @onclick="OnCourierLabel">
                    <i class="bi bi-tags"></i>
                    <span>Nadaj etykietę kurierską</span>
                </button>
            }

            <button type="button" class="btn btn-success" @onclick="OnInternalBarcode">
                <i class="bi bi-upc"></i>
                <span>Nadaj kod wewnętrzny</span>
            </button>

            @if (CanBuffer)
            {
                <button type="button" class="btn btn-warning" @onclick="OnBufor">
                    <i class="bi bi-inboxes"></i>
                    <span>Zabuforuj</span>
                </button>
            }

            <button type="button" class="btn btn-secondary" @onclick="Hide">
                <i class="bi bi-x-lg"></i>
                <span>Anuluj</span>
            </button>
        </div>
    </Footer>
</AppModal>

@code {
    [Parameter] public Courier Courier { get; set; }
    [Parameter] public string CourierSrc { get; set; } = string.Empty;
    [Parameter] public string Country { get; set; } = string.Empty;
    [Parameter] public PackingLevel PackingLevel { get; set; }
    [Parameter] public EventCallback OnCourierLabel { get; set; }
    [Parameter] public EventCallback OnInternalBarcode { get; set; }
    [Parameter] public EventCallback OnBufor { get; set; }

    protected bool IsVisible { get; set; }

    private bool IsExport => !string.IsNullOrEmpty(Country) && Country != "PL";

    private bool CanPrintCourierLabel => CourierHelper.AllowedCouriersForLabel.Contains(Courier);

    private bool CanBuffer => PackingLevel == PackingLevel.Bottom;

    public void Show()
    {
        IsVisible = true;
        StateHasChanged();
    }

    public void Hide()
    {
        IsVisible = false;
        StateHasChanged();
    }
}
