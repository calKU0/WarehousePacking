@using WarehousePacking.Server.Services
@using WarehousePacking.Contracts.Data.Enums
@inject ClientPrinterService ClientPrinterService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

@*
    Post-pack confirmation. When ShowScan is set the operator must scan the
    printed label back in, which verifies the right label ended up on the right
    package before the document is closed.
*@

<AppModal IsVisible="IsVisible" Title="Paczka spakowana" Icon="bi bi-bag-check" Accent="true" ShowClose="false">
    <ChildContent>
        <div class="shipment__body">
            @if (ShowScan)
            {
                <div class="app-scan">
                    <span class="app-scan__icon" aria-hidden="true"><i class="bi bi-upc-scan"></i></span>
                    <input class="app-scan__input"
                           placeholder="Zeskanuj kod kreskowy etykiety"
                           @bind="ScannedCode"
                           @bind:event="oninput"
                           @onkeydown="HandleKeyDown"
                           @ref="InputRef"
                           autocomplete="off"
                           autofocus />
                </div>
            }

            @if (!string.IsNullOrEmpty(ScanErrorMessage))
            {
                <div class="alert alert-danger mb-0 py-2" role="alert">
                    <i class="bi bi-exclamation-triangle me-1"></i>@ScanErrorMessage
                </div>
            }

            <dl class="shipment__facts">
                <dt>Kod wewnętrzny</dt>
                <dd class="app-table__code">@InternalBarcode</dd>

                @if (!string.IsNullOrEmpty(TrackingNumber))
                {
                    <dt>Numer przesyłki</dt>
                    <dd class="app-table__code">@TrackingNumber</dd>
                }
            </dl>

            @if (HasInvoice)
            {
                <div class="alert alert-success mb-0 py-2" role="status">
                    <i class="bi bi-file-earmark-text me-1"></i>Wydrukowano fakturę. Dołącz do paczki.
                </div>
            }
        </div>
    </ChildContent>

    <Footer>
        <button type="button"
                class="btn btn-primary"
                style="flex: 2;"
                @onclick="OnOkClicked"
                disabled="@(IsSubmitting || (string.IsNullOrWhiteSpace(ScannedCode) && ShowScan))">
            OK
        </button>
        <button type="button" class="btn btn-success" style="flex: 1;" @onclick="OnPrintClicked">
            <i class="bi bi-printer me-1"></i>Wydrukuj ponownie
        </button>
    </Footer>
</AppModal>

@code {
    private bool IsVisible { get; set; }
    private string TrackingNumber { get; set; } = string.Empty;
    private string LabelBase64 { get; set; } = string.Empty;
    private string Printer { get; set; } = string.Empty;
    private PrintDataType LabelType { get; set; }
    private bool HasInvoice { get; set; }
    private string InternalBarcode { get; set; } = string.Empty;

    private string _scannedCode = string.Empty;

    private string ScannedCode
    {
        get => _scannedCode;
        set => _scannedCode = value?.Trim() ?? string.Empty;
    }

    private bool ShowScan { get; set; }
    private ElementReference InputRef;
    private string? ScanErrorMessage;
    private bool IsSubmitting;
    private bool StayOpenAfterOk;

    /// <summary>Keeps the dialog open after the next OK (multi-package flows).</summary>
    public void KeepOpenAfterOk() => StayOpenAfterOk = true;

    [Parameter] public EventCallback<(string ScannedCode, string TrackingNumber)> OnOk { get; set; }

    public async void Show(
        string internalBarcode,
        PrintDataType labelType,
        string printer,
        bool hasInvoice,
        bool showScan = true,
        string? scannedCode = null,
        string? trackingNumber = null,
        string? labelBase64 = null)
    {
        // Focusing throws when the scan field is not rendered; that is expected
        // and harmless, so the whole block is best-effort.
        try
        {
            TrackingNumber = trackingNumber ?? string.Empty;
            LabelBase64 = labelBase64 ?? string.Empty;
            LabelType = labelType;
            Printer = printer;
            HasInvoice = hasInvoice;
            InternalBarcode = internalBarcode;
            ShowScan = showScan;

            ScannedCode = scannedCode ?? string.Empty;
            IsVisible = true;
            await InvokeAsync(StateHasChanged);
            await InputRef.FocusAsync();
        }
        catch
        {
        }
    }

    private async Task OnOkClicked()
    {
        if (IsSubmitting)
            return;

        IsSubmitting = true;
        try
        {
            await ConfirmAsync();
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private async Task OnPrintClicked()
    {
        if (!string.IsNullOrEmpty(LabelBase64))
        {
            await ClientPrinterService.PrintAsync(Printer, LabelType.ToString(), LabelBase64);
            await JSRuntime.InvokeVoidAsync("blazorFocus.focusElement", InputRef);
        }
        else
        {
            await ClientPrinterService.PrintCrystalAsync(Printer, "Label", new Dictionary<string, string> { { "Kod Kreskowy", InternalBarcode } });
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (IsSubmitting || e.Key != "Enter")
            return;

        IsSubmitting = true;
        try
        {
            await ConfirmAsync();
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private async Task ConfirmAsync()
    {
        if (ShowScan && !await IsScannedCodeValidAsync())
            return;

        ScanErrorMessage = null;

        if (OnOk.HasDelegate)
        {
            await OnOk.InvokeAsync((ScannedCode, string.IsNullOrEmpty(TrackingNumber) ? ScannedCode : TrackingNumber));
        }

        ScannedCode = string.Empty;

        if (StayOpenAfterOk)
        {
            StayOpenAfterOk = false;
            await InvokeAsync(StateHasChanged);
            return;
        }

        Hide();
    }

    /// <summary>
    /// Validates the scanned label against the expected tracking number or
    /// internal barcode, reporting the failure inline and refocusing the field.
    /// </summary>
    private async Task<bool> IsScannedCodeValidAsync()
    {
        if (string.IsNullOrWhiteSpace(ScannedCode))
            return false;

        if (ScannedCode.Length > 29)
            return await RejectAsync("Za długi kod etykiety. Zeskanuj ponownie.");

        var containsTracking =
            !string.IsNullOrEmpty(TrackingNumber) &&
            ScannedCode.Contains(TrackingNumber, StringComparison.OrdinalIgnoreCase);

        var containsInternalBarcode =
            !string.IsNullOrEmpty(InternalBarcode) &&
            ScannedCode.Contains(InternalBarcode, StringComparison.OrdinalIgnoreCase);

        if (!containsTracking && !containsInternalBarcode)
            return await RejectAsync("Nieprawidłowy kod. Zeskanuj numer przesyłki lub kod wewnętrzny.");

        return true;
    }

    private async Task<bool> RejectAsync(string message)
    {
        ScanErrorMessage = message;
        ScannedCode = string.Empty;

        await JSRuntime.InvokeVoidAsync("blazorFocus.focusElement", InputRef);
        StateHasChanged();
        return false;
    }

    public void Hide()
    {
        IsVisible = false;
        StateHasChanged();
    }
}
