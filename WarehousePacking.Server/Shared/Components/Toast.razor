@using WarehousePacking.Contracts.Data.Enums
@implements IDisposable
@inject IJSRuntime JSRuntime

@*
    Notification stack.

    Two kinds of message live here, so every call site has a single component
    to reach for:

      • Show(...)        — a corner toast. Non-blocking: it stacks, drains a
                           life bar and fades on its own, never taking the caret.
                           Rendered as a popover so it paints in the browser's
                           top layer, above open modals, without a backdrop.

      • ShowBlocking(...) — a centred card that dims and blocks the whole screen
                           until the operator presses "Potwierdź". Built on the
                           shared modal shell (a native <dialog> shown modally),
                           which is always interactive and always on top — the
                           right tool for a message that MUST be read, such as
                           the single-packing warning or a hand-off notice.
*@

<div class="toast-stack" popover="manual" @ref="_stackRef">
    @foreach (var toast in _toasts)
    {
        <div class="toast-item toast-item--@Kind(toast.Type) @(_leaving.Contains(toast.Id) ? "is-leaving" : null)" @key="toast.Id" role="status">
            <span class="toast-item__icon" aria-hidden="true"><i class="@Icon(toast.Type)"></i></span>

            <div class="toast-item__text">
                <strong class="toast-item__title">@toast.Title</strong>
                <div class="toast-item__body">@((MarkupString)toast.Message)</div>
            </div>

            <button type="button" class="toast-item__close" aria-label="Zamknij" @onclick="() => Dismiss(toast.Id)">
                <i class="bi bi-x-lg"></i>
            </button>

            <span class="toast-item__life" style="animation-duration: @(toast.DurationMs)ms"></span>
        </div>
    }
</div>

@* Blocking acknowledgement. Only the current head of the queue is shown; the
   next one (if any) slides in once this one is confirmed. *@
<AppModal IsVisible="_ack is not null" Size="sm" ShowHeader="false" ShowClose="false">
    <ChildContent>
        @if (_ack is not null)
        {
            <div class="toast-ack toast-ack--@Kind(_ack.Type)">
                <div class="toast-ack__icon" aria-hidden="true"><i class="@Icon(_ack.Type)"></i></div>
                <h5 class="toast-ack__title">@_ack.Title</h5>
                <div class="toast-ack__body">@((MarkupString)_ack.Message)</div>

                <button type="button" class="btn btn-primary btn-lg toast-ack__confirm" @onclick="ConfirmAck">
                    <i class="bi bi-check-lg"></i>Potwierdź
                </button>
            </div>
        }
    </ChildContent>
</AppModal>

@code {
    // How long a notification stays up, by severity. Anything the operator has
    // to act on — an error, or a refusal they need to work around — gets the
    // full eight seconds, because they are looking at the package and not at
    // the screen when it appears. A "saved" confirmation does not need to
    // linger. Call sites do not set this: the severity does, so the same kind
    // of message is always on screen for the same time.
    private const int ErrorMs = 8000;
    private const int WarningMs = 8000;
    private const int DefaultMs = 4000; // info and success

    /// <summary>Matches the exit animation in Toast.razor.css.</summary>
    private const int LeaveMs = 240;

    private static int DurationFor(ToastType type) => type switch
    {
        ToastType.Error => ErrorMs,
        ToastType.Warning => WarningMs,
        _ => DefaultMs
    };

    private sealed record ToastItem(long Id, string Title, string Message, ToastType Type, int DurationMs);

    private readonly List<ToastItem> _toasts = new();
    private readonly HashSet<long> _leaving = new();
    private ElementReference _stackRef;
    private long _nextId = 1;
    private bool _visible;
    private bool _disposed;

    private sealed record AckItem(string Title, string Message, ToastType Type);

    /// <summary>Blocking acknowledgements waiting to be confirmed, shown one at a time.</summary>
    private readonly Queue<AckItem> _acks = new();
    private AckItem? _ack;

    /// <summary>
    /// Shows a notification. How long it stays up follows from the severity —
    /// see <see cref="DurationFor"/>.
    /// </summary>
    public void Show(string title, string message, ToastType type = ToastType.Error)
    {
        var duration = DurationFor(type);
        var item = new ToastItem(_nextId++, title, message, type, duration);

        _toasts.Add(item);
        StateHasChanged();

        _ = ExpireAsync(item.Id, duration);
    }

    /// <summary>
    /// Shows a centred, screen-blocking message the operator has to acknowledge
    /// with "Potwierdź" before carrying on. Use it for the few notices that must
    /// not be missed; everything else should stay a corner toast via Show().
    /// Calls queue, so two in a row are shown one after the other.
    /// </summary>
    public void ShowBlocking(string title, string message, ToastType type = ToastType.Info)
    {
        _acks.Enqueue(new AckItem(title, message, type));
        _ack ??= _acks.Dequeue();
        StateHasChanged();
    }

    private void ConfirmAck()
    {
        _ack = _acks.Count > 0 ? _acks.Dequeue() : null;
        StateHasChanged();
    }

    /// <summary>Clears everything on screen at once.</summary>
    public void Hide()
    {
        if (_toasts.Count == 0) return;

        _toasts.Clear();
        _leaving.Clear();
        StateHasChanged();
    }

    /// <summary>
    /// Starts a notification's exit: it plays the slide-out, then leaves the
    /// list. Called both by the close button and by the auto-expire timer.
    /// </summary>
    private void Dismiss(long id)
    {
        if (_leaving.Contains(id) || _toasts.All(t => t.Id != id))
            return;

        _leaving.Add(id);
        StateHasChanged();

        _ = RemoveAfterLeaveAsync(id);
    }

    private async Task RemoveAfterLeaveAsync(long id)
    {
        await Task.Delay(LeaveMs);

        if (_disposed) return;

        await InvokeAsync(() =>
        {
            _leaving.Remove(id);
            var index = _toasts.FindIndex(t => t.Id == id);
            if (index >= 0) _toasts.RemoveAt(index);
            StateHasChanged();
        });
    }

    private async Task ExpireAsync(long id, int delayMs)
    {
        await Task.Delay(delayMs);

        if (_disposed) return;

        await InvokeAsync(() => Dismiss(id));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var shouldBeVisible = _toasts.Count > 0;
        if (_visible == shouldBeVisible) return;

        _visible = shouldBeVisible;

        try
        {
            await JSRuntime.InvokeVoidAsync("toastStack.sync", _stackRef, shouldBeVisible);
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private static string Kind(ToastType type) => type switch
    {
        ToastType.Success => "success",
        ToastType.Info => "info",
        ToastType.Warning => "warning",
        _ => "error"
    };

    private static string Icon(ToastType type) => type switch
    {
        ToastType.Success => "bi bi-check-circle-fill",
        ToastType.Info => "bi bi-info-circle-fill",
        ToastType.Warning => "bi bi-exclamation-triangle-fill",
        _ => "bi bi-exclamation-octagon-fill"
    };

    public void Dispose() => _disposed = true;
}
