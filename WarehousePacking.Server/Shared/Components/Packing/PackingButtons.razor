@using WarehousePacking.Contracts.DTOs
@using WarehousePacking.Contracts.Data.Enums
@using WarehousePacking.Server.Settings

@*
    Primary action bar. Order is deliberately unchanged from the previous
    design — operators navigate it by muscle memory. Semantic colours are kept
    (red = destructive, green = confirm) rather than brand-coloured.
*@

<div class="app-actionbar">
    <button type="button"
            class="btn btn-warning"
            @onclick="NextPackage"
            disabled="@(!IsMainOperator)">
        <i class="bi bi-box-arrow-right"></i>
        <span>Następna paczka</span>
    </button>

    <button type="button"
            class="btn btn-danger"
            @onclick="UnpackItem">
        <i class="bi bi-x-circle"></i>
        <span>Usuń pozycję</span>
    </button>

    <button type="button"
            class="btn btn-danger"
            @onclick="Close"
            disabled="@HasPackedItems">
        <i class="bi bi-door-closed"></i>
        <span>Wyjdź</span>
    </button>

    <button type="button"
            class="btn btn-success"
            @onclick="FinishPacking"
            disabled="@(!IsMainOperator)">
        <i class="bi bi-check2-circle"></i>
        <span>Zakończ</span>
    </button>
</div>

@code {
    [Parameter] public EventCallback NextPackage { get; set; }
    [Parameter] public EventCallback UnpackItem { get; set; }
    [Parameter] public EventCallback Close { get; set; }
    [Parameter] public EventCallback FinishPacking { get; set; }
    [Parameter] public List<JlItemDto> PackedItems { get; set; } = new();
    [Parameter] public WorkstationSettings Settings { get; set; } = new();
    [Parameter] public bool IsMainOperator { get; set; } = true;

    private bool HasPackedItems => PackedItems?.Count > 0;
}
