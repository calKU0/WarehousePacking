@implements IAsyncDisposable
@inject IJSRuntime JSRuntime

@*
    Barcode scan field. Presentation only — the parent owns the key handling.

    The field claims the page's focus through scanFocus, which keeps the caret
    here instead of callers having to re-focus after every action: a hardware
    scanner types into whatever holds the caret.
*@

<div class="app-scan @(Disabled ? "is-disabled" : null) @(_shaking ? "app-anim-shake" : null)">
    <span class="app-scan__icon" aria-hidden="true">
        <i class="bi bi-upc-scan"></i>
    </span>
    <input type="text"
           class="app-scan__input"
           @ref="_inputRef"
           @onkeydown="OnKeyDown"
           placeholder="@Placeholder"
           disabled="@Disabled"
           autocomplete="off"
           autocapitalize="off"
           spellcheck="false"
           aria-label="@Placeholder" />
</div>

@code {
    private ElementReference _inputRef;
    private int _handle;
    private bool _wasDisabled;
    private bool _shaking;

    [Parameter] public EventCallback<KeyboardEventArgs> OnKeyDown { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Skanuj kod...";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                _wasDisabled = Disabled;
                _handle = await JSRuntime.InvokeAsync<int>("scanFocus.attach", _inputRef);
                return;
            }

            if (_wasDisabled == Disabled)
            {
                return;
            }

            // A disabled field cannot hold the caret, so take it back the
            // moment the flow re-enables scanning.
            _wasDisabled = Disabled;
            if (!Disabled)
            {
                await FocusAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }
    }

    /// <summary>
    /// Asks for the caret back. Rarely needed — scanFocus keeps it here — but
    /// available for flows that re-enable the field themselves.
    /// </summary>
    public async Task FocusAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("scanFocus.focus");
        }
        catch
        {
            // Circuit gone, or the element is not rendered yet.
        }
    }

    /// <summary>
    /// Plays a brief shake to signal a rejected scan. Safe to fire-and-forget;
    /// it restarts cleanly if called again mid-shake.
    /// </summary>
    public async Task Shake()
    {
        _shaking = false;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(20); // let the class drop so the animation can restart
        _shaking = true;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(400); // matches the shake keyframe
        _shaking = false;
        await InvokeAsync(StateHasChanged);
    }

    public ValueTask<string> GetValueAsync()
        => JSRuntime.InvokeAsync<string>("blazorFocus.getValue", _inputRef);

    public ValueTask ClearAsync()
        => JSRuntime.InvokeVoidAsync("blazorFocus.clearValue", _inputRef);

    public async ValueTask DisposeAsync()
    {
        if (_handle == 0)
        {
            return;
        }

        try
        {
            await JSRuntime.InvokeVoidAsync("scanFocus.detach", _handle);
        }
        catch
        {
            // Circuit already torn down.
        }
    }
}
