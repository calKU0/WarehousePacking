@implements IAsyncDisposable
@inject IJSRuntime JSRuntime

@*
    Barcode scan field. Presentation only — the parent owns the key handling.

    Focus is maintained by the scanFocus guardian rather than by callers
    remembering to call FocusAsync() after every action: a hardware scanner
    types into whatever holds the caret, so this field must effectively always
    own it while no modal is open.
*@

<div class="app-scan @(Disabled ? "is-disabled" : null) @(_shaking ? "app-anim-shake" : null)">
    <span class="app-scan__icon" aria-hidden="true">
        <i class="bi bi-upc-scan"></i>
    </span>
    <input type="text"
           class="app-scan__input"
           @ref="_inputRef"
           @onkeydown="OnKeyDown"
           placeholder="@Placeholder"
           disabled="@Disabled"
           autocomplete="off"
           autocapitalize="off"
           spellcheck="false"
           aria-label="@Placeholder" />
</div>

@code {
    private ElementReference _inputRef;
    private string? _guardId;
    private bool _shaking;

    [Parameter] public EventCallback<KeyboardEventArgs> OnKeyDown { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Skanuj kod...";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _guardId = await JSRuntime.InvokeAsync<string>("scanFocus.register", _inputRef);
        }
        catch (JSDisconnectedException)
        {
        }
    }

    /// <summary>
    /// Explicit focus request. Rarely needed now that the guardian handles it,
    /// but kept so existing flows keep working.
    /// </summary>
    public async Task FocusAsync()
    {
        // Best-effort: the element may not be rendered yet (e.g. called from a
        // modal callback mid-render).
        try
        {
            await JSRuntime.InvokeVoidAsync("scanFocus.refocus");
            await JSRuntime.InvokeVoidAsync("blazorFocus.focusElement", _inputRef);
        }
        catch
        {
        }
    }

    /// <summary>
    /// Plays a brief shake to signal a rejected scan. Safe to fire-and-forget;
    /// it restarts cleanly if called again mid-shake.
    /// </summary>
    public async Task Shake()
    {
        _shaking = false;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(20); // let the class drop so the animation can restart
        _shaking = true;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(400); // matches the shake keyframe
        _shaking = false;
        await InvokeAsync(StateHasChanged);
    }

    public ValueTask<string> GetValueAsync()
        => JSRuntime.InvokeAsync<string>("blazorFocus.getValue", _inputRef);

    public ValueTask ClearAsync()
        => JSRuntime.InvokeVoidAsync("blazorFocus.clearValue", _inputRef);

    public async ValueTask DisposeAsync()
    {
        if (_guardId is null)
        {
            return;
        }

        try
        {
            await JSRuntime.InvokeVoidAsync("scanFocus.unregister", _guardId);
        }
        catch
        {
            // Circuit already torn down.
        }
    }
}
