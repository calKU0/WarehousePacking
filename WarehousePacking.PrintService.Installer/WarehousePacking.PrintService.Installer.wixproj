<Project Sdk="WixToolset.Sdk/7.0.0">
  <PropertyGroup>
    <AcceptEula>wix7</AcceptEula>
    <Platform>x64</Platform>
    <OutputName>KontrolaPakowania.PrintService.Setup</OutputName>
    <DefineConstants>PwaUrl=http://192.168.0.109:8092</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="7.0.0" />
    <PackageReference Include="WixToolset.Util.wixext" Version="7.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- WarehousePacking.PrintService only supports Platform=AnyCPU; strip our forced x64
         Platform before MSBuild propagates it as a global property to that reference. -->
    <ProjectReference Include="..\WarehousePacking.PrintService\WarehousePacking.PrintService.csproj"
                       GlobalPropertiesToRemove="Platform" />
  </ItemGroup>

  <!-- Publish the built installer where the Blazor server serves it from, replacing the
       manual KontrolaPakowania.rar download.

       Release only, and only when the file actually changed. The destination is tracked
       in git — it has to be, because the Server project does not build this installer, so
       a clean checkout would otherwise serve a 404 — and a Debug MSI is byte-different
       from a Release one. Copying after every build therefore left the working tree
       permanently dirty and pulled a 27 MB binary into commits that had nothing to do
       with the print service. Refreshing the download is now a deliberate act: build this
       project in Release. -->
  <Target Name="CopyMsiToServerDownloads" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(MSBuildThisFileDirectory)..\WarehousePacking.Server\wwwroot\downloads\"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
