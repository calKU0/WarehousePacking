<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <UI>
      <Dialog Id="ServiceConfigDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
          <Publish Event="NewDialog" Value="VerifyReadyDlg" />
        </Control>
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="InstallDirDlg" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>

        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Service Configuration" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="Configure the settings for the Windows Service." />
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />

        <!-- Display Name -->
        <Control Id="DisplayNameLabel" Type="Text" X="20" Y="85" Width="100" Height="15" Text="Display Name:" />
        <Control Id="DisplayNameEdit" Type="Edit" X="120" Y="82" Width="200" Height="18" Property="SERVICEDISPLAYNAME" />

        <!-- Description -->
        <Control Id="DescriptionLabel" Type="Text" X="20" Y="110" Width="100" Height="15" Text="Description:" />
        <Control Id="DescriptionEdit" Type="Edit" X="120" Y="107" Width="200" Height="18" Property="SERVICEDESCRIPTION" />

        <!-- Account -->
        <Control Id="AccountLabel" Type="Text" X="20" Y="135" Width="100" Height="15" Text="Service Account:" />
        <Control Id="AccountEdit" Type="Edit" X="120" Y="132" Width="200" Height="18" Property="SERVICEACCOUNT" />

        <!-- Password -->
        <Control Id="PasswordLabel" Type="Text" X="20" Y="160" Width="100" Height="15" Text="Password (if needed):" />
        <Control Id="PasswordEdit" Type="Edit" X="120" Y="157" Width="200" Height="18" Property="SERVICEPASSWORD" Password="yes" />

        <Control Id="InstructionsLabel" Type="Text" X="20" Y="190" Width="320" Height="30" Text="Note: Use 'LocalSystem' for the default built-in account or provide DOMAIN\User and password for a specific account." />
      </Dialog>
    </UI>
  </Fragment>
</Wix>